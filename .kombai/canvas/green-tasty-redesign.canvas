      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"w-full bg-[#F7F7EC] text-[#232323] pb-16\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Poppins',sans-serif;\">\n<!-- Header -->\n<header class=\"h-20 bg-white flex items-center justify-between px-8\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"flex items-center gap-12\" data-kid=\"1-1-1\" data-name=\"header left group with logo and nav\">\n<a aria-label=\"Green &amp; Tasty home\" class=\"flex items-center shrink-0\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#\">\n<img alt=\"Green &amp; Tasty\" class=\"h-9 w-auto\" data-kid=\"1-1-1-1-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/logo_vegeterian.svg\"/>\n</a>\n<nav aria-label=\"Main\" class=\"flex items-center gap-8 text-[15px] font-medium\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n<a class=\"text-[#575757] hover:text-[#0F7A37] pb-1 border-b-2 border-transparent\" data-kid=\"1-1-1-2-1\" data-name=\"nav link main page\" href=\"#\">Main page</a>\n<a class=\"text-[#575757] hover:text-[#0F7A37] pb-1 border-b-2 border-transparent\" data-kid=\"1-1-1-2-2\" data-name=\"nav link menu\" href=\"#\">Menu</a>\n<a class=\"text-[#0F7A37] border-b-2 border-[#0F7A37] pb-1\" data-kid=\"1-1-1-2-3\" data-name=\"nav link book a table active\" href=\"#\">Book a Table</a>\n<a class=\"text-[#575757] hover:text-[#0F7A37] pb-1 border-b-2 border-transparent\" data-kid=\"1-1-1-2-4\" data-name=\"nav link reservations\" href=\"#\">Reservations</a>\n</nav>\n</div>\n<button class=\"h-10 px-5 rounded-lg border-[1.4px] border-[#0F7A37] bg-white text-[#0F7A37] text-[14px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-1-2\" data-name=\"sign in button\" type=\"button\">Sign In</button>\n</header>\n<!-- Title region -->\n<div class=\"h-[72px] flex items-center px-8\" data-kid=\"1-2\" data-name=\"page title region\">\n<h1 class=\"text-[32px] leading-10 font-medium text-[#232323]\" data-kid=\"1-2-1\" data-name=\"page title heading\">Book a Table</h1>\n</div>\n<!-- Persistent search strip -->\n<section aria-label=\"Table search\" class=\"px-8\" data-kid=\"1-3\" data-name=\"table search section\">\n<div class=\"h-[112px] bg-white rounded-xl shadow-[0_2px_16px_rgba(35,35,35,0.06)] px-10 flex items-end gap-4 py-6\" data-kid=\"1-3-1\" data-name=\"search form card\">\n<div class=\"w-[270px]\" data-kid=\"1-3-1-1\" data-name=\"location field container\">\n<label class=\"block text-[12px] font-medium text-[#575757] mb-1\" data-kid=\"1-3-1-1-1\" data-name=\"location label\" for=\"f-location\">Location</label>\n<button class=\"w-full h-12 px-4 rounded-lg border border-[#DADADA] bg-white flex items-center justify-between text-[14px] text-[#232323]\" data-kid=\"1-3-1-1-2\" data-name=\"location dropdown button\" id=\"f-location\" type=\"button\">\n<span data-kid=\"1-3-1-1-2-1\" data-name=\"location dropdown value text\">All Locations</span>\n<i class=\"ti ti-chevron-down text-[16px] text-[#575757]\" data-kid=\"1-3-1-1-2-2\" data-name=\"chevron down icon\"></i>\n</button>\n</div>\n<div class=\"w-[180px]\" data-kid=\"1-3-1-2\" data-name=\"date field container\">\n<label class=\"block text-[12px] font-medium text-[#575757] mb-1\" data-kid=\"1-3-1-2-1\" data-name=\"date label\" for=\"f-date\">Date</label>\n<button class=\"w-full h-12 px-4 rounded-lg border border-[#DADADA] bg-white flex items-center justify-between text-[14px] text-[#232323]\" data-kid=\"1-3-1-2-2\" data-name=\"date picker button\" id=\"f-date\" type=\"button\">\n<span data-kid=\"1-3-1-2-2-1\" data-name=\"date value text\">Oct 30, 2026</span>\n<i class=\"ti ti-calendar text-[16px] text-[#575757]\" data-kid=\"1-3-1-2-2-2\" data-name=\"calendar icon\"></i>\n</button>\n</div>\n<div class=\"w-[160px]\" data-kid=\"1-3-1-3\" data-name=\"time field container\">\n<label class=\"block text-[12px] font-medium text-[#575757] mb-1\" data-kid=\"1-3-1-3-1\" data-name=\"time label\" for=\"f-time\">Time</label>\n<button class=\"w-full h-12 px-4 rounded-lg border border-[#DADADA] bg-white flex items-center justify-between text-[14px] text-[#232323]\" data-kid=\"1-3-1-3-2\" data-name=\"time picker button\" id=\"f-time\" type=\"button\">\n<span data-kid=\"1-3-1-3-2-1\" data-name=\"time value text\">19:00</span>\n<i class=\"ti ti-clock text-[16px] text-[#575757]\" data-kid=\"1-3-1-3-2-2\" data-name=\"clock icon\"></i>\n</button>\n</div>\n<div class=\"w-[180px]\" data-kid=\"1-3-1-4\" data-name=\"guests field container\">\n<span class=\"block text-[12px] font-medium text-[#575757] mb-1\" data-kid=\"1-3-1-4-1\" data-name=\"guests label\">Guests</span>\n<div class=\"h-12 rounded-lg border border-[#DADADA] bg-white flex items-center justify-between px-2\" data-kid=\"1-3-1-4-2\" data-name=\"guests stepper control\">\n<button aria-label=\"Decrease guests\" class=\"w-9 h-9 rounded-md border border-[#DADADA] text-[#0F7A37] flex items-center justify-center hover:bg-[#e9ffea]\" data-kid=\"1-3-1-4-2-1\" data-name=\"decrease guests button\" type=\"button\"><i class=\"ti ti-minus text-[16px]\" data-kid=\"1-3-1-4-2-1-1\" data-name=\"minus icon\"></i></button>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-3-1-4-2-2\" data-name=\"guests count value\">2</span>\n<button aria-label=\"Increase guests\" class=\"w-9 h-9 rounded-md border border-[#DADADA] text-[#0F7A37] flex items-center justify-center hover:bg-[#e9ffea]\" data-kid=\"1-3-1-4-2-3\" data-name=\"increase guests button\" type=\"button\"><i class=\"ti ti-plus text-[16px]\" data-kid=\"1-3-1-4-2-3-1\" data-name=\"plus icon\"></i></button>\n</div>\n</div>\n<button class=\"w-[206px] h-14 rounded-lg text-white text-[16px] font-semibold shadow-[0_6px_16px_rgba(15,122,55,0.28)]\" data-kid=\"1-3-1-5\" data-name=\"find a table submit button\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%);\" type=\"button\">Find a Table</button>\n</div>\n<!-- Note row -->\n<div class=\"h-10 flex items-center gap-2 px-1\" data-kid=\"1-3-2\" data-name=\"contact note row\">\n<i class=\"ti ti-phone-call text-[16px] text-[#0F7A37]\" data-kid=\"1-3-2-1\" data-name=\"phone icon\"></i>\n<span class=\"text-[13px] text-[#575757]\" data-kid=\"1-3-2-2\" data-name=\"group booking contact text\">For groups larger than 4, please call us directly at +123 445 678 8990</span>\n</div>\n</section>\n<!-- Results -->\n<section aria-label=\"Available tables\" class=\"px-8\" data-kid=\"1-4\" data-name=\"results section\">\n<div class=\"h-16 flex items-center justify-between\" data-kid=\"1-4-1\" data-name=\"results summary header\">\n<h2 class=\"text-[20px] font-semibold text-[#232323]\" data-kid=\"1-4-1-1\" data-name=\"results count heading\">6 tables available</h2>\n<p class=\"text-[13px] text-[#575757]\" data-kid=\"1-4-1-2\" data-name=\"results summary meta text\">All Locations · Oct 30, 2026 · 19:00 · 2 guests</p>\n</div>\n<!-- Group: 9 Abashidze Street -->\n<div class=\"mb-6\" data-kid=\"1-4-2\" data-name=\"location group 9 Abashidze Street\">\n<div class=\"flex items-center gap-2 mb-2\" data-kid=\"1-4-2-1\" data-name=\"location group header\">\n<i class=\"ti ti-map-pin text-[16px] text-[#0F7A37]\" data-kid=\"1-4-2-1-1\" data-name=\"map pin icon\"></i>\n<h3 class=\"text-[15px] font-semibold text-[#232323]\" data-kid=\"1-4-2-1-2\" data-name=\"location group title\">9 Abashidze Street</h3>\n</div>\n<div class=\"flex flex-col gap-4\" data-kid=\"1-4-2-2\" data-name=\"table cards list\">\n<article class=\"h-[152px] bg-white rounded-xl border border-[#ECECEC] shadow-[0_2px_16px_rgba(35,35,35,0.05)] flex items-center gap-6 pl-4 pr-6\" data-kid=\"1-4-2-2-1\" data-name=\"table card\">\n<div class=\"w-[152px] h-[120px] rounded-lg overflow-hidden shrink-0\" data-kid=\"1-4-2-2-1-1\" data-name=\"table card image container\">\n<img alt=\"Table setting\" class=\"w-full h-full object-cover\" data-kid=\"1-4-2-2-1-1-1\" data-name=\"table card image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/table-card-image.jpg\"/>\n</div>\n<div class=\"w-[224px] shrink-0\" data-kid=\"1-4-2-2-1-2\" data-name=\"table card info block\">\n<p class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-4-2-2-1-2-1\" data-name=\"table name text\">Table 1</p>\n<p class=\"mt-1 text-[13px] text-[#575757]\" data-kid=\"1-4-2-2-1-2-2\" data-name=\"table capacity text\">Up to 2 guests</p>\n<p class=\"mt-0.5 text-[12px] text-[#898989]\" data-kid=\"1-4-2-2-1-2-3\" data-name=\"table location text\">9 Abashidze Street</p>\n</div>\n<div class=\"flex-1 grid grid-cols-6 gap-2\" data-kid=\"1-4-2-2-1-3\" data-name=\"slot time selector grid\">\n<button class=\"h-10 rounded-lg border border-[#DADADA] bg-white text-[14px] font-medium text-[#232323] hover:border-[#0F7A37]\" data-kid=\"1-4-2-2-1-3-1\" data-name=\"time slot button 18:00\" type=\"button\">18:00</button>\n<button aria-disabled=\"true\" class=\"h-10 rounded-lg border border-[#ECECEC] bg-[#FAFAF7] text-[14px] font-medium text-[#B4B4B4] line-through cursor-not-allowed\" data-kid=\"1-4-2-2-1-3-2\" data-name=\"time slot button 18:30 unavailable\" type=\"button\">18:30</button>\n<button aria-pressed=\"true\" class=\"h-10 rounded-lg text-white text-[14px] font-semibold flex items-center justify-center gap-1.5\" data-kid=\"1-4-2-2-1-3-3\" data-name=\"selected time slot button 19:00\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%);\" type=\"button\"><i class=\"ti ti-check text-[16px]\" data-kid=\"1-4-2-2-1-3-3-1\" data-name=\"checkmark icon\"></i>19:00</button>\n<button class=\"h-10 rounded-lg border border-[#DADADA] bg-white text-[14px] font-medium text-[#232323] hover:border-[#0F7A37]\" data-kid=\"1-4-2-2-1-3-4\" data-name=\"time slot button 19:30\" type=\"button\">19:30</button>\n<button aria-disabled=\"true\" class=\"h-10 rounded-lg border border-[#ECECEC] bg-[#FAFAF7] text-[14px] font-medium text-[#B4B4B4] line-through cursor-not-allowed\" data-kid=\"1-4-2-2-1-3-5\" data-name=\"time slot button 20:00 unavailable\" type=\"button\">20:00</button>\n<button class=\"h-10 rounded-lg border border-[#DADADA] bg-white text-[14px] font-medium text-[#232323] hover:border-[#0F7A37]\" data-kid=\"1-4-2-2-1-3-6\" data-name=\"time slot button 20:30\" type=\"button\">20:30</button>\n</div>\n</article>\n<article class=\"h-[152px] bg-white rounded-xl border border-[#ECECEC] shadow-[0_2px_16px_rgba(35,35,35,0.05)] flex items-center gap-6 pl-4 pr-6\" data-kid=\"1-4-2-2-2\" data-name=\"table card\">\n<div class=\"w-[152px] h-[120px] rounded-lg overflow-hidden shrink-0\" data-kid=\"1-4-2-2-2-1\" data-name=\"table card image container\">\n<img alt=\"Table setting\" class=\"w-full h-full object-cover\" data-kid=\"1-4-2-2-2-1-1\" data-name=\"table card image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/table-card-image.jpg\"/>\n</div>\n<div class=\"w-[224px] shrink-0\" data-kid=\"1-4-2-2-2-2\" data-name=\"table card info block\">\n<p class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-4-2-2-2-2-1\" data-name=\"table name text\">Table 2</p>\n<p class=\"mt-1 text-[13px] text-[#575757]\" data-kid=\"1-4-2-2-2-2-2\" data-name=\"table capacity text\">Up to 4 guests</p>\n<p class=\"mt-0.5 text-[12px] text-[#898989]\" data-kid=\"1-4-2-2-2-2-3\" data-name=\"table location text\">9 Abashidze Street</p>\n</div>\n<div class=\"flex-1 grid grid-cols-6 gap-2\" data-kid=\"1-4-2-2-2-3\" data-name=\"slot time selector grid\">\n<button aria-disabled=\"true\" class=\"h-10 rounded-lg border border-[#ECECEC] bg-[#FAFAF7] text-[14px] font-medium text-[#B4B4B4] line-through cursor-not-allowed\" data-kid=\"1-4-2-2-2-3-1\" data-name=\"time slot button 18:00 unavailable\" type