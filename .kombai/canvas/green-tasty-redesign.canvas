      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen w-full bg-[#F7F7EC] text-[#232323]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Poppins',sans-serif;\">\n<!-- Header -->\n<header class=\"h-20 bg-white flex items-center justify-between px-8\" data-kid=\"1-1\" data-name=\"site header bar\">\n<a aria-label=\"Green &amp; Tasty — Main page\" class=\"shrink-0\" data-kid=\"1-1-1\" data-name=\"restaurant logo link\" href=\"#\">\n<img alt=\"Green &amp; Tasty\" class=\"h-[38px] w-auto\" data-kid=\"1-1-1-1\" data-name=\"restaurant logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/logo_vegeterian.svg\"/>\n</a>\n<nav aria-label=\"Main\" class=\"flex items-center gap-9\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n<a class=\"text-[15px] font-medium text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-1\" data-name=\"main page nav link\" href=\"#\">Main page</a>\n<a class=\"text-[15px] font-medium text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-2\" data-name=\"menu nav link\" href=\"#\">Menu</a>\n<a class=\"text-[15px] font-medium text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-3\" data-name=\"book a table nav link\" href=\"#\">Book a Table</a>\n<a class=\"text-[15px] font-medium text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-4\" data-name=\"reservations nav link\" href=\"#\">Reservations</a>\n</nav>\n<button class=\"h-10 px-5 rounded-lg border-[1.4px] border-[#0F7A37] text-[#0F7A37] text-[14px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-1-3\" data-name=\"sign in button\" type=\"button\">Sign In</button>\n</header>\n<main class=\"px-8 pt-6\" data-kid=\"1-2\" data-name=\"main content area\">\n<!-- Venue split composition: photo + info card -->\n<section aria-label=\"Location overview\" class=\"flex gap-5\" data-kid=\"1-2-1\" data-name=\"location overview section\">\n<img alt=\"Dining room at 14 Baratashvili Street\" class=\"w-[784px] h-[320px] rounded-xl object-cover shrink-0\" data-kid=\"1-2-1-1\" data-name=\"dining room photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/locations/baratashvili-street-14.jpg\"/>\n<aside class=\"w-[412px] h-[320px] bg-white rounded-xl border border-[#ECECE2] shadow-[0_1px_2px_rgba(35,35,35,0.06)] p-6 flex flex-col\" data-kid=\"1-2-1-2\" data-name=\"location info card\">\n<h1 class=\"text-[26px] leading-9 font-medium text-[#232323]\" data-kid=\"1-2-1-2-1\" data-name=\"location headline\">14 Baratashvili Street</h1>\n<div class=\"mt-2 flex items-center gap-1.5\" data-kid=\"1-2-1-2-2\" data-name=\"rating row\">\n<img alt=\"\" class=\"w-[18px] h-[18px]\" data-kid=\"1-2-1-2-2-1\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<span class=\"text-[14px] font-semibold text-[#232323]\" data-kid=\"1-2-1-2-2-2\" data-name=\"rating score text\">4.4 / 5</span>\n</div>\n<p class=\"mt-3 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-2-1-2-3\" data-name=\"location description text\">Nestled near the historic city walls, this cozy spot blends traditional brickwork with modern design, offering a warm dining experience just steps from the old town.</p>\n<span class=\"flex-1\" data-kid=\"1-2-1-2-4\" data-name=\"card vertical spacing filler\"></span>\n<div class=\"flex gap-3\" data-kid=\"1-2-1-2-5\" data-name=\"card action buttons row\">\n<button class=\"flex-1 h-12 rounded-lg text-white text-[14px] font-semibold\" data-kid=\"1-2-1-2-5-1\" data-name=\"book a table call-to-action button\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%);\" type=\"button\">Book a Table</button>\n<button class=\"flex-1 h-12 rounded-lg border-[1.4px] border-[#0F7A37] text-[#0F7A37] text-[14px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-2-1-2-5-2\" data-name=\"view menu secondary button\" type=\"button\">View menu</button>\n</div>\n</aside>\n</section>\n</main>\n<!-- Reviews band -->\n<section class=\"bg-white mt-10 pt-10 pb-12\" data-kid=\"1-3\" data-name=\"customer reviews band\">\n<div class=\"px-8\" data-kid=\"1-3-1\" data-name=\"reviews content container\">\n<h2 class=\"text-[32px] leading-10 font-medium text-[#232323]\" data-kid=\"1-3-1-1\" data-name=\"reviews section headline\">Customer Reviews</h2>\n<!-- Tabs + sort toolbar -->\n<div class=\"mt-4 h-14 flex items-end justify-between border-b border-[#E4E4D6]\" data-kid=\"1-3-1-2\" data-name=\"tabs and sort toolbar\">\n<div aria-label=\"Review categories\" class=\"flex items-center gap-7\" data-kid=\"1-3-1-2-1\" data-name=\"review category tabs\" role=\"tablist\">\n<button aria-selected=\"true\" class=\"pb-3 -mb-px text-[14px] font-semibold text-[#0F7A37] border-b-2 border-[#0F7A37]\" data-kid=\"1-3-1-2-1-1\" data-name=\"service category tab (selected)\" role=\"tab\" type=\"button\">Service</button>\n<button aria-selected=\"false\" class=\"pb-3 -mb-px text-[14px] font-medium text-[#575757] border-b-2 border-transparent hover:text-[#0F7A37]\" data-kid=\"1-3-1-2-1-2\" data-name=\"cuisine experience category tab\" role=\"tab\" type=\"button\">Cuisine experience</button>\n</div>\n<div class=\"flex items-center gap-2 pb-1\" data-kid=\"1-3-1-2-2\" data-name=\"sort controls\">\n<span class=\"text-[13px] text-[#575757]\" data-kid=\"1-3-1-2-2-1\" data-name=\"sort by label\">Sort by:</span>\n<button aria-haspopup=\"listbox\" class=\"h-12 w-[248px] bg-white border border-[#DADADA] rounded-lg px-4 flex items-center justify-between text-[14px] font-medium text-[#232323] hover:border-[#0F7A37]\" data-kid=\"1-3-1-2-2-2\" data-name=\"sort dropdown button\" type=\"button\">\n<span data-kid=\"1-3-1-2-2-2-1\" data-name=\"sort option label text\">Top rated first</span>\n<i class=\"ti ti-chevron-down text-[16px] text-[#575757]\" data-kid=\"1-3-1-2-2-2-2\" data-name=\"chevron down dropdown icon\"></i>\n</button>\n</div>\n</div>\n<!-- Review cards -->\n<div class=\"mt-6 grid grid-cols-3 gap-5\" data-kid=\"1-3-1-3\" data-name=\"reviews card grid\">\n<article class=\"h-[248px] bg-white rounded-xl border border-[#ECECE2] shadow-[0_1px_2px_rgba(35,35,35,0.06)] p-5 flex flex-col\" data-kid=\"1-3-1-3-1\" data-name=\"review card\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-1-3-1-1\" data-name=\"reviewer identity row\">\n<img alt=\"\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"1-3-1-3-1-1-1\" data-name=\"reviewer avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?u=luka-maisuradze\"/>\n<div class=\"min-w-0\" data-kid=\"1-3-1-3-1-1-2\" data-name=\"reviewer name and date group\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323]\" data-kid=\"1-3-1-3-1-1-2-1\" data-name=\"reviewer name text\">Luka Maisuradze</h3>\n<span class=\"text-[12px] text-[#898989]\" data-kid=\"1-3-1-3-1-1-2-2\" data-name=\"review date text\">Sep 28, 2026</span>\n</div>\n</div>\n<div aria-label=\"Rated 5 out of 5 stars\" class=\"mt-3 flex items-center gap-0.5\" data-kid=\"1-3-1-3-1-2\" data-name=\"star rating row\">\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-1-2-1\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-1-2-2\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-1-2-3\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-1-2-4\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-1-2-5\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n</div>\n<p class=\"mt-3 text-[13px] leading-[22px] text-[#575757] line-clamp-4\" data-kid=\"1-3-1-3-1-3\" data-name=\"review body text\">We were seated within a few minutes of arriving and the waiter checked on the table twice during dinner. Dishes came out in the order they were ordered.</p>\n</article>\n<article class=\"h-[248px] bg-white rounded-xl border border-[#ECECE2] shadow-[0_1px_2px_rgba(35,35,35,0.06)] p-5 flex flex-col\" data-kid=\"1-3-1-3-2\" data-name=\"review card\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-1-3-2-1\" data-name=\"reviewer identity row\">\n<img alt=\"\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"1-3-1-3-2-1-1\" data-name=\"reviewer avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?u=ana-tsiklauri\"/>\n<div class=\"min-w-0\" data-kid=\"1-3-1-3-2-1-2\" data-name=\"reviewer name and date group\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323]\" data-kid=\"1-3-1-3-2-1-2-1\" data-name=\"reviewer name text\">Ana Tsiklauri</h3>\n<span class=\"text-[12px] text-[#898989]\" data-kid=\"1-3-1-3-2-1-2-2\" data-name=\"review date text\">Sep 14, 2026</span>\n</div>\n</div>\n<div aria-label=\"Rated 4 out of 5 stars\" class=\"mt-3 flex items-center gap-0.5\" data-kid=\"1-3-1-3-2-2\" data-name=\"star rating row\">\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-2-2-1\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-2-2-2\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-2-2-3\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-2-2-4\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4 opacity-30\" data-kid=\"1-3-1-3-2-2-5\" data-name=\"dimmed unfilled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n</div>\n<p class=\"mt-3 text-[13px] leading-[22px] text-[#575757] line-clamp-4\" data-kid=\"1-3-1-3-2-3\" data-name=\"review body text\">Service stayed attentive through the evening rush. We waited about fifteen minutes for mains and the waiter told us before we had to ask.</p>\n</article>\n<article class=\"h-[248px] bg-white rounded-xl border border-[#ECECE2] shadow-[0_1px_2px_rgba(35,35,35,0.06)] p-5 flex flex-col\" data-kid=\"1-3-1-3-3\" data-name=\"review card\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-1-3-3-1\" data-name=\"reviewer identity row\">\n<img alt=\"\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"1-3-1-3-3-1-1\" data-name=\"reviewer avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?u=davit-lobjanidze\"/>\n<div class=\"min-w-0\" data-kid=\"1-3-1-3-3-1-2\" data-name=\"reviewer name and date group\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323]\" data-kid=\"1-3-1-3-3-1-2-1\" data-name=\"reviewer name text\">Davit Lobjanidze</h3>\n<span class=\"text-[12px] text-[#898989]\" data-kid=\"1-3-1-3-3-1-2-2\" data-name=\"review date text\">Aug 30, 2026</span>\n</div>\n</div>\n<div aria-label=\"Rated 5 out of 5 stars\" class=\"mt-3 flex items-center gap-0.5\" data-kid=\"1-3-1-3-3-2\" data-name=\"star rating row\">\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-3-2-1\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-3-2-2\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-3-2-3\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-3-2-4\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-1-3-3-2-5\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n</div>\n<p class=\"mt-3 text-[13px] leading-[22px] text-[#575757] line-clamp-4\" data-kid=\"1-3-1-3-3-3\" data-name=\"review body text\">The waiter explained the pre-order link when we booked and brought the bill as soon as we asked. Nothing was missing from the order.</p>\n</article>\n</div>\n<!-- Pagination -->\n<nav aria-label=\"Review pages\" class=\"mt-8 flex items-center justify-center gap-2\" data-kid=\"1-3-1-4\" data-name=\"review pagination nav\">\n<button aria-label=\"Previous page\" class=\"w-9 h-9 flex items-center justify-center text-[#DADADA] cursor-not-allowed\" data-kid=\"1-3-1-4-1\" data-name=\"previous page button (disabled)\" disabled=\"\" type=\"button\">\n<i class=\"ti ti-chevron-left text-[18px]\" data-kid=\"1-3-1-4-1-1\" data-name=\"chevron left icon\"></i>\n</button>\n<button aria-current=\"page\" class=\"w-9 h-9 flex items-center justify-center text-[14px] font-semibold text-[#0F7A37] border-b-2 border-[#0F7A37]\" data-kid=\"1-3-1-4-2\" data-name=\"current page indicator\" type=\"button\">1</button>\n<button class=\"w-9 h-9 flex items-center justify-center text-[14px] font-medium text-[#575757] hover:text-[#0F7A37]\" data-kid=\"1-3-1-4-3\" data-name=\"page 2 pagination button\" type=\"button\">2</button>\n<button class=\"w-9 h-9 flex items-center justify-center text-[14px] font-medium text-[#575757] hover:text-[#0F7A37]\" data-kid=\"1-3-1-4-4\" data-name=\"page 3 pagination button\" type=\"button\">3</button>\n<button aria-label=\"Next page\" class=\"w-9 h-9 flex items-center justify-center text-[#575757] hover:text-[#0F7A37]\" data-kid=\"1-3-1-4-5\" data-name=\"next page button\" type=\"button\">\n<i class=\"ti ti-chevron-right text-[18px]\" data-kid=\"1-3-1-4-5-1\" data-name=\"chevron right icon\"></i>\n</button>\n</nav>\n</div>\n</section>\n</div>",
