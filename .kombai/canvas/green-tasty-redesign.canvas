      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen w-full bg-black/45 flex items-center justify-center p-10\" data-kid=\"1\" data-name=\"modal overlay backdrop with centered layout\" style=\"font-family:'Poppins',sans-serif;\">\n<!-- Dish detail modal -->\n<div class=\"relative w-[760px] bg-white rounded-[24px] shadow-[0_10px_20px_rgba(194,194,194,0.5)] p-10 flex gap-10\" data-kid=\"1-1\" data-name=\"dish detail modal card\">\n<!-- Close -->\n<button aria-label=\"Close\" class=\"absolute top-4 right-4 w-10 h-10 rounded-[8px] flex items-center justify-center text-[#575757] hover:bg-[#e9ffea] hover:text-[#0F7A37]\" data-kid=\"1-1-1\" data-name=\"close modal button\" type=\"button\">\n<i class=\"ti ti-x text-[20px]\" data-kid=\"1-1-1-1\" data-name=\"close X icon\"></i>\n</button>\n<!-- Left: image, price, weight -->\n<div class=\"w-[240px] shrink-0 flex flex-col items-center\" data-kid=\"1-1-2\" data-name=\"dish media and price column\">\n<div class=\"w-[240px] h-[240px] rounded-full overflow-hidden shadow-[0_0_20px_rgba(194,194,194,0.5)]\" data-kid=\"1-1-2-1\" data-name=\"circular dish photo wrapper\">\n<img alt=\"Truffle Mushroom Risotto — photo by Shameel mukkath on Pexels\" class=\"w-full h-full object-cover\" data-kid=\"1-1-2-1-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/5638527/pexels-photo-5638527.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=600&amp;q=80\"/>\n</div>\n<div class=\"mt-6 text-center\" data-kid=\"1-1-2-2\" data-name=\"price and weight block\">\n<div class=\"text-[28px] leading-9 font-semibold text-[#0F7A37]\" data-kid=\"1-1-2-2-1\" data-name=\"price text\">$22.50</div>\n<div class=\"mt-1 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-2-2-2\" data-name=\"weight text\">350 g</div>\n</div>\n</div>\n<!-- Right: name, description, nutrition -->\n<div class=\"flex-1 min-w-0 pt-1\" data-kid=\"1-1-3\" data-name=\"dish info column\">\n<h2 class=\"text-[26px] leading-10 font-medium text-[#232323] pr-10\" data-kid=\"1-1-3-1\" data-name=\"dish name heading\">Truffle Mushroom Risotto</h2>\n<p class=\"mt-3 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-2\" data-name=\"dish description text\">Creamy arborio rice cooked with wild mushrooms and truffle oil.</p>\n<div class=\"mt-7 text-[16px] leading-8 font-medium text-[#232323]\" data-kid=\"1-1-3-3\" data-name=\"nutrition section label\">Nutrition</div>\n<div class=\"mt-1\" data-kid=\"1-1-3-4\" data-name=\"nutrition facts list container\">\n<div class=\"flex items-baseline justify-between py-[10px] border-b border-[#f7f7f7]\" data-kid=\"1-1-3-4-1\" data-name=\"calories nutrition row\">\n<span class=\"text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-4-1-1\" data-name=\"calories label\">Calories</span>\n<span class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-1-3-4-1-2\" data-name=\"calories value\">620 kcal</span>\n</div>\n<div class=\"flex items-baseline justify-between py-[10px] border-b border-[#f7f7f7]\" data-kid=\"1-1-3-4-2\" data-name=\"protein nutrition row\">\n<span class=\"text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-4-2-1\" data-name=\"protein label\">Protein</span>\n<span class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-1-3-4-2-2\" data-name=\"protein value\">14 g</span>\n</div>\n<div class=\"flex items-baseline justify-between py-[10px] border-b border-[#f7f7f7]\" data-kid=\"1-1-3-4-3\" data-name=\"fats nutrition row\">\n<span class=\"text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-4-3-1\" data-name=\"fats label\">Fats</span>\n<span class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-1-3-4-3-2\" data-name=\"fats value\">28 g</span>\n</div>\n<div class=\"flex items-baseline justify-between py-[10px] border-b border-[#f7f7f7]\" data-kid=\"1-1-3-4-4\" data-name=\"carbohydrates nutrition row\">\n<span class=\"text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-4-4-1\" data-name=\"carbohydrates label\">Carbohydrates</span>\n<span class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-1-3-4-4-2\" data-name=\"carbohydrates value\">65 g</span>\n</div>\n<div class=\"flex items-baseline justify-between py-[10px]\" data-kid=\"1-1-3-4-5\" data-name=\"vitamins nutrition row\">\n<span class=\"text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-4-5-1\" data-name=\"vitamins label\">Vitamins</span>\n<span class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-1-3-4-5-2\" data-name=\"vitamins value\">Vitamin D, Iron</span>\n</div>\n</div>\n</div>\n</div>\n</div>",
