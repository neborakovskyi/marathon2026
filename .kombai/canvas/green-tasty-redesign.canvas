      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#F7F7EC] text-[#232323]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Poppins',sans-serif;\">\n<!-- Header -->\n<header class=\"bg-white\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"w-[1200px] mx-auto h-20 flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header content row\">\n<a aria-label=\"Green &amp; Tasty — Main page\" class=\"flex items-center shrink-0\" data-kid=\"1-1-1-1\" data-name=\"site logo link\" href=\"#\">\n<img alt=\"Green &amp; Tasty\" class=\"h-[38px] w-auto\" data-kid=\"1-1-1-1-1\" data-name=\"restaurant logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/logo_vegeterian.svg\"/>\n</a>\n<nav aria-label=\"Main\" class=\"flex items-center gap-9 text-[15px] font-medium text-[#575757]\" data-kid=\"1-1-1-2\" data-name=\"main navigation\">\n<a class=\"hover:text-[#0F7A37]\" data-kid=\"1-1-1-2-1\" data-name=\"main page navigation link\" href=\"#\">Main page</a>\n<a class=\"hover:text-[#0F7A37]\" data-kid=\"1-1-1-2-2\" data-name=\"menu navigation link\" href=\"#\">Menu</a>\n<a class=\"hover:text-[#0F7A37]\" data-kid=\"1-1-1-2-3\" data-name=\"book a table navigation link\" href=\"#\">Book a Table</a>\n<a class=\"hover:text-[#0F7A37]\" data-kid=\"1-1-1-2-4\" data-name=\"reservations navigation link\" href=\"#\">Reservations</a>\n</nav>\n<button class=\"h-10 px-5 rounded-lg border-[1.4px] border-[#0F7A37] bg-white text-[14px] font-semibold text-[#0F7A37] hover:bg-[#e9ffea]\" data-kid=\"1-1-1-3\" data-name=\"sign in button\" type=\"button\">Sign In</button>\n</div>\n</header>\n<!-- Address navigation row -->\n<div class=\"bg-white border-b border-[#ECECE2]\" data-kid=\"1-2\" data-name=\"location navigation strip\">\n<nav aria-label=\"Locations\" class=\"w-[1200px] mx-auto h-14 flex items-center gap-7 overflow-x-auto\" data-kid=\"1-2-1\" data-name=\"restaurant location tabs\">\n<a class=\"h-full flex items-center shrink-0 text-[14px] font-medium text-[#575757] hover:text-[#0F7A37]\" data-kid=\"1-2-1-1\" data-name=\"Abashidze Street location link\" href=\"#\">9 Abashidze Street</a>\n<a class=\"h-full flex items-center shrink-0 text-[14px] font-medium text-[#575757] hover:text-[#0F7A37]\" data-kid=\"1-2-1-2\" data-name=\"Baratashvili Street location link\" href=\"#\">14 Baratashvili Street</a>\n<a class=\"h-full flex items-center shrink-0 text-[14px] font-medium text-[#575757] hover:text-[#0F7A37]\" data-kid=\"1-2-1-3\" data-name=\"Rustaveli Avenue location link\" href=\"#\">48 Rustaveli Avenue</a>\n<a class=\"h-full flex items-center shrink-0 text-[14px] font-medium text-[#575757] hover:text-[#0F7A37]\" data-kid=\"1-2-1-4\" data-name=\"Chavchavadze Avenue location link\" href=\"#\">22 Chavchavadze Avenue</a>\n<a aria-current=\"page\" class=\"h-full flex items-center shrink-0 text-[14px] font-semibold text-[#0F7A37] border-b-2 border-[#0F7A37]\" data-kid=\"1-2-1-5\" data-name=\"active Dadiani Street location link\" href=\"#\">8 Dadiani Street</a>\n<a class=\"h-full flex items-center shrink-0 text-[14px] font-medium text-[#575757] hover:text-[#0F7A37]\" data-kid=\"1-2-1-6\" data-name=\"Pekini Avenue location link\" href=\"#\">11 Pekini Avenue</a>\n</nav>\n</div>\n<main data-kid=\"1-3\" data-name=\"main content area\">\n<!-- Venue composition -->\n<section class=\"w-[1200px] mx-auto pt-10 pb-12 flex gap-6\" data-kid=\"1-3-1\" data-name=\"venue composition section\">\n<img alt=\"Dining room at 8 Dadiani Street\" class=\"w-[744px] h-[392px] shrink-0 rounded-2xl object-cover\" data-kid=\"1-3-1-1\" data-name=\"dining room photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/locations/abashidze-street-9.jpg\"/>\n<aside class=\"w-[432px] h-[392px] shrink-0 bg-white rounded-2xl border border-[#ECECE2] p-5 flex flex-col\" data-kid=\"1-3-1-2\" data-name=\"venue details card\">\n<h1 class=\"text-[26px] leading-9 font-medium text-[#232323]\" data-kid=\"1-3-1-2-1\" data-name=\"venue name heading\">8 Dadiani Street</h1>\n<div class=\"mt-2 flex items-center gap-1.5\" data-kid=\"1-3-1-2-2\" data-name=\"rating display row\">\n<img alt=\"\" class=\"w-[18px] h-[18px]\" data-kid=\"1-3-1-2-2-1\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<span class=\"text-[14px] font-semibold text-[#232323]\" data-kid=\"1-3-1-2-2-2\" data-name=\"numeric rating text\">4.7 / 5</span>\n</div>\n<p class=\"mt-3 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-3-1-2-3\" data-name=\"venue description text\">Steakhouse with a wine cellar and private dining rooms.</p>\n<div class=\"mt-5 pt-4 border-t border-[#ECECE2] flex items-center gap-10\" data-kid=\"1-3-1-2-4\" data-name=\"venue statistics row\">\n<div data-kid=\"1-3-1-2-4-1\" data-name=\"tables statistic\">\n<div class=\"text-[12px] text-[#898989]\" data-kid=\"1-3-1-2-4-1-1\" data-name=\"tables statistic label\">Tables</div>\n<div class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-3-1-2-4-1-2\" data-name=\"tables statistic value\">4</div>\n</div>\n<div data-kid=\"1-3-1-2-4-2\" data-name=\"daily occupancy statistic\">\n<div class=\"text-[12px] text-[#898989]\" data-kid=\"1-3-1-2-4-2-1\" data-name=\"occupancy statistic label\">Daily occupancy</div>\n<div class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-3-1-2-4-2-2\" data-name=\"occupancy statistic value\">72%</div>\n</div>\n</div>\n<div class=\"mt-auto flex flex-col gap-3\" data-kid=\"1-3-1-2-5\" data-name=\"venue action buttons container\">\n<button class=\"h-14 w-full rounded-lg text-white text-[16px] font-semibold\" data-kid=\"1-3-1-2-5-1\" data-name=\"book a table primary button\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%)\" type=\"button\">Book a Table</button>\n<button class=\"h-10 w-full rounded-lg border-[1.4px] border-[#0F7A37] bg-white text-[14px] font-semibold text-[#0F7A37] hover:bg-[#e9ffea]\" data-kid=\"1-3-1-2-5-2\" data-name=\"view menu secondary button\" type=\"button\">View menu</button>\n</div>\n</aside>\n</section>\n<!-- Reviews -->\n<section class=\"bg-white\" data-kid=\"1-3-2\" data-name=\"customer reviews section\">\n<div class=\"w-[1200px] mx-auto py-12\" data-kid=\"1-3-2-1\" data-name=\"reviews section container\">\n<h2 class=\"text-[32px] leading-10 font-medium text-[#232323]\" data-kid=\"1-3-2-1-1\" data-name=\"section heading text\">Customer Reviews</h2>\n<div class=\"mt-6 flex items-center justify-between\" data-kid=\"1-3-2-1-2\" data-name=\"review controls row\">\n<div class=\"inline-flex items-center gap-1 rounded-lg border border-[#ECECE2] bg-white p-1\" data-kid=\"1-3-2-1-2-1\" data-name=\"review category filter tabs\">\n<button class=\"h-9 px-5 rounded-md text-[14px] font-semibold text-white\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"active service category button\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%)\" type=\"button\">Service</button>\n<button class=\"h-9 px-5 rounded-md text-[14px] font-medium text-[#575757] hover:text-[#0F7A37]\" data-kid=\"1-3-2-1-2-1-2\" data-name=\"cuisine experience category button\" type=\"button\">Cuisine experience</button>\n</div>\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-2-1-2-2\" data-name=\"sort controls row\">\n<span class=\"text-[14px] text-[#575757]\" data-kid=\"1-3-2-1-2-2-1\" data-name=\"sort label text\">Sort by:</span>\n<div class=\"relative\" data-kid=\"1-3-2-1-2-2-2\" data-name=\"sort dropdown wrapper\">\n<select class=\"h-12 w-[220px] appearance-none rounded-lg border border-[#DADADA] bg-white pl-4 pr-9 text-[14px] font-medium text-[#232323]\" data-kid=\"1-3-2-1-2-2-2-1\" data-name=\"sort order select dropdown\">\n<option data-kid=\"1-3-2-1-2-2-2-1-1\" data-name=\"top rated first sort option\" selected=\"\">Top rated first</option>\n<option data-kid=\"1-3-2-1-2-2-2-1-2\" data-name=\"low rated first sort option\">Low rated first</option>\n<option data-kid=\"1-3-2-1-2-2-2-1-3\" data-name=\"newest first sort option\">Newest first</option>\n<option data-kid=\"1-3-2-1-2-2-2-1-4\" data-name=\"oldest first sort option\">Oldest first</option>\n</select>\n<i class=\"ti ti-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[16px] text-[#0F7A37] pointer-events-none\" data-kid=\"1-3-2-1-2-2-2-2\" data-name=\"chevron down dropdown icon\"></i>\n</div>\n</div>\n</div>\n<div class=\"mt-6 grid grid-cols-3 gap-6\" data-kid=\"1-3-2-1-3\" data-name=\"review cards grid\">\n<article class=\"bg-white rounded-2xl border border-[#ECECE2] p-5 flex flex-col shadow-[0_4px_15px_rgba(194,194,194,0.25)]\" data-kid=\"1-3-2-1-3-1\" data-name=\"review card\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-2-1-3-1-1\" data-name=\"reviewer profile row\">\n<img alt=\"Giorgi Kapanadze\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"1-3-2-1-3-1-1-1\" data-name=\"reviewer avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?u=giorgi-kapanadze\"/>\n<div data-kid=\"1-3-2-1-3-1-1-2\" data-name=\"reviewer info container\">\n<div class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-3-2-1-3-1-1-2-1\" data-name=\"reviewer name text\">Giorgi Kapanadze</div>\n<div class=\"text-[12px] text-[#898989]\" data-kid=\"1-3-2-1-3-1-1-2-2\" data-name=\"review date text\">Oct 03, 2026</div>\n</div>\n</div>\n<div aria-label=\"Rated 5 stars\" class=\"mt-3 flex items-center gap-1\" data-kid=\"1-3-2-1-3-1-2\" data-name=\"star rating display\">\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-1-2-1\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-1-2-2\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-1-2-3\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-1-2-4\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-1-2-5\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n</div>\n<p class=\"mt-3 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-3-2-1-3-1-3\" data-name=\"review body text\">Our waiter walked us through the wine list and paired each course without rushing us. The table was set at the reserved time and the private room was ready when our guests arrived.</p>\n</article>\n<article class=\"bg-white rounded-2xl border border-[#ECECE2] p-5 flex flex-col shadow-[0_4px_15px_rgba(194,194,194,0.25)]\" data-kid=\"1-3-2-1-3-2\" data-name=\"review card\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-2-1-3-2-1\" data-name=\"reviewer profile row\">\n<img alt=\"Luka Maisuradze\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"1-3-2-1-3-2-1-1\" data-name=\"reviewer avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?u=luka-maisuradze\"/>\n<div data-kid=\"1-3-2-1-3-2-1-2\" data-name=\"reviewer info container\">\n<div class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-3-2-1-3-2-1-2-1\" data-name=\"reviewer name text\">Luka Maisuradze</div>\n<div class=\"text-[12px] text-[#898989]\" data-kid=\"1-3-2-1-3-2-1-2-2\" data-name=\"review date text\">Sep 21, 2026</div>\n</div>\n</div>\n<div aria-label=\"Rated 4 stars\" class=\"mt-3 flex items-center gap-1\" data-kid=\"1-3-2-1-3-2-2\" data-name=\"star rating display\">\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-2-2-1\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-2-2-2\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-2-2-3\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-2-2-4\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4 opacity-30\" data-kid=\"1-3-2-1-3-2-2-5\" data-name=\"empty star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n</div>\n<p class=\"mt-3 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-3-2-1-3-2-3\" data-name=\"review body text\">Service stayed attentive even with a full dinner room. We waited about ten minutes for the second course; everything else arrived on time and the waiter flagged the delay himself.</p>\n</article>\n<article class=\"bg-white rounded-2xl border border-[#ECECE2] p-5 flex flex-col shadow-[0_4px_15px_rgba(194,194,194,0.25)]\" data-kid=\"1-3-2-1-3-3\" data-name=\"review card\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-2-1-3-3-1\" data-name=\"reviewer profile row\">\n<img alt=\"Tamar Gelashvili\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"1-3-2-1-3-3-1-1\" data-name=\"reviewer avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?u=tamar-gelashvili\"/>\n<div data-kid=\"1-3-2-1-3-3-1-2\" data-name=\"reviewer info container\">\n<div class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-3-2-1-3-3-1-2-1\" data-name=\"reviewer name text\">Tamar Gelashvili</div>\n<div class=\"text-[12px] text-[#898989]\" data-kid=\"1-3-2-1-3-3-1-2-2\" data-name=\"review date text\">Sep 08, 2026</div>\n</div>\n</div>\n<div aria-label=\"Rated 5 stars\" class=\"mt-3 flex items-center gap-1\" data-kid=\"1-3-2-1-3-3-2\" data-name=\"star rating display\">\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-3-2-1\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-3-2-2\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-3-2-3\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-3-2-4\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-2-1-3-3-2-5\" data-name=\"filled star icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n</div>\n<p class=\"mt-3 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-3-2-1-3-3-3\" data-name=\"review body text\">Booked for six people through the site and the table matched the reservation exactly. Water and bread were refreshed between courses without asking.</p>\n</article>\n</div>\n<nav aria-label=\"Review pages\" class=\"mt-8 flex items-center justify-center gap-2 text-[14px]\" data-kid=\"1-3-2-1-4\" data-name=\"pagination navigation\">\n<button aria-label=\"Previous page\" class=\"w-9 h-9 rounded-lg text-[#B4B4B4] cursor-not-allowed\" data-kid=\"1-3-2-1-4-1\" data-name=\"previous page button\" disabled=\"\" type=\"button\"><i class=\"ti ti-chevron-left text-[18px]\" data-kid=\"1-3-2-1-4-1-1\" data-name=\"chevron left icon\"></i></button>\n<button aria-current=\"page\" class=\"w-9 h-9 rounded-lg text-[#0F7A37] font-semibold border-b-2 border-[#0F7A37]\" data-kid=\"1-3-2-1-4-2\" data-name=\"current page button\" type=\"button\">1</button>\n<button class=\"w-9 h-9 rounded-lg text-[#575757] hover:bg-[#F7F7EC]\" data-kid=\"1-3-2-1-4-3\" data-name=\"page two button\" type=\"button\">2</button>\n<button class=\"w-9 h-9 rounded-lg text-[#575757] hover:bg-[#F7F7EC]\" data-kid=\"1-3-2-1-4-4\" data-name=\"page three button\" type=\"button\">3</button>\n<button aria-label=\"Next page\" class=\"w-9 h-9 rounded-lg text-[#575757] hover:bg-[#F7F7EC]\" data-kid=\"1-3-2-1-4-5\" data-name=\"next page button\" type=\"button\"><i class=\"ti ti-chevron-right text-[18px]\" data-kid=\"1-3-2-1-4-5-1\" data-name=\"chevron right icon\"></i></button>\n</nav>\n</div>\n</section>\n</main>\n</div>",
