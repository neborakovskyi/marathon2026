      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen w-full bg-black/45 flex items-center justify-center gap-6 p-10\" data-kid=\"1\" data-name=\"modal page layout container\" style=\"font-family:'Poppins',sans-serif;\">\n<section aria-labelledby=\"v3-review-title\" aria-modal=\"true\" class=\"relative w-[560px] shrink-0 bg-white rounded-3xl p-10 shadow-[0_24px_64px_rgba(35,35,35,0.28)]\" data-kid=\"1-1\" data-name=\"reservation review dialog card\" role=\"dialog\">\n<button aria-label=\"Close\" class=\"absolute top-6 right-6 w-10 h-10 rounded-lg flex items-center justify-center text-[#575757] hover:bg-[#e9ffea] hover:text-[#0F7A37]\" data-kid=\"1-1-1\" data-name=\"dialog close button\" type=\"button\">\n<i class=\"ti ti-x text-[20px]\" data-kid=\"1-1-1-1\" data-name=\"close X icon\"></i>\n</button>\n<h2 class=\"text-[24px] leading-8 font-medium text-[#232323] pr-10\" data-kid=\"1-1-2\" data-name=\"review dialog heading\" id=\"v3-review-title\">Review &amp; Confirm Reservation</h2>\n<dl class=\"mt-6 border-y border-[#ECECE2] divide-y divide-[#ECECE2]\" data-kid=\"1-1-3\" data-name=\"reservation details list\">\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-1-3-1\" data-name=\"location detail row\">\n<dt class=\"flex items-center gap-2 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-1-1\" data-name=\"location label\"><i class=\"ti ti-map-pin text-[18px] text-[#0F7A37]\" data-kid=\"1-1-3-1-1-1\" data-name=\"map pin icon\"></i>Location</dt>\n<dd class=\"text-[16px] leading-6 font-semibold text-[#232323]\" data-kid=\"1-1-3-1-2\" data-name=\"location value text\">14 Baratashvili Street</dd>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-1-3-2\" data-name=\"date detail row\">\n<dt class=\"flex items-center gap-2 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-2-1\" data-name=\"date label\"><i class=\"ti ti-calendar text-[18px] text-[#0F7A37]\" data-kid=\"1-1-3-2-1-1\" data-name=\"calendar icon\"></i>Date</dt>\n<dd class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-1-3-2-2\" data-name=\"date value text\">Oct 30, 2026</dd>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-1-3-3\" data-name=\"time detail row\">\n<dt class=\"flex items-center gap-2 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-3-1\" data-name=\"time label\"><i class=\"ti ti-clock text-[18px] text-[#0F7A37]\" data-kid=\"1-1-3-3-1-1\" data-name=\"clock icon\"></i>Time</dt>\n<dd class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-1-3-3-2\" data-name=\"time value text\">19:00</dd>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-1-3-4\" data-name=\"guests detail row\">\n<dt class=\"flex items-center gap-2 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-4-1\" data-name=\"guests label\"><i class=\"ti ti-users text-[18px] text-[#0F7A37]\" data-kid=\"1-1-3-4-1-1\" data-name=\"users icon\"></i>Guests</dt>\n<dd class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-1-3-4-2\" data-name=\"guests value text\">2</dd>\n</div>\n</dl>\n<p class=\"mt-6 flex items-start gap-2 rounded-lg bg-[#e9ffea] px-4 py-3 text-[13px] leading-5 text-[#0B5B29]\" data-kid=\"1-1-4\" data-name=\"cancellation policy info note\">\n<i class=\"ti ti-info-circle text-[18px] shrink-0\" data-kid=\"1-1-4-1\" data-name=\"info circle icon\"></i>\n      You can cancel up to 30 min before your reservation.\n    </p>\n<div class=\"mt-8 flex gap-4\" data-kid=\"1-1-5\" data-name=\"dialog action buttons row\">\n<button class=\"flex-1 h-10 rounded-lg bg-white border-[1.4px] border-[#0F7A37] text-[#0F7A37] text-[14px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-1-5-1\" data-name=\"edit reservation button\" type=\"button\">Edit</button>\n<button class=\"flex-1 h-10 rounded-lg text-white text-[14px] font-semibold\" data-kid=\"1-1-5-2\" data-name=\"confirm reservation primary button\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%)\" type=\"button\">Confirm</button>\n</div>\n</section>\n<section aria-labelledby=\"v3-confirmed-title\" aria-modal=\"true\" class=\"relative w-[600px] shrink-0 bg-white rounded-3xl p-10 shadow-[0_24px_64px_rgba(35,35,35,0.28)]\" data-kid=\"1-2\" data-name=\"reservation confirmed dialog card\" role=\"dialog\">\n<button aria-label=\"Close\" class=\"absolute top-6 right-6 w-10 h-10 rounded-lg flex items-center justify-center text-[#575757] hover:bg-[#e9ffea] hover:text-[#0F7A37]\" data-kid=\"1-2-1\" data-name=\"dialog close button\" type=\"button\">\n<i class=\"ti ti-x text-[20px]\" data-kid=\"1-2-1-1\" data-name=\"close X icon\"></i>\n</button>\n<div class=\"flex items-center gap-3 pr-10\" data-kid=\"1-2-2\" data-name=\"confirmation header with icon\">\n<i class=\"ti ti-circle-check text-[26px] text-[#0F7A37]\" data-kid=\"1-2-2-1\" data-name=\"checkmark circle icon\"></i>\n<h2 class=\"text-[24px] leading-8 font-medium text-[#232323]\" data-kid=\"1-2-2-2\" data-name=\"confirmation heading text\" id=\"v3-confirmed-title\">Reservation Confirmed</h2>\n</div>\n<dl class=\"mt-6 border-y border-[#ECECE2] divide-y divide-[#ECECE2]\" data-kid=\"1-2-3\" data-name=\"reservation details list\">\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-2-3-1\" data-name=\"location detail row\">\n<dt class=\"flex items-center gap-2 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-2-3-1-1\" data-name=\"location label\"><i class=\"ti ti-map-pin text-[18px] text-[#0F7A37]\" data-kid=\"1-2-3-1-1-1\" data-name=\"map pin icon\"></i>Location</dt>\n<dd class=\"text-[16px] leading-6 font-semibold text-[#232323]\" data-kid=\"1-2-3-1-2\" data-name=\"location value text\">14 Baratashvili Street</dd>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-2-3-2\" data-name=\"date detail row\">\n<dt class=\"flex items-center gap-2 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-2-3-2-1\" data-name=\"date label\"><i class=\"ti ti-calendar text-[18px] text-[#0F7A37]\" data-kid=\"1-2-3-2-1-1\" data-name=\"calendar icon\"></i>Date</dt>\n<dd class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-2-3-2-2\" data-name=\"date value text\">Oct 30, 2026</dd>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-2-3-3\" data-name=\"time detail row\">\n<dt class=\"flex items-center gap-2 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-2-3-3-1\" data-name=\"time label\"><i class=\"ti ti-clock text-[18px] text-[#0F7A37]\" data-kid=\"1-2-3-3-1-1\" data-name=\"clock icon\"></i>Time</dt>\n<dd class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-2-3-3-2\" data-name=\"time value text\">19:00</dd>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-2-3-4\" data-name=\"guests detail row\">\n<dt class=\"flex items-center gap-2 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-2-3-4-1\" data-name=\"guests label\"><i class=\"ti ti-users text-[18px] text-[#0F7A37]\" data-kid=\"1-2-3-4-1-1\" data-name=\"users icon\"></i>Guests</dt>\n<dd class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-2-3-4-2\" data-name=\"guests value text\">2</dd>\n</div>\n</dl>\n<div class=\"mt-6\" data-kid=\"1-2-4\" data-name=\"invite link section\">\n<span class=\"block text-[13px] leading-5 text-[#575757] mb-2\" data-kid=\"1-2-4-1\" data-name=\"invite link field label\">Invite link</span>\n<div class=\"flex gap-3\" data-kid=\"1-2-4-2\" data-name=\"invite link input row\">\n<input class=\"flex-1 h-10 rounded-lg border border-[#ECECE2] bg-[#F7F7F7] px-3 text-[13px] leading-6 text-[#575757]\" data-kid=\"1-2-4-2-1\" data-name=\"read-only invite link input field\" readonly=\"\" type=\"text\" value=\"https://greenandtasty.ge/join/2m7xkd\"/>\n<button class=\"h-10 px-4 rounded-lg bg-white border-[1.4px] border-[#0F7A37] text-[#0F7A37] text-[14px] font-semibold hover:bg-[#e9ffea] flex items-center gap-2 shrink-0\" data-kid=\"1-2-4-2-2\" data-name=\"copy invite link button\" type=\"button\">\n<i class=\"ti ti-copy text-[18px]\" data-kid=\"1-2-4-2-2-1\" data-name=\"copy icon\"></i>Copy invite link\n        </button>\n</div>\n<p class=\"mt-2 text-[12px] leading-5 text-[#898989]\" data-kid=\"1-2-4-3\" data-name=\"invite link helper text\">You are able to share this link for pre-order with your group.</p>\n</div>\n<div class=\"mt-8 flex gap-4\" data-kid=\"1-2-5\" data-name=\"dialog action buttons row\">\n<button class=\"flex-1 h-10 rounded-lg bg-white border-[1.4px] border-[#0F7A37] text-[#0F7A37] text-[14px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-2-5-1\" data-name=\"view reservation button\" type=\"button\">View Reservation</button>\n<button class=\"flex-1 h-10 rounded-lg text-white text-[14px] font-semibold\" data-kid=\"1-2-5-2\" data-name=\"make pre-order primary button\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%)\" type=\"button\">Make Pre-Order</button>\n</div>\n</section>\n</div>",
