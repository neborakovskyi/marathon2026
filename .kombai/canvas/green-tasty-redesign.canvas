      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen w-full bg-[#F7F7EC] text-[#232323]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Poppins',sans-serif;\">\n<!-- Header -->\n<header class=\"h-20 bg-white flex items-center justify-between px-8\" data-kid=\"1-1\" data-name=\"header bar\">\n<a aria-label=\"Green &amp; Tasty — Main page\" class=\"shrink-0\" data-kid=\"1-1-1\" data-name=\"restaurant logo link\" href=\"#\">\n<img alt=\"Green &amp; Tasty\" class=\"h-[38px] w-auto\" data-kid=\"1-1-1-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/logo_vegeterian.svg\"/>\n</a>\n<nav aria-label=\"Main\" class=\"flex items-center gap-9\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n<a class=\"text-[15px] font-medium text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-1\" data-name=\"main page nav link\" href=\"#\">Main page</a>\n<a aria-current=\"page\" class=\"text-[15px] font-medium text-[#0F7A37] border-b-2 border-[#0F7A37] pb-1\" data-kid=\"1-1-2-2\" data-name=\"active menu nav link\" href=\"#\">Menu</a>\n<a class=\"text-[15px] font-medium text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-3\" data-name=\"book a table nav link\" href=\"#\">Book a Table</a>\n<a class=\"text-[15px] font-medium text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-4\" data-name=\"reservations nav link\" href=\"#\">Reservations</a>\n</nav>\n<button class=\"h-10 px-5 rounded-lg border-[1.4px] border-[#0F7A37] text-[#0F7A37] text-[14px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-1-3\" data-name=\"sign in button\" type=\"button\">Sign In</button>\n</header>\n<main class=\"px-8 pt-6 pb-12\" data-kid=\"1-2\" data-name=\"main content area\">\n<!-- Title -->\n<h1 class=\"text-[32px] leading-10 font-medium text-[#232323]\" data-kid=\"1-2-1\" data-name=\"page title heading\">Menu</h1>\n<!-- Toolbar: category tabs + sort -->\n<div class=\"mt-4 flex items-end justify-between border-b border-[#E4E4D6]\" data-kid=\"1-2-2\" data-name=\"filter toolbar with tabs and sort\">\n<div aria-label=\"Dish categories\" class=\"flex items-center gap-7\" data-kid=\"1-2-2-1\" data-name=\"dish category tab list\" role=\"tablist\">\n<button aria-selected=\"true\" class=\"pb-3 -mb-px text-[14px] font-semibold text-[#0F7A37] border-b-2 border-[#0F7A37]\" data-kid=\"1-2-2-1-1\" data-name=\"all categories active tab\" role=\"tab\" type=\"button\">All</button>\n<button aria-selected=\"false\" class=\"pb-3 -mb-px text-[14px] font-medium text-[#575757] border-b-2 border-transparent hover:text-[#0F7A37]\" data-kid=\"1-2-2-1-2\" data-name=\"appetizers category tab\" role=\"tab\" type=\"button\">Appetizers</button>\n<button aria-selected=\"false\" class=\"pb-3 -mb-px text-[14px] font-medium text-[#575757] border-b-2 border-transparent hover:text-[#0F7A37]\" data-kid=\"1-2-2-1-3\" data-name=\"main courses category tab\" role=\"tab\" type=\"button\">Main Courses</button>\n<button aria-selected=\"false\" class=\"pb-3 -mb-px text-[14px] font-medium text-[#575757] border-b-2 border-transparent hover:text-[#0F7A37]\" data-kid=\"1-2-2-1-4\" data-name=\"desserts category tab\" role=\"tab\" type=\"button\">Desserts</button>\n</div>\n<div class=\"flex items-center gap-2 pb-2\" data-kid=\"1-2-2-2\" data-name=\"sort dropdown group\">\n<span class=\"text-[13px] text-[#575757]\" data-kid=\"1-2-2-2-1\" data-name=\"sort by label text\">Sort by:</span>\n<button aria-haspopup=\"listbox\" class=\"h-12 w-[248px] bg-white border border-[#DADADA] rounded-lg px-4 flex items-center justify-between text-[14px] font-medium text-[#232323] hover:border-[#0F7A37]\" data-kid=\"1-2-2-2-2\" data-name=\"sort options dropdown button\" type=\"button\">\n<span data-kid=\"1-2-2-2-2-1\" data-name=\"dropdown selected value text\">Popularity Descending</span>\n<i class=\"ti ti-chevron-down text-[16px] text-[#575757]\" data-kid=\"1-2-2-2-2-2\" data-name=\"chevron-down dropdown icon\"></i>\n</button>\n</div>\n</div>\n<!-- Dish grid: 4 columns -->\n<div class=\"mt-6 grid grid-cols-4 gap-5\" data-kid=\"1-2-3\" data-name=\"dish grid container\">\n<!-- Green Salad -->\n<article class=\"relative h-[244px] bg-white rounded-xl border border-[#ECECE2] p-4 flex items-center gap-4 shadow-[0_1px_2px_rgba(35,35,35,0.06)]\" data-kid=\"1-2-3-1\" data-name=\"green salad dish card\">\n<img alt=\"Green Salad — photo by Asya Vlasova on Pexels\" class=\"w-[124px] h-[124px] rounded-full object-cover shrink-0 ring-4 ring-[#F7F7EC]\" data-kid=\"1-2-3-1-1\" data-name=\"green salad round photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/4887993/pexels-photo-4887993.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div class=\"flex-1 h-full min-w-0 flex flex-col py-2\" data-kid=\"1-2-3-1-2\" data-name=\"dish info column\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323] line-clamp-2\" data-kid=\"1-2-3-1-2-1\" data-name=\"green salad dish name\">Green Salad</h3>\n<span class=\"mt-1 text-[12px] text-[#898989]\" data-kid=\"1-2-3-1-2-2\" data-name=\"green salad portion weight\">220g</span>\n<span class=\"flex-1\" data-kid=\"1-2-3-1-2-3\" data-name=\"flex spacer between weight and price\"></span>\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-1-2-4\" data-name=\"green salad price\">$9.99</span>\n</div>\n</article>\n<!-- Fresh Avocado Toast -->\n<article class=\"relative h-[244px] bg-white rounded-xl border border-[#ECECE2] p-4 flex items-center gap-4 shadow-[0_1px_2px_rgba(35,35,35,0.06)]\" data-kid=\"1-2-3-2\" data-name=\"fresh avocado toast dish card\">\n<img alt=\"Fresh Avocado Toast — photo by Karelia Blum on Pexels\" class=\"w-[124px] h-[124px] rounded-full object-cover shrink-0 ring-4 ring-[#F7F7EC]\" data-kid=\"1-2-3-2-1\" data-name=\"avocado toast round photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/6609084/pexels-photo-6609084.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div class=\"flex-1 h-full min-w-0 flex flex-col py-2\" data-kid=\"1-2-3-2-2\" data-name=\"dish info column\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323] line-clamp-2\" data-kid=\"1-2-3-2-2-1\" data-name=\"avocado toast dish name\">Fresh Avocado Toast</h3>\n<span class=\"mt-1 text-[12px] text-[#898989]\" data-kid=\"1-2-3-2-2-2\" data-name=\"avocado toast portion weight\">200g</span>\n<span class=\"flex-1\" data-kid=\"1-2-3-2-2-3\" data-name=\"flex spacer between weight and price\"></span>\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-2-2-4\" data-name=\"avocado toast price\">$12.00</span>\n</div>\n</article>\n<!-- Tomato Soup -->\n<article class=\"relative h-[244px] bg-white rounded-xl border border-[#ECECE2] p-4 flex items-center gap-4 shadow-[0_1px_2px_rgba(35,35,35,0.06)]\" data-kid=\"1-2-3-3\" data-name=\"tomato soup dish card\">\n<img alt=\"Tomato Soup — photo by Farhad Ibrahimzade on Pexels\" class=\"w-[124px] h-[124px] rounded-full object-cover shrink-0 ring-4 ring-[#F7F7EC]\" data-kid=\"1-2-3-3-1\" data-name=\"tomato soup round photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/8738008/pexels-photo-8738008.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div class=\"flex-1 h-full min-w-0 flex flex-col py-2\" data-kid=\"1-2-3-3-2\" data-name=\"dish info column\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323] line-clamp-2\" data-kid=\"1-2-3-3-2-1\" data-name=\"tomato soup dish name\">Tomato Soup</h3>\n<span class=\"mt-1 text-[12px] text-[#898989]\" data-kid=\"1-2-3-3-2-2\" data-name=\"tomato soup portion weight\">250 g</span>\n<span class=\"flex-1\" data-kid=\"1-2-3-3-2-3\" data-name=\"flex spacer between weight and price\"></span>\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-3-2-4\" data-name=\"tomato soup price\">$7.50</span>\n</div>\n</article>\n<!-- Grilled Salmon -->\n<article class=\"relative h-[244px] bg-white rounded-xl border border-[#ECECE2] p-4 flex items-center gap-4 shadow-[0_1px_2px_rgba(35,35,35,0.06)]\" data-kid=\"1-2-3-4\" data-name=\"grilled salmon dish card\">\n<img alt=\"Grilled Salmon — photo by Cristian Mihaila on Pexels\" class=\"w-[124px] h-[124px] rounded-full object-cover shrink-0 ring-4 ring-[#F7F7EC]\" data-kid=\"1-2-3-4-1\" data-name=\"grilled salmon round photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12431192/pexels-photo-12431192.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div class=\"flex-1 h-full min-w-0 flex flex-col py-2\" data-kid=\"1-2-3-4-2\" data-name=\"dish info column\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323] line-clamp-2\" data-kid=\"1-2-3-4-2-1\" data-name=\"grilled salmon dish name\">Grilled Salmon</h3>\n<span class=\"mt-1 text-[12px] text-[#898989]\" data-kid=\"1-2-3-4-2-2\" data-name=\"grilled salmon portion weight\">320 g</span>\n<span class=\"flex-1\" data-kid=\"1-2-3-4-2-3\" data-name=\"flex spacer between weight and price\"></span>\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-4-2-4\" data-name=\"grilled salmon price\">$18.99</span>\n</div>\n</article>\n<!-- Truffle Mushroom Risotto -->\n<article class=\"relative h-[244px] bg-white rounded-xl border border-[#ECECE2] p-4 flex items-center gap-4 shadow-[0_1px_2px_rgba(35,35,35,0.06)]\" data-kid=\"1-2-3-5\" data-name=\"truffle mushroom risotto dish card\">\n<img alt=\"Truffle Mushroom Risotto — photo by Shameel mukkath on Pexels\" class=\"w-[124px] h-[124px] rounded-full object-cover shrink-0 ring-4 ring-[#F7F7EC]\" data-kid=\"1-2-3-5-1\" data-name=\"truffle risotto round photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/5638527/pexels-photo-5638527.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div class=\"flex-1 h-full min-w-0 flex flex-col py-2\" data-kid=\"1-2-3-5-2\" data-name=\"dish info column\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323] line-clamp-3\" data-kid=\"1-2-3-5-2-1\" data-name=\"truffle risotto dish name\">Truffle Mushroom Risotto</h3>\n<span class=\"mt-1 text-[12px] text-[#898989]\" data-kid=\"1-2-3-5-2-2\" data-name=\"truffle risotto portion weight\">350g</span>\n<span class=\"flex-1\" data-kid=\"1-2-3-5-2-3\" data-name=\"flex spacer between weight and price\"></span>\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-5-2-4\" data-name=\"truffle risotto price\">$22.50</span>\n</div>\n</article>\n<!-- Margherita Pizza -->\n<article class=\"relative h-[244px] bg-white rounded-xl border border-[#ECECE2] p-4 flex items-center gap-4 shadow-[0_1px_2px_rgba(35,35,35,0.06)]\" data-kid=\"1-2-3-6\" data-name=\"margherita pizza dish card\">\n<img alt=\"Margherita Pizza — photo by Nadin Sh on Pexels\" class=\"w-[124px] h-[124px] rounded-full object-cover shrink-0 ring-4 ring-[#F7F7EC]\" data-kid=\"1-2-3-6-1\" data-name=\"margherita pizza round photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/13859836/pexels-photo-13859836.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div class=\"flex-1 h-full min-w-0 flex flex-col py-2\" data-kid=\"1-2-3-6-2\" data-name=\"dish info column\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323] line-clamp-2\" data-kid=\"1-2-3-6-2-1\" data-name=\"margherita pizza dish name\">Margherita Pizza</h3>\n<span class=\"mt-1 text-[12px] text-[#898989]\" data-kid=\"1-2-3-6-2-2\" data-name=\"margherita pizza portion weight\">450 g</span>\n<span class=\"flex-1\" data-kid=\"1-2-3-6-2-3\" data-name=\"flex spacer between weight and price\"></span>\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-6-2-4\" data-name=\"margherita pizza price\">$14.99</span>\n</div>\n</article>\n<!-- Khachapuri Adjarian -->\n<article class=\"relative h-[244px] bg-white rounded-xl border border-[#ECECE2] p-4 flex items-center gap-4 shadow-[0_1px_2px_rgba(35,35,35,0.06)]\" data-kid=\"1-2-3-7\" data-name=\"khachapuri adjarian dish card\">\n<img alt=\"Khachapuri Adjarian — photo by Valeria Boltneva on Pexels\" class=\"w-[124px] h-[124px] rounded-full object-cover shrink-0 ring-4 ring-[#F7F7EC]\" data-kid=\"1-2-3-7-1\" data-name=\"khachapuri round photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/18330960/pexels-photo-18330960.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div class=\"flex-1 h-full min-w-0 flex flex-col py-2\" data-kid=\"1-2-3-7-2\" data-name=\"dish info column\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323] line-clamp-2\" data-kid=\"1-2-3-7-2-1\" data-name=\"khachapuri dish name\">Khachapuri Adjarian</h3>\n<span class=\"mt-1 text-[12px] text-[#898989]\" data-kid=\"1-2-3-7-2-2\" data-name=\"khachapuri portion weight\">380 g</span>\n<span class=\"flex-1\" data-kid=\"1-2-3-7-2-3\" data-name=\"flex spacer between weight and price\"></span>\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-7-2-4\" data-name=\"khachapuri price\">$16.50</span>\n</div>\n</article>\n<!-- Lamb Shashlik -->\n<article class=\"relative h-[244px] bg-white rounded-xl border border-[#ECECE2] p-4 flex items-center gap-4 shadow-[0_1px_2px_rgba(35,35,35,0.06)]\" data-kid=\"1-2-3-8\" data-name=\"lamb shashlik dish card\">\n<img alt=\"Lamb Shashlik — photo by Samer Daboul on Pexels\" class=\"w-[124px] h-[124px] rounded-full object-cover shrink-0 ring-4 ring-[#F7F7EC]\" data-kid=\"1-2-3-8-1\" data-name=\"lamb shashlik round photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/2233729/pexels-photo-2233729.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div class=\"flex-1 h-full min-w-0 flex flex-col py-2\" data-kid=\"1-2-3-8-2\" data-name=\"dish info column\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323] line-clamp-2\" data-kid=\"1-2-3-8-2-1\" data-name=\"lamb shashlik dish name\">Lamb Shashlik</h3>\n<span class=\"mt-1 text-[12px] text-[#898989]\" data-kid=\"1-2-3-8-2-2\" data-name=\"lamb shashlik portion weight\">300 g</span>\n<span class=\"flex-1\" data-kid=\"1-2-3-8-2-3\" data-name=\"flex spacer between weight and price\"></span>\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-8-2-4\" data-name=\"lamb shashlik price\">$21.00</span>\n</div>\n</article>\n<!-- Beef Steak -->\n<article class=\"relative h-[244px] bg-white rounded-xl border border-[#ECECE2] p-4 flex items-center gap-4 shadow-[0_1px_2px_rgba(35,35,35,0.06)]\" data-kid=\"1-2-3-9\" data-name=\"beef steak dish card\">\n<img alt=\"Beef Steak — photo by Maor Attias on Pexels\" class=\"w-[124px] h-[124px] rounded-full object-cover shrink-0 ring-4 ring-[#F7F7EC]\" data-kid=\"1-2-3-9-1\" data-name=\"beef steak round photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/5192423/pexels-photo-5192423.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div class=\"flex-1 h-full min-w-0 flex flex-col py-2\" data-kid=\"1-2-3-9-2\" data-name=\"dish info column\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323] line-clamp-2\" data-kid=\"1-2-3-9-2-1\" data-name=\"beef steak dish name\">Beef Steak</h3>\n<span class=\"mt-1 text-[12px] text-[#898989]\" data-kid=\"1-2-3-9-2-2\" data-name=\"beef steak portion weight\">280 g</span>\n<span class=\"flex-1\" data-kid=\"1-2-3-9-2-3\" data-name=\"flex spacer between weight and price\"></span>\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-9-2-4\" data-name=\"beef steak price\">$27.50</span>\n</div>\n</article>\n<!-- Chocolate Lava Cake -->\n<article class=\"relative h-[244px] bg-white rounded-xl border border-[#ECECE2] p-4 flex items-center gap-4 shadow-[0_1px_2px_rgba(35,35,35,0.06)]\" data-kid=\"1-2-3-10\" data-name=\"chocolate lava cake dish card\">\n<img alt=\"Chocolate Lava Cake — photo by Marina Utrabo on Pexels\" class=\"w-[124px] h-[124px] rounded-full object-cover shrink-0 ring-4 ring-[#F7F7EC]\" data-kid=\"1-2-3-10-1\" data-name=\"chocolate lava cake round photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/4662046/pexels-photo-4662046.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div class=\"flex-1 h-full min-w-0 flex flex-col py-2\" data-kid=\"1-2-3-10-2\" data-name=\"dish info column\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323] line-clamp-2\" data-kid=\"1-2-3-10-2-1\" data-name=\"chocolate lava cake dish name\">Chocolate Lava Cake</h3>\n<span class=\"mt-1 text-[12px] text-[#898989]\" data-kid=\"1-2-3-10-2-2\" data-name=\"chocolate lava cake portion weight\">160 g</span>\n<span class=\"flex-1\" data-kid=\"1-2-3-10-2-3\" data-name=\"flex spacer between weight and price\"></span>\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-10-2-4\" data-name=\"chocolate lava cake price\">$8.50</span>\n</div>\n</article>\n<!-- Tiramisu -->\n<article class=\"relative h-[244px] bg-white rounded-xl border border-[#ECECE2] p-4 flex items-center gap-4 shadow-[0_1px_2px_rgba(35,35,35,0.06)]\" data-kid=\"1-2-3-11\" data-name=\"tiramisu dish card\">\n<img alt=\"Tiramisu — photo by Valeria Boltneva on Pexels\" class=\"w-[124px] h-[124px] rounded-full object-cover shrink-0 ring-4 ring-[#F7F7EC]\" data-kid=\"1-2-3-11-1\" data-name=\"tiramisu round photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/34759482/pexels-photo-34759482.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div class=\"flex-1 h-full min-w-0 flex flex-col py-2\" data-kid=\"1-2-3-11-2\" data-name=\"dish info column\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323] line-clamp-2\" data-kid=\"1-2-3-11-2-1\" data-name=\"tiramisu dish name\">Tiramisu</h3>\n<span class=\"mt-1 text-[12px] text-[#898989]\" data-kid=\"1-2-3-11-2-2\" data-name=\"tiramisu portion weight\">180 g</span>\n<span class=\"flex-1\" data-kid=\"1-2-3-11-2-3\" data-name=\"flex spacer between weight and price\"></span>\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-11-2-4\" data-name=\"tiramisu price\">$9.00</span>\n</div>\n</article>\n<!-- Panna Cotta — On Stop -->\n<article aria-disabled=\"true\" class=\"relative h-[244px] bg-white rounded-xl border border-[#ECECE2] p-4 flex items-center gap-4 shadow-[0_1px_2px_rgba(35,35,35,0.06)] cursor-not-allowed select-none\" data-kid=\"1-2-3-12\" data-name=\"panna cotta disabled dish card\">\n<span class=\"absolute top-3 right-3 bg-[#FCE9ED] text-[#B70B0B] text-[11px] leading-4 font-medium px-2 py-[2px] rounded-full\" data-kid=\"1-2-3-12-1\" data-name=\"on stop badge\">On Stop</span>\n<div class=\"flex items-center gap-4 opacity-40\" data-kid=\"1-2-3-12-2\" data-name=\"dimmed disabled dish content\">\n<img alt=\"Panna Cotta — photo by Mattia Marcassoli on Pexels\" class=\"w-[124px] h-[124px] rounded-full object-cover shrink-0 ring-4 ring-[#F7F7EC]\" data-kid=\"1-2-3-12-2-1\" data-name=\"panna cotta round photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/3301907/pexels-photo-3301907.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div class=\"flex-1 min-w-0 flex flex-col py-2\" data-kid=\"1-2-3-12-2-2\" data-name=\"dish info column\">\n<h3 class=\"text-[14px] leading-5 font-medium text-[#232323] line-clamp-2\" data-kid=\"1-2-3-12-2-2-1\" data-name=\"panna cotta dish name\">Panna Cotta</h3>\n<span class=\"mt-1 text-[12px] text-[#898989]\" data-kid=\"1-2-3-12-2-2-2\" data-name=\"panna cotta portion weight\">150 g</span>\n<span class=\"h-[52px]\" data-kid=\"1-2-3-12-2-2-3\" data-name=\"flex spacer between weight and price\"></span>\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-12-2-2-4\" data-name=\"panna cotta price\">$8.00</span>\n</div>\n</div>\n</article>\n</div>\n</main>\n</div>",
