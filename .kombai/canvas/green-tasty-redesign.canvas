      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#F7F7EC] text-[#232323]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Poppins',sans-serif;\">\n<!-- Header -->\n<header class=\"flex h-20 items-center gap-10 bg-white px-10\" data-kid=\"1-1\" data-name=\"header navigation bar\">\n<img alt=\"Green &amp; Tasty\" class=\"h-[38px] w-auto\" data-kid=\"1-1-1\" data-name=\"restaurant logo image\" decoding=\"async\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/logo_vegeterian.svg\"/>\n<nav class=\"flex h-20 items-center gap-8 text-[15px]\" data-kid=\"1-1-2\" data-name=\"main navigation links\">\n<a class=\"flex h-20 items-center border-b-2 border-transparent font-normal text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-1\" data-name=\"home page nav link\" href=\"#\">Main page</a>\n<a class=\"flex h-20 items-center border-b-2 border-[#0F7A37] font-medium text-[#0F7A37]\" data-kid=\"1-1-2-2\" data-name=\"active menu nav link\" href=\"#\">Menu</a>\n<a class=\"flex h-20 items-center border-b-2 border-transparent font-normal text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-3\" data-name=\"book a table nav link\" href=\"#\">Book a Table</a>\n<a class=\"flex h-20 items-center border-b-2 border-transparent font-normal text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-4\" data-name=\"reservations nav link\" href=\"#\">Reservations</a>\n</nav>\n<button class=\"ml-auto flex h-10 items-center rounded-lg border-[1.5px] border-[#0F7A37] bg-white px-4 text-sm font-semibold text-[#0F7A37] hover:bg-[#e9ffea]\" data-kid=\"1-1-3\" data-name=\"sign in button\" type=\"button\">Sign In</button>\n</header>\n<main class=\"px-10 pb-16 pt-6\" data-kid=\"1-2\" data-name=\"main content area\">\n<!-- Title -->\n<h1 class=\"text-[40px] font-medium leading-[48px] text-[#232323]\" data-kid=\"1-2-1\" data-name=\"menu page heading\">Menu</h1>\n<!-- Filter toolbar -->\n<div class=\"mt-4 flex h-16 items-center justify-between\" data-kid=\"1-2-2\" data-name=\"filter toolbar bar\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1\" data-name=\"menu category filter buttons group\">\n<button class=\"flex h-10 items-center rounded-lg bg-[#0F7A37] px-4 text-sm font-medium text-white\" data-kid=\"1-2-2-1-1\" data-name=\"all categories active filter button\" type=\"button\">All</button>\n<button class=\"flex h-10 items-center rounded-lg border border-[#dadada] bg-white px-4 text-sm font-medium text-[#575757] hover:border-[#0F7A37] hover:text-[#0F7A37]\" data-kid=\"1-2-2-1-2\" data-name=\"appetizers filter button\" type=\"button\">Appetizers</button>\n<button class=\"flex h-10 items-center rounded-lg border border-[#dadada] bg-white px-4 text-sm font-medium text-[#575757] hover:border-[#0F7A37] hover:text-[#0F7A37]\" data-kid=\"1-2-2-1-3\" data-name=\"main courses filter button\" type=\"button\">Main Courses</button>\n<button class=\"flex h-10 items-center rounded-lg border border-[#dadada] bg-white px-4 text-sm font-medium text-[#575757] hover:border-[#0F7A37] hover:text-[#0F7A37]\" data-kid=\"1-2-2-1-4\" data-name=\"desserts filter button\" type=\"button\">Desserts</button>\n</div>\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-2-2\" data-name=\"sort control group\">\n<span class=\"text-sm text-[#575757]\" data-kid=\"1-2-2-2-1\" data-name=\"sort by label text\">Sort by:</span>\n<button class=\"flex h-12 w-[248px] items-center justify-between rounded-lg border border-[#dadada] bg-white px-4 text-sm font-medium text-[#232323]\" data-kid=\"1-2-2-2-2\" data-name=\"sort dropdown trigger button\" type=\"button\">\n          Popularity Descending\n          <i class=\"ti ti-chevron-down text-base text-[#575757]\" data-kid=\"1-2-2-2-2-1\" data-name=\"dropdown chevron icon\"></i>\n</button>\n</div>\n</div>\n<!-- Dish grid -->\n<div class=\"mt-2 grid grid-cols-5 gap-x-4 gap-y-6\" data-kid=\"1-2-3\" data-name=\"dish grid container\">\n<button class=\"flex flex-col items-center rounded-3xl bg-white px-4 pb-4 pt-5 text-center shadow-[0_1px_2px_rgba(35,35,35,0.05),0_12px_28px_-16px_rgba(35,35,35,0.18)] hover:shadow-[0_2px_4px_rgba(35,35,35,0.06),0_16px_32px_-16px_rgba(35,35,35,0.24)]\" data-kid=\"1-2-3-1\" data-name=\"dish card for Grilled Salmon\" type=\"button\">\n<img alt=\"Grilled Salmon — photo by Jordan Rushton on Pexels\" class=\"h-32 w-32 rounded-full object-cover\" data-kid=\"1-2-3-1-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12318013/pexels-photo-12318013.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 line-clamp-2 min-h-10 text-[15px] font-medium leading-5 text-[#232323]\" data-kid=\"1-2-3-1-2\" data-name=\"dish name title\">Grilled Salmon</h3>\n<div class=\"mt-1 flex items-baseline justify-center gap-2\" data-kid=\"1-2-3-1-3\" data-name=\"dish price and weight row\">\n<span class=\"text-[15px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-1-3-1\" data-name=\"dish price text\">$18.99</span>\n<span class=\"text-xs text-[#898989]\" data-kid=\"1-2-3-1-3-2\" data-name=\"dish weight text\">320 g</span>\n</div>\n</button>\n<button class=\"flex flex-col items-center rounded-3xl bg-white px-4 pb-4 pt-5 text-center shadow-[0_1px_2px_rgba(35,35,35,0.05),0_12px_28px_-16px_rgba(35,35,35,0.18)] hover:shadow-[0_2px_4px_rgba(35,35,35,0.06),0_16px_32px_-16px_rgba(35,35,35,0.24)]\" data-kid=\"1-2-3-2\" data-name=\"dish card for Margherita Pizza\" type=\"button\">\n<img alt=\"Margherita Pizza — photo by KI Lee on Pexels\" class=\"h-32 w-32 rounded-full object-cover\" data-kid=\"1-2-3-2-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/31136887/pexels-photo-31136887.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 line-clamp-2 min-h-10 text-[15px] font-medium leading-5 text-[#232323]\" data-kid=\"1-2-3-2-2\" data-name=\"dish name title\">Margherita Pizza</h3>\n<div class=\"mt-1 flex items-baseline justify-center gap-2\" data-kid=\"1-2-3-2-3\" data-name=\"dish price and weight row\">\n<span class=\"text-[15px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-2-3-1\" data-name=\"dish price text\">$14.99</span>\n<span class=\"text-xs text-[#898989]\" data-kid=\"1-2-3-2-3-2\" data-name=\"dish weight text\">450 g</span>\n</div>\n</button>\n<button class=\"flex flex-col items-center rounded-3xl bg-white px-4 pb-4 pt-5 text-center shadow-[0_1px_2px_rgba(35,35,35,0.05),0_12px_28px_-16px_rgba(35,35,35,0.18)] hover:shadow-[0_2px_4px_rgba(35,35,35,0.06),0_16px_32px_-16px_rgba(35,35,35,0.24)]\" data-kid=\"1-2-3-3\" data-name=\"dish card for Truffle Mushroom Risotto\" type=\"button\">\n<img alt=\"Truffle Mushroom Risotto — photo by Nadin Sh on Pexels\" class=\"h-32 w-32 rounded-full object-cover\" data-kid=\"1-2-3-3-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/27298481/pexels-photo-27298481.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 line-clamp-2 min-h-10 text-[15px] font-medium leading-5 text-[#232323]\" data-kid=\"1-2-3-3-2\" data-name=\"dish name title\">Truffle Mushroom Risotto</h3>\n<div class=\"mt-1 flex items-baseline justify-center gap-2\" data-kid=\"1-2-3-3-3\" data-name=\"dish price and weight row\">\n<span class=\"text-[15px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-3-3-1\" data-name=\"dish price text\">$22.50</span>\n<span class=\"text-xs text-[#898989]\" data-kid=\"1-2-3-3-3-2\" data-name=\"dish weight text\">350 g</span>\n</div>\n</button>\n<button class=\"flex flex-col items-center rounded-3xl bg-white px-4 pb-4 pt-5 text-center shadow-[0_1px_2px_rgba(35,35,35,0.05),0_12px_28px_-16px_rgba(35,35,35,0.18)] hover:shadow-[0_2px_4px_rgba(35,35,35,0.06),0_16px_32px_-16px_rgba(35,35,35,0.24)]\" data-kid=\"1-2-3-4\" data-name=\"dish card for Khachapuri Adjarian\" type=\"button\">\n<img alt=\"Khachapuri Adjarian — photo by Valeria Boltneva on Pexels\" class=\"h-32 w-32 rounded-full object-cover\" data-kid=\"1-2-3-4-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/18330968/pexels-photo-18330968.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 line-clamp-2 min-h-10 text-[15px] font-medium leading-5 text-[#232323]\" data-kid=\"1-2-3-4-2\" data-name=\"dish name title\">Khachapuri Adjarian</h3>\n<div class=\"mt-1 flex items-baseline justify-center gap-2\" data-kid=\"1-2-3-4-3\" data-name=\"dish price and weight row\">\n<span class=\"text-[15px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-4-3-1\" data-name=\"dish price text\">$16.50</span>\n<span class=\"text-xs text-[#898989]\" data-kid=\"1-2-3-4-3-2\" data-name=\"dish weight text\">380 g</span>\n</div>\n</button>\n<button class=\"flex flex-col items-center rounded-3xl bg-white px-4 pb-4 pt-5 text-center shadow-[0_1px_2px_rgba(35,35,35,0.05),0_12px_28px_-16px_rgba(35,35,35,0.18)] hover:shadow-[0_2px_4px_rgba(35,35,35,0.06),0_16px_32px_-16px_rgba(35,35,35,0.24)]\" data-kid=\"1-2-3-5\" data-name=\"dish card for Green Salad\" type=\"button\">\n<img alt=\"Green Salad — photo by Anthony Rahayel on Pexels\" class=\"h-32 w-32 rounded-full object-cover\" data-kid=\"1-2-3-5-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/30350305/pexels-photo-30350305.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 line-clamp-2 min-h-10 text-[15px] font-medium leading-5 text-[#232323]\" data-kid=\"1-2-3-5-2\" data-name=\"dish name title\">Green Salad</h3>\n<div class=\"mt-1 flex items-baseline justify-center gap-2\" data-kid=\"1-2-3-5-3\" data-name=\"dish price and weight row\">\n<span class=\"text-[15px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-5-3-1\" data-name=\"dish price text\">$9.99</span>\n<span class=\"text-xs text-[#898989]\" data-kid=\"1-2-3-5-3-2\" data-name=\"dish weight text\">220 g</span>\n</div>\n</button>\n<button class=\"flex flex-col items-center rounded-3xl bg-white px-4 pb-4 pt-5 text-center shadow-[0_1px_2px_rgba(35,35,35,0.05),0_12px_28px_-16px_rgba(35,35,35,0.18)] hover:shadow-[0_2px_4px_rgba(35,35,35,0.06),0_16px_32px_-16px_rgba(35,35,35,0.24)]\" data-kid=\"1-2-3-6\" data-name=\"dish card for Lamb Shashlik\" type=\"button\">\n<img alt=\"Lamb Shashlik — photo by Mavi Yildiz Restoran on Pexels\" class=\"h-32 w-32 rounded-full object-cover\" data-kid=\"1-2-3-6-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/37206693/pexels-photo-37206693.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 line-clamp-2 min-h-10 text-[15px] font-medium leading-5 text-[#232323]\" data-kid=\"1-2-3-6-2\" data-name=\"dish name title\">Lamb Shashlik</h3>\n<div class=\"mt-1 flex items-baseline justify-center gap-2\" data-kid=\"1-2-3-6-3\" data-name=\"dish price and weight row\">\n<span class=\"text-[15px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-6-3-1\" data-name=\"dish price text\">$21.00</span>\n<span class=\"text-xs text-[#898989]\" data-kid=\"1-2-3-6-3-2\" data-name=\"dish weight text\">300 g</span>\n</div>\n</button>\n<button class=\"flex flex-col items-center rounded-3xl bg-white px-4 pb-4 pt-5 text-center shadow-[0_1px_2px_rgba(35,35,35,0.05),0_12px_28px_-16px_rgba(35,35,35,0.18)] hover:shadow-[0_2px_4px_rgba(35,35,35,0.06),0_16px_32px_-16px_rgba(35,35,35,0.24)]\" data-kid=\"1-2-3-7\" data-name=\"dish card for Fresh Avocado Toast\" type=\"button\">\n<img alt=\"Fresh Avocado Toast — photo by Akshata Bablad on Pexels\" class=\"h-32 w-32 rounded-full object-cover\" data-kid=\"1-2-3-7-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14665824/pexels-photo-14665824.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 line-clamp-2 min-h-10 text-[15px] font-medium leading-5 text-[#232323]\" data-kid=\"1-2-3-7-2\" data-name=\"dish name title\">Fresh Avocado Toast</h3>\n<div class=\"mt-1 flex items-baseline justify-center gap-2\" data-kid=\"1-2-3-7-3\" data-name=\"dish price and weight row\">\n<span class=\"text-[15px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-7-3-1\" data-name=\"dish price text\">$12.00</span>\n<span class=\"text-xs text-[#898989]\" data-kid=\"1-2-3-7-3-2\" data-name=\"dish weight text\">200 g</span>\n</div>\n</button>\n<button class=\"flex flex-col items-center rounded-3xl bg-white px-4 pb-4 pt-5 text-center shadow-[0_1px_2px_rgba(35,35,35,0.05),0_12px_28px_-16px_rgba(35,35,35,0.18)] hover:shadow-[0_2px_4px_rgba(35,35,35,0.06),0_16px_32px_-16px_rgba(35,35,35,0.24)]\" data-kid=\"1-2-3-8\" data-name=\"dish card for Chocolate Lava Cake\" type=\"button\">\n<img alt=\"Chocolate Lava Cake — photo by Valeria Boltneva on Pexels\" class=\"h-32 w-32 rounded-full object-cover\" data-kid=\"1-2-3-8-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/18580160/pexels-photo-18580160.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 line-clamp-2 min-h-10 text-[15px] font-medium leading-5 text-[#232323]\" data-kid=\"1-2-3-8-2\" data-name=\"dish name title\">Chocolate Lava Cake</h3>\n<div class=\"mt-1 flex items-baseline justify-center gap-2\" data-kid=\"1-2-3-8-3\" data-name=\"dish price and weight row\">\n<span class=\"text-[15px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-8-3-1\" data-name=\"dish price text\">$8.50</span>\n<span class=\"text-xs text-[#898989]\" data-kid=\"1-2-3-8-3-2\" data-name=\"dish weight text\">160 g</span>\n</div>\n</button>\n<button class=\"flex flex-col items-center rounded-3xl bg-white px-4 pb-4 pt-5 text-center shadow-[0_1px_2px_rgba(35,35,35,0.05),0_12px_28px_-16px_rgba(35,35,35,0.18)] hover:shadow-[0_2px_4px_rgba(35,35,35,0.06),0_16px_32px_-16px_rgba(35,35,35,0.24)]\" data-kid=\"1-2-3-9\" data-name=\"dish card for Tomato Soup\" type=\"button\">\n<img alt=\"Tomato Soup — photo by Farhad Ibrahimzade on Unsplash\" class=\"h-32 w-32 rounded-full object-cover\" data-kid=\"1-2-3-9-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1626200419537-f07108a01aac?auto=format&amp;w=400&amp;q=80&amp;fit=crop\"/>\n<h3 class=\"mt-3 line-clamp-2 min-h-10 text-[15px] font-medium leading-5 text-[#232323]\" data-kid=\"1-2-3-9-2\" data-name=\"dish name title\">Tomato Soup</h3>\n<div class=\"mt-1 flex items-baseline justify-center gap-2\" data-kid=\"1-2-3-9-3\" data-name=\"dish price and weight row\">\n<span class=\"text-[15px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-9-3-1\" data-name=\"dish price text\">$7.50</span>\n<span class=\"text-xs text-[#898989]\" data-kid=\"1-2-3-9-3-2\" data-name=\"dish weight text\">250 g</span>\n</div>\n</button>\n<button class=\"flex flex-col items-center rounded-3xl bg-white px-4 pb-4 pt-5 text-center shadow-[0_1px_2px_rgba(35,35,35,0.05),0_12px_28px_-16px_rgba(35,35,35,0.18)] hover:shadow-[0_2px_4px_rgba(35,35,35,0.06),0_16px_32px_-16px_rgba(35,35,35,0.24)]\" data-kid=\"1-2-3-10\" data-name=\"dish card for Beef Steak\" type=\"button\">\n<img alt=\"Beef Steak — photo by Mohamed Olwy on Pexels\" class=\"h-32 w-32 rounded-full object-cover\" data-kid=\"1-2-3-10-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/36691316/pexels-photo-36691316.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 line-clamp-2 min-h-10 text-[15px] font-medium leading-5 text-[#232323]\" data-kid=\"1-2-3-10-2\" data-name=\"dish name title\">Beef Steak</h3>\n<div class=\"mt-1 flex items-baseline justify-center gap-2\" data-kid=\"1-2-3-10-3\" data-name=\"dish price and weight row\">\n<span class=\"text-[15px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-10-3-1\" data-name=\"dish price text\">$27.50</span>\n<span class=\"text-xs text-[#898989]\" data-kid=\"1-2-3-10-3-2\" data-name=\"dish weight text\">280 g</span>\n</div>\n</button>\n<button class=\"flex flex-col items-center rounded-3xl bg-white px-4 pb-4 pt-5 text-center shadow-[0_1px_2px_rgba(35,35,35,0.05),0_12px_28px_-16px_rgba(35,35,35,0.18)] hover:shadow-[0_2px_4px_rgba(35,35,35,0.06),0_16px_32px_-16px_rgba(35,35,35,0.24)]\" data-kid=\"1-2-3-11\" data-name=\"dish card for Tiramisu\" type=\"button\">\n<img alt=\"Tiramisu — photo by Valeria Boltneva on Pexels\" class=\"h-32 w-32 rounded-full object-cover\" data-kid=\"1-2-3-11-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/34759482/pexels-photo-34759482.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 line-clamp-2 min-h-10 text-[15px] font-medium leading-5 text-[#232323]\" data-kid=\"1-2-3-11-2\" data-name=\"dish name title\">Tiramisu</h3>\n<div class=\"mt-1 flex items-baseline justify-center gap-2\" data-kid=\"1-2-3-11-3\" data-name=\"dish price and weight row\">\n<span class=\"text-[15px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-11-3-1\" data-name=\"dish price text\">$9.00</span>\n<span class=\"text-xs text-[#898989]\" data-kid=\"1-2-3-11-3-2\" data-name=\"dish weight text\">180 g</span>\n</div>\n</button>\n<div class=\"relative flex cursor-not-allowed flex-col items-center rounded-3xl bg-white px-4 pb-4 pt-5 text-center shadow-[0_1px_2px_rgba(35,35,35,0.05),0_12px_28px_-16px_rgba(35,35,35,0.18)]\" data-kid=\"1-2-3-12\" data-name=\"unavailable dish card (on stop)\">\n<span class=\"absolute right-3 top-3 rounded-full bg-[#FCE9ED] px-2.5 py-1 text-[11px] font-semibold leading-4 text-[#B70B0B]\" data-kid=\"1-2-3-12-1\" data-name=\"on stop status badge\">On Stop</span>\n<div class=\"flex flex-col items-center opacity-40\" data-kid=\"1-2-3-12-2\" data-name=\"dimmed dish content wrapper\">\n<img alt=\"Panna Cotta — photo by Mattia Marcassoli on Pexels\" class=\"h-32 w-32 rounded-full object-cover\" data-kid=\"1-2-3-12-2-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/3301907/pexels-photo-3301907.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 line-clamp-2 min-h-10 text-[15px] font-medium leading-5 text-[#232323]\" data-kid=\"1-2-3-12-2-2\" data-name=\"dish name title\">Panna Cotta</h3>\n<div class=\"mt-1 flex items-baseline justify-center gap-2\" data-kid=\"1-2-3-12-2-3\" data-name=\"dish price and weight row\">\n<span class=\"text-[15px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-12-2-3-1\" data-name=\"dish price text\">$8.00</span>\n<span class=\"text-xs text-[#898989]\" data-kid=\"1-2-3-12-2-3-2\" data-name=\"dish weight text\">150 g</span>\n</div>\n</div>\n</div>\n</div>\n</main>\n</div>",
