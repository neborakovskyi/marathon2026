    "var_08a5b77e24d6": {
      "type": "variant",
      "label": "V1 Food-first · Location details",
      "parentId": "",
      "themeId": null,
      "rect": {
        "x": 6900,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"w-full min-h-screen bg-[#F7F7EC] font-['Poppins',_sans-serif] text-[#232323]\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- Header -->\n<header class=\"h-20 bg-white flex items-center px-10\" data-kid=\"1-1\" data-name=\"site header bar\">\n<a class=\"flex items-center shrink-0\" data-kid=\"1-1-1\" data-name=\"restaurant logo link\" href=\"#\">\n<img alt=\"Green &amp; Tasty\" class=\"h-9 w-auto\" data-kid=\"1-1-1-1\" data-name=\"restaurant logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/logo_vegeterian.svg\"/>\n</a>\n<nav class=\"ml-12 flex items-center gap-9 text-[15px] font-medium\" data-kid=\"1-1-2\" data-name=\"main navigation menu\">\n<a class=\"text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-1\" data-name=\"main page navigation link\" href=\"#\">Main page</a>\n<a class=\"text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-2\" data-name=\"menu navigation link\" href=\"#\">Menu</a>\n<a class=\"text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-3\" data-name=\"book a table navigation link\" href=\"#\">Book a Table</a>\n<a class=\"text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-4\" data-name=\"reservations navigation link\" href=\"#\">Reservations</a>\n</nav>\n<div class=\"ml-auto\" data-kid=\"1-1-3\" data-name=\"header right-side action wrapper\">\n<button class=\"h-10 px-5 rounded-lg border-[1.5px] border-[#0F7A37] bg-white text-[#0F7A37] text-[15px] font-semibold\" data-kid=\"1-1-3-1\" data-name=\"sign in button\">Sign In</button>\n</div>\n</header>\n<!-- Venue composition -->\n<section class=\"px-10 pt-6\" data-kid=\"1-2\" data-name=\"venue hero section\">\n<div class=\"flex gap-6\" data-kid=\"1-2-1\" data-name=\"venue card layout container\">\n<img alt=\"Dining room and terrace at 48 Rustaveli Avenue\" class=\"w-[768px] h-[360px] shrink-0 rounded-[24px] object-cover\" data-kid=\"1-2-1-1\" data-name=\"dining room and terrace photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/locations/rustaveli-avenue-48.jpg\"/>\n<div class=\"w-[408px] h-[360px] bg-white rounded-[24px] p-6 flex flex-col shadow-[0_0_10px_4px_rgba(194,194,194,0.22)]\" data-kid=\"1-2-1-2\" data-name=\"venue details card\">\n<h1 class=\"text-[26px] leading-9 font-medium\" data-kid=\"1-2-1-2-1\" data-name=\"venue name headline\">48 Rustaveli Avenue</h1>\n<div class=\"mt-2 flex items-center gap-2\" data-kid=\"1-2-1-2-2\" data-name=\"venue rating row\">\n<img alt=\"\" class=\"w-[18px] h-[18px]\" data-kid=\"1-2-1-2-2-1\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<span class=\"text-[14px] font-semibold\" data-kid=\"1-2-1-2-2-2\" data-name=\"rating score text\">4.5 / 5</span>\n</div>\n<p class=\"mt-4 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-2-1-2-3\" data-name=\"venue description text\">Located on the city's bustling main cultural artery, this grand establishment features classic high ceilings and a wide outdoor terrace perfect for people-watching.</p>\n<div class=\"mt-auto flex gap-3\" data-kid=\"1-2-1-2-4\" data-name=\"venue action buttons row\">\n<button class=\"h-12 flex-1 rounded-lg bg-[linear-gradient(120deg,#0B5B29,#0F7A37_80%)] text-white text-[15px] font-semibold\" data-kid=\"1-2-1-2-4-1\" data-name=\"book a table primary button\">Book a Table</button>\n<button class=\"h-12 flex-1 rounded-lg bg-white border-[1.5px] border-[#0F7A37] text-[#0F7A37] text-[15px] font-semibold\" data-kid=\"1-2-1-2-4-2\" data-name=\"view menu outline button\">View menu</button>\n</div>\n</div>\n</div>\n</section>\n<!-- Customer Reviews -->\n<section class=\"mt-14 bg-white px-10 py-14\" data-kid=\"1-3\" data-name=\"customer reviews section\">\n<div class=\"h-10 flex items-end\" data-kid=\"1-3-1\" data-name=\"section heading wrapper\">\n<h2 class=\"text-[32px] leading-10 font-medium\" data-kid=\"1-3-1-1\" data-name=\"customer reviews section headline\">Customer Reviews</h2>\n</div>\n<div class=\"mt-5 flex items-center justify-between\" data-kid=\"1-3-2\" data-name=\"reviews filter/sort toolbar\">\n<div class=\"flex items-center gap-8 text-[15px]\" data-kid=\"1-3-2-1\" data-name=\"review category tabs\">\n<a class=\"relative font-semibold text-[#0F7A37] after:absolute after:left-0 after:right-0 after:-bottom-2 after:h-[2px] after:bg-[#0F7A37]\" data-kid=\"1-3-2-1-1\" data-name=\"active service category tab\" href=\"#\">Service</a>\n<a class=\"font-medium text-[#575757] hover:text-[#0F7A37]\" data-kid=\"1-3-2-1-2\" data-name=\"cuisine experience category tab\" href=\"#\">Cuisine experience</a>\n</div>\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-2-2\" data-name=\"sort control group\">\n<span class=\"text-[13px] text-[#575757]\" data-kid=\"1-3-2-2-1\" data-name=\"sort by label text\">Sort by:</span>\n<button class=\"h-12 w-[220px] px-4 rounded-lg border border-[#DADADA] bg-white flex items-center justify-between text-[14px] font-medium\" data-kid=\"1-3-2-2-2\" data-name=\"sort order dropdown button\">\nTop rated first\n<i class=\"ti ti-chevron-down text-[16px] text-[#575757]\" data-kid=\"1-3-2-2-2-1\" data-name=\"dropdown chevron icon\"></i>\n</button>\n</div>\n</div>\n<div class=\"mt-6 grid grid-cols-3 gap-6\" data-kid=\"1-3-3\" data-name=\"reviews card grid\">\n<article class=\"bg-white rounded-[24px] border border-[#E8E8E3] p-5 shadow-[0_0_10px_4px_rgba(194,194,194,0.18)] flex flex-col\" data-kid=\"1-3-3-1\" data-name=\"review card\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-3-1-1\" data-name=\"reviewer identity row\">\n<img alt=\"Nino Beridze\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"1-3-3-1-1-1\" data-name=\"reviewer avatar photo\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?u=nino-beridze\"/>\n<div data-kid=\"1-3-3-1-1-2\" data-name=\"reviewer name and date wrapper\">\n<p class=\"text-[14px] leading-5 font-medium\" data-kid=\"1-3-3-1-1-2-1\" data-name=\"reviewer name text\">Nino Beridze</p>\n<p class=\"text-[12px] text-[#898989]\" data-kid=\"1-3-3-1-1-2-2\" data-name=\"review date text\">Sep 12, 2026</p>\n</div>\n</div>\n<div class=\"mt-3 flex items-center gap-1 text-[16px]\" data-kid=\"1-3-3-1-2\" data-name=\"review star rating row\">\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-1-2-1\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-1-2-2\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-1-2-3\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-1-2-4\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-1-2-5\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n</div>\n<p class=\"mt-3 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-3-3-1-3\" data-name=\"review body text\">The host seated us within five minutes of arriving and our waiter took the pre-order link through step by step. Water and bread were on the table before we finished reading the menu.</p>\n</article>\n<article class=\"bg-white rounded-[24px] border border-[#E8E8E3] p-5 shadow-[0_0_10px_4px_rgba(194,194,194,0.18)] flex flex-col\" data-kid=\"1-3-3-2\" data-name=\"review card\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-3-2-1\" data-name=\"reviewer identity row\">\n<img alt=\"Giorgi Kapanadze\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"1-3-3-2-1-1\" data-name=\"reviewer avatar photo\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?u=giorgi-kapanadze\"/>\n<div data-kid=\"1-3-3-2-1-2\" data-name=\"reviewer name and date wrapper\">\n<p class=\"text-[14px] leading-5 font-medium\" data-kid=\"1-3-3-2-1-2-1\" data-name=\"reviewer name text\">Giorgi Kapanadze</p>\n<p class=\"text-[12px] text-[#898989]\" data-kid=\"1-3-3-2-1-2-2\" data-name=\"review date text\">Aug 30, 2026</p>\n</div>\n</div>\n<div class=\"mt-3 flex items-center gap-1 text-[16px]\" data-kid=\"1-3-3-2-2\" data-name=\"review star rating row\">\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-2-2-1\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-2-2-2\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-2-2-3\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-2-2-4\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4 opacity-30\" data-kid=\"1-3-3-2-2-5\" data-name=\"empty star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n</div>\n<p class=\"mt-3 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-3-3-2-3\" data-name=\"review body text\">Attentive service through lunch. The second course arrived twenty minutes after the first, and the waiter apologised and removed it from the bill without being asked.</p>\n</article>\n<article class=\"bg-white rounded-[24px] border border-[#E8E8E3] p-5 shadow-[0_0_10px_4px_rgba(194,194,194,0.18)] flex flex-col\" data-kid=\"1-3-3-3\" data-name=\"review card\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-3-3-1\" data-name=\"reviewer identity row\">\n<img alt=\"Tamar Gelashvili\" class=\"w-12 h-12 rounded-full object-cover\" data-kid=\"1-3-3-3-1-1\" data-name=\"reviewer avatar photo\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/96?u=tamar-gelashvili\"/>\n<div data-kid=\"1-3-3-3-1-2\" data-name=\"reviewer name and date wrapper\">\n<p class=\"text-[14px] leading-5 font-medium\" data-kid=\"1-3-3-3-1-2-1\" data-name=\"reviewer name text\">Tamar Gelashvili</p>\n<p class=\"text-[12px] text-[#898989]\" data-kid=\"1-3-3-3-1-2-2\" data-name=\"review date text\">Aug 14, 2026</p>\n</div>\n</div>\n<div class=\"mt-3 flex items-center gap-1 text-[16px]\" data-kid=\"1-3-3-3-2\" data-name=\"review star rating row\">\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-3-2-1\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-3-2-2\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-3-2-3\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-3-2-4\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n<img alt=\"\" class=\"w-4 h-4\" data-kid=\"1-3-3-3-2-5\" data-name=\"star rating icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/star-mini.svg\"/>\n</div>\n<p class=\"mt-3 text-[14px] leading-6 text-[#575757] line-clamp-5\" data-kid=\"1-3-3-3-3\" data-name=\"review body text with clamping\">We booked the terrace for four on a Saturday evening. The table was ready when we arrived, the waiter confirmed our pre-order dishes one by one, and empty plates were cleared between courses without interrupting the conversation. When one guest arrived late the kitchen held their main course.</p>\n<button class=\"mt-2 self-start text-[13px] font-semibold text-[#0F7A37] underline underline-offset-4\" data-kid=\"1-3-3-3-4\" data-name=\"read more expand link\">Read more</button>\n</article>\n</div>\n<div class=\"mt-8 flex items-center justify-center gap-2\" data-kid=\"1-3-4\" data-name=\"review pagination controls\">\n<button aria-label=\"Previous page\" class=\"w-10 h-10 rounded-lg flex items-center justify-center text-[#DADADA]\" data-kid=\"1-3-4-1\" data-name=\"previous page button\">\n<i class=\"ti ti-chevron-left text-[18px]\" data-kid=\"1-3-4-1-1\" data-name=\"left chevron icon\"></i>\n</button>\n<button class=\"w-10 h-10 rounded-lg flex items-center justify-center text-[15px] font-semibold text-[#0F7A37] relative after:absolute after:left-2 after:right-2 after:bottom-1 after:h-[2px] after:bg-[#0F7A37]\" data-kid=\"1-3-4-2\" data-name=\"active page 1 button\">1</button>\n<button class=\"w-10 h-10 rounded-lg flex items-center justify-center text-[15px] font-medium text-[#575757] hover:text-[#0F7A37]\" data-kid=\"1-3-4-3\" data-name=\"page 2 button\">2</button>\n<button class=\"w-10 h-10 rounded-lg flex items-center justify-center text-[15px] font-medium text-[#575757] hover:text-[#0F7A37]\" data-kid=\"1-3-4-4\" data-name=\"page 3 button\">3</button>\n<button aria-label=\"Next page\" class=\"w-10 h-10 rounded-lg flex items-center justify-center text-[#575757] hover:text-[#0F7A37]\" data-kid=\"1-3-4-5\" data-name=\"next page button\">\n<i class=\"ti ti-chevron-right text-[18px]\" data-kid=\"1-3-4-5-1\" data-name=\"right chevron icon\"></i>\n</button>\n</div>\n</section>\n</div>",
