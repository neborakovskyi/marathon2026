      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#F7F7EC] text-[#232323]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Poppins',sans-serif;\">\n<header class=\"h-20 bg-white border-b border-[#ECECE2]\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"max-w-[1200px] mx-auto h-full flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header inner layout container\">\n<a class=\"flex items-center shrink-0\" data-kid=\"1-1-1-1\" data-name=\"restaurant logo link\" href=\"#\">\n<img alt=\"Green &amp; Tasty\" class=\"h-[38px] w-auto\" data-kid=\"1-1-1-1-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/logo_vegeterian.svg\"/>\n</a>\n<nav class=\"h-full flex items-center gap-8\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n<a class=\"h-full flex items-center border-b-2 border-transparent text-[15px] font-medium text-[#575757]\" data-kid=\"1-1-1-2-1\" data-name=\"main page nav link\" href=\"#\">Main page</a>\n<a class=\"h-full flex items-center border-b-2 border-[#0F7A37] text-[15px] font-medium text-[#0F7A37]\" data-kid=\"1-1-1-2-2\" data-name=\"active menu nav link\" href=\"#\">Menu</a>\n<a class=\"h-full flex items-center border-b-2 border-transparent text-[15px] font-medium text-[#575757]\" data-kid=\"1-1-1-2-3\" data-name=\"book a table nav link\" href=\"#\">Book a Table</a>\n<a class=\"h-full flex items-center border-b-2 border-transparent text-[15px] font-medium text-[#575757]\" data-kid=\"1-1-1-2-4\" data-name=\"reservations nav link\" href=\"#\">Reservations</a>\n</nav>\n<button class=\"h-10 px-5 rounded-lg border-[1.4px] border-[#0F7A37] text-[#0F7A37] text-[14px] font-semibold bg-white\" data-kid=\"1-1-1-3\" data-name=\"sign in button\" type=\"button\">Sign In</button>\n</div>\n</header>\n<main class=\"max-w-[1200px] mx-auto pt-6 pb-16\" data-kid=\"1-2\" data-name=\"menu main content container\">\n<h1 class=\"text-[32px] leading-[40px] font-medium\" data-kid=\"1-2-1\" data-name=\"menu page heading\">Menu</h1>\n<div class=\"mt-4 flex items-center justify-between\" data-kid=\"1-2-2\" data-name=\"menu controls toolbar\">\n<div class=\"inline-flex items-center gap-1 bg-white rounded-full border border-[#E4E4D6] p-1\" data-kid=\"1-2-2-1\" data-name=\"category filter segmented control\">\n<button class=\"h-10 px-5 rounded-full text-[14px] font-medium text-white\" data-kid=\"1-2-2-1-1\" data-name=\"All category filter button (active)\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%)\" type=\"button\">All</button>\n<button class=\"h-10 px-5 rounded-full text-[14px] font-medium text-[#575757]\" data-kid=\"1-2-2-1-2\" data-name=\"Appetizers category filter button\" type=\"button\">Appetizers</button>\n<button class=\"h-10 px-5 rounded-full text-[14px] font-medium text-[#575757]\" data-kid=\"1-2-2-1-3\" data-name=\"Main Courses category filter button\" type=\"button\">Main Courses</button>\n<button class=\"h-10 px-5 rounded-full text-[14px] font-medium text-[#575757]\" data-kid=\"1-2-2-1-4\" data-name=\"Desserts category filter button\" type=\"button\">Desserts</button>\n</div>\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-2-2\" data-name=\"sort controls container\">\n<span class=\"text-[14px] text-[#575757]\" data-kid=\"1-2-2-2-1\" data-name=\"sort by label text\">Sort by:</span>\n<button class=\"h-12 w-[248px] px-4 bg-white border border-[#E4E4D6] rounded-xl flex items-center justify-between text-[14px] font-medium text-[#232323]\" data-kid=\"1-2-2-2-2\" data-name=\"sort dropdown button\" type=\"button\">\n<span data-kid=\"1-2-2-2-2-1\" data-name=\"sort option label text\">Popularity Descending</span>\n<i class=\"ti ti-chevron-down text-[18px] text-[#575757]\" data-kid=\"1-2-2-2-2-2\" data-name=\"down chevron dropdown icon\"></i>\n</button>\n</div>\n</div>\n<div class=\"mt-6 grid grid-cols-4 gap-6\" data-kid=\"1-2-3\" data-name=\"menu items grid container\">\n<article class=\"relative bg-white rounded-2xl border border-[#ECECE2] p-4 h-[248px] flex flex-col items-center\" data-kid=\"1-2-3-1\" data-name=\"menu item card\">\n<img alt=\"Green Salad — photo by Asya Vlasova on Pexels\" class=\"w-[132px] h-[132px] rounded-full object-cover ring-4 ring-[#F1F4EC]\" data-kid=\"1-2-3-1-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/4887993/pexels-photo-4887993.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 text-[14px] leading-5 font-medium text-[#232323]\" data-kid=\"1-2-3-1-2\" data-name=\"dish name heading\">Green Salad</h3>\n<div class=\"mt-auto w-full flex items-end justify-between px-1\" data-kid=\"1-2-3-1-3\" data-name=\"price and weight row\">\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-1-3-1\" data-name=\"dish price text\">$9.99</span>\n<span class=\"text-[12px] text-[#898989]\" data-kid=\"1-2-3-1-3-2\" data-name=\"dish weight text\">220g</span>\n</div>\n</article>\n<article class=\"relative bg-white rounded-2xl border border-[#ECECE2] p-4 h-[248px] flex flex-col items-center\" data-kid=\"1-2-3-2\" data-name=\"menu item card\">\n<img alt=\"Fresh Avocado Toast — photo by Karelia Blum on Pexels\" class=\"w-[132px] h-[132px] rounded-full object-cover ring-4 ring-[#F1F4EC]\" data-kid=\"1-2-3-2-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/6609084/pexels-photo-6609084.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 text-[14px] leading-5 font-medium text-[#232323]\" data-kid=\"1-2-3-2-2\" data-name=\"dish name heading\">Fresh Avocado Toast</h3>\n<div class=\"mt-auto w-full flex items-end justify-between px-1\" data-kid=\"1-2-3-2-3\" data-name=\"price and weight row\">\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-2-3-1\" data-name=\"dish price text\">$12.00</span>\n<span class=\"text-[12px] text-[#898989]\" data-kid=\"1-2-3-2-3-2\" data-name=\"dish weight text\">200g</span>\n</div>\n</article>\n<article class=\"relative bg-white rounded-2xl border border-[#ECECE2] p-4 h-[248px] flex flex-col items-center\" data-kid=\"1-2-3-3\" data-name=\"menu item card\">\n<img alt=\"Tomato Soup — photo by Valeria Boltneva on Pexels\" class=\"w-[132px] h-[132px] rounded-full object-cover ring-4 ring-[#F1F4EC]\" data-kid=\"1-2-3-3-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/33469314/pexels-photo-33469314.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 text-[14px] leading-5 font-medium text-[#232323]\" data-kid=\"1-2-3-3-2\" data-name=\"dish name heading\">Tomato Soup</h3>\n<div class=\"mt-auto w-full flex items-end justify-between px-1\" data-kid=\"1-2-3-3-3\" data-name=\"price and weight row\">\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-3-3-1\" data-name=\"dish price text\">$7.50</span>\n<span class=\"text-[12px] text-[#898989]\" data-kid=\"1-2-3-3-3-2\" data-name=\"dish weight text\">250 g</span>\n</div>\n</article>\n<article class=\"relative bg-white rounded-2xl border border-[#ECECE2] p-4 h-[248px] flex flex-col items-center\" data-kid=\"1-2-3-4\" data-name=\"menu item card\">\n<img alt=\"Grilled Salmon — photo by Cristian Mihaila on Pexels\" class=\"w-[132px] h-[132px] rounded-full object-cover ring-4 ring-[#F1F4EC]\" data-kid=\"1-2-3-4-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12431192/pexels-photo-12431192.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 text-[14px] leading-5 font-medium text-[#232323]\" data-kid=\"1-2-3-4-2\" dat