      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#F7F7EC] text-[#232323]\" data-kid=\"1\" data-name=\"restaurant page layout container\" style=\"font-family:'Poppins',sans-serif;\">\n<!-- Header -->\n<header class=\"h-20 bg-white flex items-center gap-10 px-10\" data-kid=\"1-1\" data-name=\"site header bar with logo nav and sign-in\">\n<a aria-label=\"Green &amp; Tasty home\" class=\"shrink-0 flex items-center\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\">\n<img alt=\"Green &amp; Tasty\" class=\"h-[38px] w-auto\" data-kid=\"1-1-1-1\" data-name=\"Green &amp; Tasty logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/logo_vegeterian.svg\"/>\n</a>\n<nav aria-label=\"Main\" class=\"flex items-center gap-8 ml-4 text-[15px] font-medium\" data-kid=\"1-1-2\" data-name=\"main navigation menu\">\n<a aria-current=\"page\" class=\"text-[#0F7A37] border-b-2 border-[#0F7A37] pb-1\" data-kid=\"1-1-2-1\" data-name=\"active nav link - main page\" href=\"#\">Main page</a>\n<a class=\"text-[#232323] hover:text-[#0F7A37] pb-1 border-b-2 border-transparent\" data-kid=\"1-1-2-2\" data-name=\"nav link - menu\" href=\"#\">Menu</a>\n<a class=\"text-[#232323] hover:text-[#0F7A37] pb-1 border-b-2 border-transparent\" data-kid=\"1-1-2-3\" data-name=\"nav link - book a table\" href=\"#\">Book a Table</a>\n<a class=\"text-[#232323] hover:text-[#0F7A37] pb-1 border-b-2 border-transparent\" data-kid=\"1-1-2-4\" data-name=\"nav link - reservations\" href=\"#\">Reservations</a>\n</nav>\n<button class=\"ml-auto h-10 px-5 rounded-lg border-[1.4px] border-[#0F7A37] text-[#0F7A37] text-[14px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-1-3\" data-name=\"sign in outline button\" type=\"button\">Sign In</button>\n</header>\n<!-- Text-led hero -->\n<section class=\"bg-[#F7F7EC] px-10\" data-kid=\"1-2\" data-name=\"hero section for restaurant branding\">\n<div class=\"max-w-[1200px] mx-auto h-[248px] flex flex-col justify-center\" data-kid=\"1-2-1\" data-name=\"hero content container\">\n<h1 class=\"text-[48px] leading-[54px] font-medium max-w-[760px]\" data-kid=\"1-2-1-1\" data-name=\"hero headline tagline\">Green by nature, Georgian by heart.</h1>\n<p class=\"mt-3 text-[14px] font-semibold uppercase tracking-[0.14em] text-[#0B5B29]\" data-kid=\"1-2-1-2\" data-name=\"hero subtitle with location details\">Seasonal bowls • Vegan friendly • Tbilisi</p>\n<div class=\"mt-6 flex items-center gap-4\" data-kid=\"1-2-1-3\" data-name=\"hero call-to-action button row\">\n<button class=\"h-14 px-7 rounded-lg text-white text-[16px] font-semibold\" data-kid=\"1-2-1-3-1\" data-name=\"primary book a table button with gradient\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%)\" type=\"button\">Book a table</button>\n<button class=\"h-14 px-7 rounded-lg bg-white border-[1.4px] border-[#0F7A37] text-[#0F7A37] text-[16px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-2-1-3-2\" data-name=\"secondary view menu outline button\" type=\"button\">View Menu</button>\n</div>\n</div>\n</section>\n<!-- Venue photo strip -->\n<section class=\"bg-white px-10 py-12\" data-kid=\"1-3\" data-name=\"venue photo strip section\">\n<div class=\"max-w-[1200px] mx-auto grid grid-cols-3 gap-6\" data-kid=\"1-3-1\" data-name=\"venue photo grid container\">\n<a class=\"group block\" data-kid=\"1-3-1-1\" data-name=\"link card for Abashidze Street venue\" href=\"#\">\n<img alt=\"Dining room at 9 Abashidze Street\" class=\"w-full h-[152px] object-cover rounded-xl\" data-kid=\"1-3-1-1-1\" data-name=\"dining room venue photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/locations/abashidze-street-9.jpg\"/>\n<span class=\"mt-3 flex items-center gap-1.5 text-[14px] font-semibold text-[#0F7A37] group-hover:text-[#0B5B29]\" data-kid=\"1-3-1-1-2\" data-name=\"venue location link label\">9 Abashidze Street <i class=\"ti ti-arrow-right text-[14px]\" data-kid=\"1-3-1-1-2-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n<a class=\"group block\" data-kid=\"1-3-1-2\" data-name=\"link card for Baratashvili Street venue\" href=\"#\">\n<img alt=\"Dining room at 14 Baratashvili Street\" class=\"w-full h-[152px] object-cover rounded-xl\" data-kid=\"1-3-1-2-1\" data-name=\"dining room venue photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/locations/baratashvili-street-14.jpg\"/>\n<span class=\"mt-3 flex items-center gap-1.5 text-[14px] font-semibold text-[#0F7A37] group-hover:text-[#0B5B29]\" data-kid=\"1-3-1-2-2\" data-name=\"venue location link label\">14 Baratashvili Street <i class=\"ti ti-arrow-right text-[14px]\" data-kid=\"1-3-1-2-2-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n<a class=\"group block\" data-kid=\"1-3-1-3\" data-name=\"link card for Rustaveli Avenue venue\" href=\"#\">\n<img alt=\"Terrace at 48 Rustaveli Avenue\" class=\"w-full h-[152px] object-cover rounded-xl\" data-kid=\"1-3-1-3-1\" data-name=\"terrace venue photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/locations/rustaveli-avenue-48.jpg\"/>\n<span class=\"mt-3 flex items-center gap-1.5 text-[14px] font-semibold text-[#0F7A37] group-hover:text-[#0B5B29]\" data-kid=\"1-3-1-3-2\" data-name=\"venue location link label\">48 Rustaveli Avenue <i class=\"ti ti-arrow-right text-[14px]\" data-kid=\"1-3-1-3-2-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</div>\n</section>\n<!-- Most Popular Dishes -->\n<section class=\"bg-[#F7F7EC] px-10 py-12\" data-kid=\"1-4\" data-name=\"most popular dishes section\">\n<div class=\"max-w-[1200px] mx-auto\" data-kid=\"1-4-1\" data-name=\"section content container\">\n<div class=\"h-10 flex items-end justify-between\" data-kid=\"1-4-1-1\" data-name=\"section header row with title and link\">\n<h2 class=\"text-[32px] leading-10 font-medium\" data-kid=\"1-4-1-1-1\" data-name=\"section heading - most popular dishes\">Most Popular Dishes</h2>\n<a class=\"flex items-center gap-1.5 pb-1 text-[14px] font-semibold text-[#0F7A37] hover:text-[#0B5B29]\" data-kid=\"1-4-1-1-2\" data-name=\"view menu link\" href=\"#\">View menu <i class=\"ti ti-arrow-right text-[14px]\" data-kid=\"1-4-1-1-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n<div class=\"mt-4 grid grid-cols-4 gap-6\" data-kid=\"1-4-1-2\" data-name=\"popular dishes grid\">\n<article class=\"bg-white rounded-3xl p-4 h-[220px] flex flex-col items-center text-center shadow-[0_0_10px_4px_rgba(194,194,194,0.25)]\" data-kid=\"1-4-1-2-1\" data-name=\"dish card - truffle mushroom risotto\">\n<img alt=\"Truffle Mushroom Risotto — photo by Shameel mukkath on Pexels\" class=\"w-[120px] h-[120px] rounded-full object-cover\" data-kid=\"1-4-1-2-1-1\" data-name=\"dish photo - truffle mushroom risotto\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/5638527/pexels-photo-5638527.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 text-[14px] leading-5 font-medium\" data-kid=\"1-4-1-2-1-2\" data-name=\"dish name text\">Truffle Mushroom Risotto</h3>\n<div class=\"mt-1 flex items-center gap-2\" data-kid=\"1-4-1-2-1-3\" data-name=\"dish price and portion row\"><span class=\"text-[14px] font-semibold text-[#0F7A37]\" data-kid=\"1-4-1-2-1-3-1\" data-name=\"dish price text\">$22.50</span><span class=\"text-[12px] text-[#898989]\" data-kid=\"1-4-1-2-1-3-2\" data-name=\"dish portion weight text\">350 g</span></div>\n</article>\n<article class=\"bg-white rounded-3xl p-4 h-[220px] flex flex-col items-center text-center shadow-[0_0_10px_4px_rgba(194,194,194,0.25)]\" data-kid=\"1-4-1-2-2\" data-name=\"dish card - grilled salmon\">\n<img alt=\"Grilled Salmon — photo by Cristian Mihaila on Pexels\" class=\"w-[120px] h-[120px] rounded-full object-cover\" data-kid=\"1-4-1-2-2-1\" data-name=\"dish photo - grilled salmon\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12431192/pexels-photo-12431192.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 text-[14px] leading-5 font-medium\" data-kid=\"1-4-1-2-2-2\" data-name=\"dish name text\">Grilled Salmon</h3>\n<div class=\"mt-1 flex items-center gap-2\" data-kid=\"1-4-1-2-2-3\" data-name=\"dish price and portion row\"><span class=\"text-[14px] font-semibold text-[#0F7A37]\" data-kid=\"1-4-1-2-2-3-1\" data-name=\"dish price text\">$18.99</span><span class=\"text-[12px] text-[#898989]\" data-kid=\"1-4-1-2-2-3-2\" data-name=\"dish portion weight text\">320 g</span></div>\n</article>\n<article class=\"bg-white rounded-3xl p-4 h-[220px] flex flex-col items-center text-center shadow-[0_0_10px_4px_rgba(194,194,194,0.25)]\" data-kid=\"1-4-1-2-3\" data-name=\"dish card - khachapuri adjarian\">\n<img alt=\"Khachapuri Adjarian — photo by Valeria Boltneva on Pexels\" class=\"w-[120px] h-[120px] rounded-full object-cover\" data-kid=\"1-4-1-2-3-1\" data-name=\"dish photo - khachapuri adjarian\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/15913594/pexels-photo-15913594.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 text-[14px] leading-5 font-medium\" data-kid=\"1-4-1-2-3-2\" data-name=\"dish name text\">Khachapuri Adjarian</h3>\n<div class=\"mt-1 flex items-center gap-2\" data-kid=\"1-4-1-2-3-3\" data-name=\"dish price and portion row\"><span class=\"text-[14px] font-semibold text-[#0F7A37]\" data-kid=\"1-4-1-2-3-3-1\" data-name=\"dish price text\">$16.50</span><span class=\"text-[12px] text-[#898989]\" data-kid=\"1-4-1-2-3-3-2\" data-name=\"dish portion weight text\">380 g</span></div>\n</article>\n<article class=\"bg-white rounded-3xl p-4 h-[220px] flex flex-col i