      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#F7F7EC] text-[#232323]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Poppins',sans-serif;\">\n<header class=\"h-20 bg-white border-b border-[#ECECE2]\" data-kid=\"1-1\" data-name=\"site header bar with logo and navigation\">\n<div class=\"max-w-[1200px] mx-auto h-full flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header content row\">\n<a class=\"flex items-center shrink-0\" data-kid=\"1-1-1-1\" data-name=\"site logo link\" href=\"#\">\n<img alt=\"Green &amp; Tasty\" class=\"h-[38px] w-auto\" data-kid=\"1-1-1-1-1\" data-name=\"restaurant logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/logo_vegeterian.svg\"/>\n</a>\n<nav class=\"h-full flex items-center gap-8\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n<a class=\"h-full flex items-center border-b-2 border-transparent text-[15px] font-medium text-[#575757]\" data-kid=\"1-1-1-2-1\" data-name=\"nav link to main page\" href=\"#\">Main page</a>\n<a class=\"h-full flex items-center border-b-2 border-transparent text-[15px] font-medium text-[#575757]\" data-kid=\"1-1-1-2-2\" data-name=\"nav link to menu\" href=\"#\">Menu</a>\n<a class=\"h-full flex items-center border-b-2 border-[#0F7A37] text-[15px] font-medium text-[#0F7A37]\" data-kid=\"1-1-1-2-3\" data-name=\"active nav link to book a table\" href=\"#\">Book a Table</a>\n<a class=\"h-full flex items-center border-b-2 border-transparent text-[15px] font-medium text-[#575757]\" data-kid=\"1-1-1-2-4\" data-name=\"nav link to reservations\" href=\"#\">Reservations</a>\n</nav>\n<button class=\"h-10 px-5 rounded-lg border-[1.4px] border-[#0F7A37] text-[#0F7A37] text-[14px] font-semibold bg-white\" data-kid=\"1-1-1-3\" data-name=\"sign in button\" type=\"button\">Sign In</button>\n</div>\n</header>\n<main class=\"max-w-[1200px] mx-auto pt-6 pb-16\" data-kid=\"1-2\" data-name=\"main book-a-table section\">\n<h1 class=\"text-[32px] leading-[40px] font-medium\" data-kid=\"1-2-1\" data-name=\"page heading Book a Table\">Book a Table</h1>\n<div class=\"mt-6 flex items-start gap-6\" data-kid=\"1-2-2\" data-name=\"reservation form and results layout\">\n<aside class=\"w-[360px] shrink-0 bg-white rounded-2xl border border-[#ECECE2] p-5 flex flex-col gap-3\" data-kid=\"1-2-2-1\" data-name=\"reservation details sidebar card\">\n<img alt=\"Dining room at 14 Baratashvili Street\" class=\"w-full h-[120px] object-cover rounded-xl\" data-kid=\"1-2-2-1-1\" data-name=\"dining room location photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/locations/baratashvili-street-14.jpg\"/>\n<div data-kid=\"1-2-2-1-2\" data-name=\"location field group\">\n<label class=\"block text-[13px] font-medium text-[#575757] mb-1\" data-kid=\"1-2-2-1-2-1\" data-name=\"location field label\">Location</label>\n<button class=\"h-12 w-full px-4 bg-white border border-[#E4E4D6] rounded-xl flex items-center justify-between text-[14px] font-medium text-[#232323]\" data-kid=\"1-2-2-1-2-2\" data-name=\"location dropdown button\" type=\"button\">\n<span data-kid=\"1-2-2-1-2-2-1\" data-name=\"selected location value text\">14 Baratashvili Street</span>\n<i class=\"ti ti-chevron-down text-[18px] text-[#575757]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"chevron down dropdown icon\"></i>\n</button>\n</div>\n<div data-kid=\"1-2-2-1-3\" data-name=\"date field group\">\n<label class=\"block text-[13px] font-medium text-[#575757] mb-1\" data-kid=\"1-2-2-1-3-1\" data-name=\"date field label\">Date</label>\n<button class=\"h-12 w-full px-4 bg-white border border-[#E4E4D6] rounded-xl flex items-center justify-between text-[14px] font-medium text-[#232323]\" data-kid=\"1-2-2-1-3-2\" data-name=\"date picker dropdown button\" type=\"button\">\n<span data-kid=\"1-2-2-1-3-2-1\" data-name=\"selected date value text\">Oct 30, 2026</span>\n<i class=\"ti ti-calendar text-[18px] text-[#575757]\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"calendar icon\"></i>\n</button>\n</div>\n<div data-kid=\"1-2-2-1-4\" data-name=\"time field group\">\n<label class=\"block text-[13px] font-medium text-[#575757] mb-1\" data-kid=\"1-2-2-1-4-1\" data-name=\"time field label\">Time</label>\n<button class=\"h-12 w-full px-4 bg-white border border-[#E4E4D6] rounded-xl flex items-center justify-between text-[14px] font-medium text-[#232323]\" data-kid=\"1-2-2-1-4-2\" data-name=\"time picker dropdown button\" type=\"button\">\n<span data-kid=\"1-2-2-1-4-2-1\" data-name=\"selected time value text\">19:00</span>\n<i class=\"ti ti-clock text-[18px] text-[#575757]\" data-kid=\"1-2-2-1-4-2-2\" data-name=\"clock icon\"></i>\n</button>\n</div>\n<div data-kid=\"1-2-2-1-5\" data-name=\"guests field group\">\n<label class=\"block text-[13px] font-medium text-[#575757] mb-1\" data-kid=\"1-2-2-1-5-1\" data-name=\"guests field label\">Guests</label>\n<div class=\"h-12 w-full px-3 bg-white border border-[#E4E4D6] rounded-xl flex items-center justify-between\" data-kid=\"1-2-2-1-5-2\" data-name=\"guest count stepper control\">\n<button aria-label=\"Decrease value\" class=\"w-9 h-9 rounded-lg border-[1.4px] border-[#0F7A37] text-[#0F7A37] flex items-center justify-center\" data-kid=\"1-2-2-1-5-2-1\" data-name=\"decrease guests button\" type=\"button\">\n<i class=\"ti ti-minus text-[16px]\" data-kid=\"1-2-2-1-5-2-1-1\" data-name=\"minus icon\"></i>\n</button>\n<span class=\"text-[14px] font-semibold text-[#232323]\" data-kid=\"1-2-2-1-5-2-2\" data-name=\"guest count value text\">2</span>\n<button aria-label=\"Increase value\" class=\"w-9 h-9 rounded-lg border-[1.4px] border-[#0F7A37] text-[#0F7A37] flex items-center justify-center\" data-kid=\"1-2-2-1-5-2-3\" data-name=\"increase guests button\" type=\"button\">\n<i class=\"ti ti-plus text-[16px]\" data-kid=\"1-2-2-1-5-2-3-1\" data-name=\"plus icon\"></i>\n</button>\n</div>\n</div>\n<button class=\"h-14 w-full rounded-xl text-white text-[16px] font-semibold\" data-kid=\"1-2-2-1-6\" data-name=\"find a table call-to-action button\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%)\" type=\"button\">Find a Table</button>\n<div class=\"flex items-start gap-2 rounded-xl border border-[#C5E8C7] bg-[#e9ffea] p-3\" data-kid=\"1-2-2-1-7\" data-name=\"phone assistance notice box\">\n<i class=\"ti ti-phone-call text-[18px] text-[#0B5B29] mt-0.5\" data-kid=\"1-2-2-1-7-1\" data-name=\"phone call icon\"></i>\n<p class=\"text-[12px] leading-[18px] text-[#0B5B29]\" data-kid=\"1-2-2-1-7-2\" data-name=\"large group phone contact message\">For groups larger than 4, please call us directly at +123 445 678 8990</p>\n</div>\n</aside>\n<section class=\"flex-1\" data-kid=\"1-2-2-2\" data-name=\"available tables results section\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"1-2-2-2-1\" data-name=\"results header with count and summary\">\n<h2 class=\"text-[20px] leading-7 font-semibold\" data-kid=\"1-2-2-2-1-1\" data-name=\"tables available count heading\">2 tables available</h2>\n<span class=\"text-[14px] text-[#575757]\" data-kid=\"1-2-2-2-1-2\" data-name=\"search summary detail text\">14 Baratashvili Street · Oct 30, 2026 · 19:00 · 2 guests</span>\n</div>\n<div class=\"mt-4 grid grid-cols-2 gap-6\" data-kid=\"1-2-2-2-2\" data-name=\"table cards grid\">\n<article class=\"bg-white rounded-2xl border border-[#ECECE2] overflow-hidden flex flex-col\" data-kid=\"1-2-2-2-2-1\" data-name=\"table card\">\n<img alt=\"Table setting\" class=\"w-full h-[104px] object-cover\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"table setting photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/table-card-image.jpg\"/>\n<div class=\"p-4 flex flex-col grow\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"table card body\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"1-2-2-2-2-1-2-1\" data-name=\"table name and capacity header\">\n<h3 class=\"text-[20px] leading-7 font-semibold text-[#0F7A37]\" data-kid=\"1-2-2-2-2-1-2-1-1\" data-name=\"table name heading\">Table 1</h3>\n<span class=\"text-[13px] text-[#575757]\" data-kid=\"1-2-2-2-2-1-2-1-2\" data-name=\"table capacity text\">Up to 6 guests</span>\n</div>\n<div class=\"mt-1 pb-2 mb-3 border-b border-[#ECECE2] flex items-center gap-1.5\" data-kid=\"1-2-2-2-2-1-2-2\" data-name=\"table location row\">\n<i class=\"ti ti-map-pin text-[16px] text-[#575757]\" data-kid=\"1-2-2-2-2-1-2-2-1\" data-name=\"map pin icon\"></i>\n<span class=\"text-[13px] text-[#575757]\" data-kid=\"1-2-2-2-2-1-2-2-2\" data-name=\"table address text\">14 Baratashvili Street</span>\n</div>\n<div class=\"mt-auto grid grid-cols-3 gap-2\" data-kid=\"1-2-2-2-2-1-2-3\" data-name=\"available time slots grid\">\n<button class=\"h-10 rounded-lg border border-[#0F7A37] text-[#0F7A37] text-[14px] font-medium bg-white\" data-kid=\"1-2-2-2-2-1-2-3-1\" data-name=\"available time slot button 18:00\" type=\"button\">18:00</button>\n<button aria-disabled=\"true\" class=\"h-10 rounded-lg border border-[#DADADA] text-[#B4B4B4] text-[14px] font-medium line-through cursor-not-allowed\" data-kid=\"1-2-2-2-2-1-2-3-2\" data-name=\"unavailable time slot button 18:30\" type=\"button\">18:30</button>\n<button aria-pressed=\"true\" class=\"h-10 rounded-lg text-white text-[14px] font-semibold flex items-center justify-center gap-1\" data-kid=\"1-2-2-2-2-1-2-3-3\" data-name=\"selected time slot button 19:00\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%)\" type=\"button\"><i class=\"ti ti-check text-[16px]\" data-kid=\"1-2-2-2-2-1-2-3-3-1\" data-name=\"checkmark selection icon\"></i>19:00</button>\n<button class=\"h-10 rounded-lg border border-[#0F7A37] text-[#0F7A37] text-[14px] font-medium bg-white\" data-kid=\"1-2-2-2-2-1-2-3-4\" data-name=\"available time slot button 19:30\" type=\"button\">19:30</button>\n<button class=\"h-10 rounded-lg border border-[#0F7A37] text-[#0F7A37] text-[14px] font-medium bg-white\" data-kid=\"1-2-2-2-2-1-2-3-5\" data-name=\"available time slot button 20:00\" type=\"button\">20:00</button>\n<button aria-disabled=\"true\" class=\"h-10 rounded-lg border border-[#DADADA] text-[#B4B4B4] text-[14px] font-medium line-through cursor-not-allowed\" data-kid=\"1-2-2-2-2-1-2-3-6\" data-name=\"unavailable time slot button 20:30\" type=\"button\">20:30</button>\n</div>\n</div>\n</article>\n<article class=\"bg-white rounded-2xl border border-[#ECECE2] overflow-hidden flex flex-col\" data-kid=\"1-2-2-2-2-2\" data-name=\"table card\">\n<img alt=\"Table setting\" class=\"w-full h-[104px] object-cover\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"table setting photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/table-card-image.jpg\"/>\n<div class=\"p-4 flex flex-col grow\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"table card body\">\n<div class=\"flex items-baseline justify-between\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"table name and capacity header\">\n<h3 class=\"text-[20px] leading-7 font-semibold text-[#0F7A37]\" data-kid=\"1-2-2-2-2-2-2-1-1\" data-name=\"table name heading\">Table 2</h3>\n<span class=\"text-[13px] text-[#575757]\" data-kid=\"1-2-2-2-2-2-2-1-2\" data-name=\"table capacity text\">Up to 4 guests</span>\n</div>\n<div class=\"mt-1 pb-2 mb-3 border-b border-[#ECECE2] flex items-center gap-1.5\" data-kid=\"1-2-2-2-2-2-2-2\" data-name=\"table location row\">\n<i class=\"ti ti-map-pin text-[16px] text-[#575757]\" data-kid=\"1-2-2-2-2-2-2-2-1\" data-name=\"map pin icon\"></i>\n<span class=\"text-[13px] text-[#575757]\" data-kid=\"1-2-2-2-2-2-2-2-2\" data-name=\"table address text\">14 Baratashvili Street</span>\n</div>\n<div class=\"mt-auto grid grid-cols-3 gap-2\" data-kid=\"1-2-2-2-2-2-2-3\" data-name=\"available time slots grid\">\n<button aria-disabled=\"true\" class=\"h-10 rounded-lg border border-[#DADADA] text-[#B4B4B4] text-[14px] font-medium line-through cursor-not-allowed\" data-kid=\"1-2-2-2-2-2-2-3-1\" data-name=\"unavailable time slot button 18:00\" type=\"button\">18:00</button>\n<button class=\"h-10 rounded-lg border border-[#0F7A37] text-[#0F7A37] text-[14px] font-medium bg-white\" data-kid=\"1-2-2-2-2-2-2-3-2\" data-name=\"available time slot button 18:30\" type=\"button\">18:30</button>\n<button class=\"h-10 rounded-lg border border-[#0F7A37] text-[#0F7A37] text-[14px] font-medium bg-white\" data-kid=\"1-2-2-2-2-2-2-3-3\" data-name=\"available time slot button 19:00\" type=\"button\">19:00</button>\n<button class=\"h-10 rounded-lg border border-[#0F7A37] text-[#0F7A37] text-[14px] font-medium bg-white\" data-kid=\"1-2-2-2-2-2-2-3-4\" data-name=\"available time slot button 19:30\" type=\"button\">19:30</button>\n<button aria-disabled=\"true\" class=\"h-10 rounded-lg border border-[#DADADA] text-[#B4B4B4] text-[14px] font-medium line-through cursor-not-allowed\" data-kid=\"1-2-2-2-2-2-2-3-5\" data-name=\"unavailable time slot button 20:00\" type=\"button\">20:00</button>\n<button class=\"h-10 rounded-lg border border-[#0F7A37] text-[#0F7A37] text-[14px] font-medium bg-white\" data-kid=\"1-2-2-2-2-2-2-3-6\" data-name=\"available time slot button 20:30\" type=\"button\">20:30</button>\n</div>\n</div>\n</article>\n</div>\n</section>\n</div>\n</main>\n</div>",
