      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"w-full min-h-screen bg-[#F7F7EC] font-['Poppins',_sans-serif] text-[#232323]\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- Header -->\n<header class=\"h-20 bg-white flex items-center px-10\" data-kid=\"1-1\" data-name=\"site header bar\">\n<a class=\"flex items-center shrink-0\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\">\n<img alt=\"Green &amp; Tasty\" class=\"h-9 w-auto\" data-kid=\"1-1-1-1\" data-name=\"restaurant logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/logo_vegeterian.svg\"/>\n</a>\n<nav class=\"ml-12 flex items-center gap-9 text-[15px] font-medium\" data-kid=\"1-1-2\" data-name=\"main navigation\">\n<a class=\"text-[#0F7A37] font-semibold relative after:absolute after:left-0 after:right-0 after:-bottom-[10px] after:h-[2px] after:bg-[#0F7A37]\" data-kid=\"1-1-2-1\" data-name=\"active nav link with underline\" href=\"#\">Main page</a>\n<a class=\"text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-2\" data-name=\"menu navigation link\" href=\"#\">Menu</a>\n<a class=\"text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-3\" data-name=\"book a table navigation link\" href=\"#\">Book a Table</a>\n<a class=\"text-[#232323] hover:text-[#0F7A37]\" data-kid=\"1-1-2-4\" data-name=\"reservations navigation link\" href=\"#\">Reservations</a>\n</nav>\n<div class=\"ml-auto\" data-kid=\"1-1-3\" data-name=\"header right action container\">\n<button class=\"h-10 px-5 rounded-lg border-[1.5px] border-[#0F7A37] bg-white text-[#0F7A37] text-[15px] font-semibold\" data-kid=\"1-1-3-1\" data-name=\"sign in button\">Sign In</button>\n</div>\n</header>\n<!-- Hero -->\n<section class=\"px-10 pt-6\" data-kid=\"1-2\" data-name=\"hero section\">\n<div class=\"h-[300px] flex rounded-[24px] overflow-hidden\" data-kid=\"1-2-1\" data-name=\"hero banner with split layout\">\n<div class=\"w-[560px] shrink-0 bg-[#D6E5D5] px-12 py-10 flex flex-col justify-center\" data-kid=\"1-2-1-1\" data-name=\"hero text panel\">\n<h1 class=\"text-[40px] leading-[1.15] font-medium text-[#232323]\" data-kid=\"1-2-1-1-1\" data-name=\"hero headline\">Green by nature, Georgian by heart.</h1>\n<p class=\"mt-3 text-[13px] font-medium uppercase tracking-[0.14em] text-[#0B5B29]\" data-kid=\"1-2-1-1-2\" data-name=\"hero descriptor tagline\">Seasonal bowls • Vegan friendly • Tbilisi</p>\n<div class=\"mt-7 flex items-center gap-4\" data-kid=\"1-2-1-1-3\" data-name=\"hero actions row\">\n<button class=\"h-14 px-7 rounded-lg bg-[linear-gradient(120deg,#0B5B29,#0F7A37_80%)] text-white text-base font-semibold\" data-kid=\"1-2-1-1-3-1\" data-name=\"primary book a table button\">Book a table</button>\n<button class=\"h-14 px-7 rounded-lg bg-white border-[1.5px] border-[#0F7A37] text-[#0F7A37] text-base font-semibold\" data-kid=\"1-2-1-1-3-2\" data-name=\"secondary view menu button\">View Menu</button>\n</div>\n</div>\n<img alt=\"Georgian dishes served on a Green &amp; Tasty table\" class=\"h-full w-full object-cover\" data-kid=\"1-2-1-2\" data-name=\"hero food photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/main-page-cover.webp\"/>\n</div>\n</section>\n<!-- Most Popular Dishes -->\n<section class=\"px-10 pt-8 pb-14\" data-kid=\"1-3\" data-name=\"most popular dishes section\">\n<div class=\"h-10 flex items-end justify-between\" data-kid=\"1-3-1\" data-name=\"section heading row\">\n<h2 class=\"text-[32px] leading-10 font-medium\" data-kid=\"1-3-1-1\" data-name=\"section title\">Most Popular Dishes</h2>\n<a class=\"flex items-center gap-1.5 text-[14px] font-semibold text-[#0F7A37]\" data-kid=\"1-3-1-2\" data-name=\"view menu link\" href=\"#\">View menu <i class=\"ti ti-arrow-right text-[16px]\" data-kid=\"1-3-1-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n<div class=\"mt-4 grid grid-cols-4 gap-6\" data-kid=\"1-3-2\" data-name=\"popular dishes grid\">\n<div class=\"bg-white rounded-[24px] p-4 pt-5 flex flex-col items-center shadow-[0_0_10px_4px_rgba(194,194,194,0.30)]\" data-kid=\"1-3-2-1\" data-name=\"dish card\">\n<div class=\"w-[144px] h-[144px] rounded-full overflow-hidden\" data-kid=\"1-3-2-1-1\" data-name=\"dish photo container\">\n<img alt=\"Truffle Mushroom Risotto — photo by Shameel mukkath on Pexels\" class=\"w-full h-full object-cover\" data-kid=\"1-3-2-1-1-1\" data-name=\"truffle risotto dish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/5638527/pexels-photo-5638527.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n</div>\n<p class=\"mt-4 text-[14px] leading-5 font-medium text-center\" data-kid=\"1-3-2-1-2\" data-name=\"dish name text\">Truffle Mushroom Risotto</p>\n<p class=\"mt-1 text-[14px] font-semibold text-[#0F7A37]\" data-kid=\"1-3-2-1-3\" data-name=\"dish price text\">$22.50</p>\n<p class=\"mt-0.5 text-[12px] text-[#575757]\" data-kid=\"1-3-2-1-4\" data-name=\"dish serving size text\">350 g</p>\n</div>\n<div class=\"bg-white rounded-[24px] p-4 pt-5 flex flex-col items-center shadow-[0_0_10px_4px_rgba(194,194,194,0.30)]\" data-kid=\"1-3-2-2\" data-name=\"dish card\">\n<div class=\"w-[144px] h-[144px] rounded-full overflow-hidden\" data-kid=\"1-3-2-2-1\" data-name=\"dish photo container\">\n<img alt=\"Grilled Salmon — photo by Cristian Mihaila on Pexels\" class=\"w-full h-full object-cover\" data-kid=\"1-3-2-2-1-1\" data-name=\"grilled salmon dish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12431192/pexels-photo-12431192.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n</div>\n<p class=\"mt-4 text-[14px] leading-5 font-medium text-center\" data-kid=\"1-3-2-2-2\" data-name=\"dish name text\">Grilled Salmon</p>\n<p class=\"mt-1 text-[14px] font-semibold text-[#0F7A37]\" data-kid=\"1-3-2-2-3\" data-name=\"dish price text\">$18.99</p>\n<p class=\"mt-0.5 text-[12px] text-[#575757]\" data-kid=\"1-3-2-2-4\" data-name=\"dish serving size text\">320 g</p>\n</div>\n<div class=\"bg-white rounded-[24px] p-4 pt-5 flex flex-col items-center shadow-[0_0_10px_4px_rgba(194,194,194,0.30)]\" data-kid=\"1-3-2-3\" data-name=\"dish card\">\n<div class=\"w-[144px] h-[144px] rounded-full overflow-hidden\" data-kid=\"1-3-2-3-1\" data-name=\"dish photo container\">\n<img alt=\"Khachapuri Adjarian — photo by Valeria Boltneva on Pexels\" class=\"w-full h-full object-cover\" data-kid=\"1-3-2-3-1-1\" data-name=\"khachapuri dish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/18330960/pexels-photo-18330960.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n</div>\n<p class=\"mt-4 text-[14px] leading-5 font-medium text-center\" data-kid=\"1-3-2-3-2\" data-name=\"dish name text\">Khachapuri Adjarian</p>\n<p class=\"mt-1 text-[14px] font-semibold text-[#0F7A37]\" data-kid=\"1-3-2-3-3\" data-name=\"dish price text\">$16.50</p>\n<p class=\"mt-0.5 text-[12px] text-[#575757]\" data-kid=\"1-3-2-3-4\" data-name=\"dish serving size text\">380 g</p>\n</div>\n<div class=\"bg-white rounded-[24px] p-4 pt-5 flex flex-col items-center shadow-[0_0_10px_4px_rgba(194,194,194,0.30)]\" data-kid=\"1-3-2-4\" data-name=\"dish card\">\n<div class=\"w-[144px] h-[144px] rounded-full overflow-hidden\" data-kid=\"1-3-2-4-1\" data-name=\"dish photo container\">\n<img alt=\"Lamb Shashlik — photo by Mavi Yildiz Restoran on Pexels\" class=\"w-full h-full object-cover\" data-kid=\"1-3-2-4-1-1\" data-name=\"lamb shashlik dish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/37206698/pexels-photo-37206698.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n</div>\n<p class=\"mt-4 text-[14px] leading-5 font-medium text-center\" data-kid=\"1-3-2-4-2\" data-name=\"dish name text\">Lamb Shashlik</p>\n<p class=\"mt-1 text-[14px] font-semibold text-[#0F7A37]\" data-kid=\"1-3-2-4-3\" data-name=\"dish price text\">$21.00</p>\n<p class=\"mt-0.5 text-[12px] text-[#575757]\" data-kid=\"1-3-2-4-4\" data-name=\"dish serving size text\">300 g</p>\n</div>\n</div>\n</section>\n<!-- Locations -->\n<section class=\"bg-white px-10 py-14\" data-kid=\"1-4\" data-name=\"locations section\">\n<div class=\"h-10 flex items-end\" data-kid=\"1-4-1\" data-name=\"locations section heading row\">\n<h2 class=\"text-[32px] leading-10 font-medium\" data-kid=\"1-4-1-1\" data-name=\"locations section title\">Locations</h2>\n</div>\n<div class=\"mt-4 grid grid-cols-3 gap-6\" data-kid=\"1-4-2\" data-name=\"locations grid\">\n<a class=\"block rounded-[24px] overflow-hidden bg-white border border-[#E8E8E3] shadow-[0_0_10px_4px_rgba(194,194,194,0.22)]\" data-kid=\"1-4-2-1\" data-name=\"location card\" href=\"#\">\n<img alt=\"Dining room at 9 Abashidze Street\" class=\"h-[190px] w-full object-cover\" data-kid=\"1-4-2-1-1\" data-name=\"location photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/locations/abashidze-street-9.jpg\"/>\n<div class=\"p-5\" data-kid=\"1-4-2-1-2\" data-name=\"location details container\">\n<p class=\"flex items-center gap-2 text-[18px] font-medium\" data-kid=\"1-4-2-1-2-1\" data-name=\"location address with pin\"><i class=\"ti ti-map-pin text-[18px] text-[#0F7A37]\" data-kid=\"1-4-2-1-2-1-1\" data-name=\"map pin icon\"></i>9 Abashidze Street</p>\n<div class=\"mt-3 flex items-center gap-6 text-[13px] text-[#575757]\" data-kid=\"1-4-2-1-2-2\" data-name=\"location stats row\">\n<span class=\"flex items-center gap-1.5\" data-kid=\"1-4-2-1-2-2-1\" data-name=\"tables count stat\"><i class=\"ti ti-table text-[16px]\" data-kid=\"1-4-2-1-2-2-1-1\" data-name=\"table icon\"></i>2 tables</span>\n<span class=\"flex items-center gap-1.5\" data-kid=\"1-4-2-1-2-2-2\" data-name