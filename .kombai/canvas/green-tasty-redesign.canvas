e\" class=\"flex h-10 items-center justify-center rounded-lg border border-[#0F7A37] bg-white text-[14px] font-medium text-[#0F7A37]\" data-kid=\"1-2-2-2-2-1-2-8\" data-name=\"available time slot button\" type=\"button\">21:30</button>\n</div>\n</article>\n<!-- Table card 2 -->\n<article class=\"rounded-3xl bg-white p-4 shadow-[0_2px_6px_rgba(35,35,35,0.06),0_12px_32px_rgba(35,35,35,0.10)]\" data-kid=\"1-2-2-2-2-2\" data-name=\"table availability card\">\n<div class=\"flex gap-3\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"two-column card header layout\">\n<img alt=\"Table setting\" class=\"h-[104px] w-[104px] shrink-0 rounded-xl object-cover\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"table photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/table-card-image.jpg\"/>\n<div class=\"min-w-0 flex-1 pt-1\" data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"table info block\">\n<p class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-2-2-2-2-1-2-1\" data-name=\"two-name label\">Table 1</p>\n<p class=\"mt-1 text-[14px] text-[#575757]\" data-kid=\"1-2-2-2-2-2-1-2-2\" data-name=\"table capacity text\">Up to 6 guests</p>\n<p class=\"mt-2 flex items-center gap-1.5 text-[13px] text-[#575757]\" data-kid=\"1-2-2-2-2-2-1-2-3\" data-name=\"table address line\"><i class=\"ti ti-map-pin text-[13px] text-[#0F7A37]\" data-kid=\"1-2-2-2-2-2-1-2-3-1\" data-name=\"map pin icon\"></i>14 Baratashvili Street</p>\n</div>\n</div>\n<div class=\"mt-3 grid grid-cols-4 gap-2\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"two-time slots grid\">\n<button class=\"flex h-10 items-center justify-center rounded-lg border border-[#dadada] bg-[#f7f7f7] text-[14px] font-medium text-[#898989]\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"disabled unavailable time slot button\" disabled=\"\" type=\"button\">18:00</button>\n<button aria-pressed=\"false\" class=\"flex h-10 items-center justify-center rounded-lg border border-[#0F7A37] bg-white text-[14px] fo