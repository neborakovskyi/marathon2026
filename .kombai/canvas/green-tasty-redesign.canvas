ing=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/2233729/pexels-photo-2233729.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 text-[14px] leading-5 font-medium text-[#232323]\" data-kid=\"1-2-3-8-2\" data-name=\"dish name heading\">Lamb Shashlik</h3>\n<div class=\"mt-auto w-full flex items-end justify-between px-1\" data-kid=\"1-2-3-8-3\" data-name=\"price and weight row\">\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-8-3-1\" data-name=\"dish price text\">$21.00</span>\n<span class=\"text-[12px] text-[#898989]\" data-kid=\"1-2-3-8-3-2\" data-name=\"dish weight text\">300 g</span>\n</div>\n</article>\n<article class=\"relative bg-white rounded-2xl border border-[#ECECE2] p-4 h-[248px] flex flex-col items-center\" data-kid=\"1-2-3-9\" data-name=\"menu item card\">\n<img alt=\"Beef Steak — photo by Mohamed Olwy on Pexels\" class=\"w-[132px] h-[132px] rounded-full object-cover ring-4 ring-[#F1F4EC]\" data-kid=\"1-2-3-9-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/36691297/pexels-photo-36691297.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 text-[14px] leading-5 font-medium text-[#232323]\" data-kid=\"1-2-3-9-2\" data-name=\"dish name heading\">Beef Steak</h3>\n<div class=\"mt-auto w-full flex items-end justify-between px-1\" data-kid=\"1-2-3-9-3\" data-name=\"price and weight row\">\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-9-3-1\" data-name=\"dish price text\">$27.50</span>\n<span class=\"text-[12px] text-[#898989]\" data-kid=\"1-2-3-9-3-2\" data-name=\"dish weight text\">280 g</span>\n</div>\n</article>\n<article class=\"relative bg-white rounded-2xl border border-[#ECECE2] p-4 h-[248px] flex flex-col items-center\" data-kid=\"1-2-3-10\" data-name=\"menu item card\">\n<img alt=\"Chocolate Lava Cake — photo by Marina Utrabo on Pexels\" class=\"w-[132px] h-[132px] rounded-full object-cover ring-4 ring-[#F1F4EC]\" data-kid=\"1-2-3-10-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/4662043/pexels-photo-4662043.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 text-[14px] leading-5 font-medium text-[#232323]\" data-kid=\"1-2-3-10-2\" data-name=\"dish name heading\">Chocolate Lava Cake</h3>\n<div class=\"mt-auto w-full flex items-end justify-between px-1\" data-kid=\"1-2-3-10-3\" data-name=\"price and weight row\">\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-10-3-1\" data-name=\"dish price text\">$8.50</span>\n<span class=\"text-[12px] text-[#898989]\" data-kid=\"1-2-3-10-3-2\" data-name=\"dish weight text\">160 g</span>\n</div>\n</article>\n<article class=\"relative bg-white rounded-2xl border border-[#ECECE2] p-4 h-[248px] flex flex-col items-center\" data-kid=\"1-2-3-11\" data-name=\"menu item card\">\n<img alt=\"Tiramisu — photo by Irene Ästhetik on Pexels\" class=\"w-[132px] h-[132px] rounded-full object-cover ring-4 ring-[#F1F4EC]\" data-kid=\"1-2-3-11-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/34801388/pexels-photo-34801388.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 text-[14px] leading-5 font-medium text-[#232323]\" data-kid=\"1-2-3-11-2\" data-name=\"dish name heading\">Tiramisu</h3>\n<div class=\"mt-auto w-full flex items-end justify-between px-1\" data-kid=\"1-2-3-11-3\" data-name=\"price and weight row\">\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-11-3-1\" data-name=\"dish price text\">$9.00</span>\n<span class=\"text-[12px] text-[#898989]\" data-kid=\"1-2-3-11-3-2\" data-name=\"dish weight text\">180 g</span>\n</div>\n</article>\n<article aria-disabled=\"true\" class=\"relative bg-white rounded-2xl border border-[#ECECE2] p-4 h-[248px] flex flex-col items-center cursor-not-allowed\" data-kid=\"1-2-3-12\" data-name=\"unavailable menu item card\">\n<span class=\"absolute top-3 right-3 h-6 px-2.5 inline-flex items-center rounded-full bg-[#FCE9ED] text-[#B70B0B] text-[11px] font-semibold\" data-kid=\"1-2-3-12-1\" data-name=\"on stop unavailable badge\">On Stop</span>\n<div class=\"opacity-40 pointer-events-none select-none flex flex-col items-center h-full w-full\" data-kid=\"1-2-3-12-2\" data-name=\"dimmed dish content wrapper\">\n<img alt=\"Panna Cotta — photo by Mattia Marcassoli on Pexels\" class=\"w-[132px] h-[132px] rounded-full object-cover ring-4 ring-[#F1F4EC]\" data-kid=\"1-2-3-12-2-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/3301907/pexels-photo-3301907.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<h3 class=\"mt-3 text-[14px] leading-5 font-medium text-[#232323]\" data-kid=\"1-2-3-12-2-2\" data-name=\"dish name heading\">Panna Cotta</h3>\n<div class=\"mt-auto w-full flex items-end justify-between px-1\" data-kid=\"1-2-3-12-2-3\" data-name=\"price and weight row\">\n<span class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-3-12-2-3-1\" data-name=\"dish price text\">$8.00</span>\n<span class=\"text-[12px] text-[#898989]\" data-kid=\"1-2-3-12-2-3-2\" data-name=\"dish weight text\">150 g</span>\n</div>\n</div>\n</article>\n</div>\n</main>\n</div>",
