      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-[900px] w-full bg-[#F7F7EC] text-[#232323] font-['Poppins',sans-serif]\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- Header -->\n<header class=\"h-20 bg-white border-b border-[#dadada]/70\" data-kid=\"1-1\" data-name=\"site header with navigation\">\n<div class=\"mx-auto flex h-full w-full max-w-[1280px] items-center justify-between px-10\" data-kid=\"1-1-1\" data-name=\"header inner layout bar\">\n<a class=\"flex items-center shrink-0\" data-kid=\"1-1-1-1\" data-name=\"restaurant logo link\" href=\"#\">\n<img alt=\"Green &amp; Tasty\" class=\"h-[38px] w-auto\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/logo_vegeterian.svg\"/>\n</a>\n<nav class=\"flex h-full items-center gap-8\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n<a class=\"flex h-full items-center border-b-2 border-transparent text-[15px] font-medium text-[#232323]\" data-kid=\"1-1-1-2-1\" data-name=\"nav link to main page\" href=\"#\">Main page</a>\n<a class=\"flex h-full items-center border-b-2 border-transparent text-[15px] font-medium text-[#232323]\" data-kid=\"1-1-1-2-2\" data-name=\"nav link to menu\" href=\"#\">Menu</a>\n<a class=\"flex h-full items-center border-b-2 border-[#0F7A37] text-[15px] font-semibold text-[#0F7A37]\" data-kid=\"1-1-1-2-3\" data-name=\"active nav link to book a table\" href=\"#\">Book a Table</a>\n<a class=\"flex h-full items-center border-b-2 border-transparent text-[15px] font-medium text-[#232323]\" data-kid=\"1-1-1-2-4\" data-name=\"nav link to reservations\" href=\"#\">Reservations</a>\n</nav>\n<button class=\"h-10 shrink-0 rounded-lg border-[1.4px] border-[#0F7A37] bg-white px-5 text-[14px] font-semibold text-[#0F7A37]\" data-kid=\"1-1-1-3\" data-name=\"sign in button\" type=\"button\">Sign In</button>\n</div>\n</header>\n<main class=\"mx-auto w-full max-w-[1280px] px-10 pb-14\" data-kid=\"1-2\" data-name=\"main content area\">\n<!-- Title region -->\n<div class=\"flex h-[72px] items-end pb-3 pt-7\" data-kid=\"1-2-1\" data-name=\"page title region\">\n<h1 class=\"text-[32px] leading-[40px] font-medium\" data-kid=\"1-2-1-1\" data-name=\"page title heading\">Book a Table</h1>\n</div>\n<div class=\"flex items-start gap-6\" data-kid=\"1-2-2\" data-name=\"booking layout row with panels\">\n<!-- Search panel -->\n<aside class=\"w-[328px] shrink-0 rounded-3xl bg-white p-6 shadow-[0_2px_6px_rgba(35,35,35,0.06),0_12px_32px_rgba(35,35,35,0.10)]\" data-kid=\"1-2-2-1\" data-name=\"filter panel card\" w-=\"\">\n<div class=\"space-y-4\" data-kid=\"1-2-2-1-1\" data-name=\"filter form fields container\">\n<div data-kid=\"1-2-2-1-1-1\" data-name=\"location filter field\">\n<label class=\"mb-1.5 block text-[13px] font-medium text-[#575757]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"location filter label\">Location</label>\n<button class=\"flex h-12 w-full items-center justify-between rounded-lg border border-[#dadada] bg-white px-3.5 text-left text-[14px] text-[#232323]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"location dropdown select button\" type=\"button\">\n<span data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"selected location value\">All Locations</span>\n<i class=\"ti ti-chevron-down text-[16px] text-[#575757]\" data-kid=\"1-2-2-1-1-1-2-2\" data-name=\"chevron down icon\"></i>\n</button>\n</div>\n<div data-kid=\"1-2-2-1-1-2\" data-name=\"date filter field\">\n<label class=\"mb-1.5 block text-[13px] font-medium text-[#575757]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"date filter label\">Date</label>\n<button class=\"flex h-12 w-full items-center justify-between rounded-lg border border-[#dadada] bg-white px-3.5 text-left text-[14px] text-[#232323]\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"date dropdown select button\" type=\"button\">\n<span data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"selected date value\">Oct 30, 2026</span>\n<i class=\"ti ti-calendar text-[16px] text-[#0F7A37]\" data-kid=\"1-2-2-1-1-2-2-2\" data-name=\"calendar icon\"></i>\n</button>\n</div>\n<div data-kid=\"1-2-2-1-1-3\" data-name=\"time filter field\">\n<label class=\"mb-1.5 block text-[13px] font-medium text-[#575757]\" data-kid=\"1-2-2-1-1-3-1\" data-name=\"time filter label\">Time</label>\n<button class=\"flex h-12 w-full items-center justify-between rounded-lg border border-[#dadada] bg-white px-3.5 text-left text-[14px] text-[#232323]\" data-kid=\"1-2-2-1-1-3-2\" data-name=\"time dropdown select button\" type=\"button\">\n<span data-kid=\"1-2-2-1-1-3-2-1\" data-name=\"selected time value\">19:00</span>\n<i class=\"ti ti-clock text-[16px] text-[#0F7A37]\" data-kid=\"1-2-2-1-1-3-2-2\" data-name=\"clock icon\"></i>\n</button>\n</div>\n<div data-kid=\"1-2-2-1-1-4\" data-name=\"guests filter field\">\n<label class=\"mb-1.5 block text-[13px] font-medium text-[#575757]\" data-kid=\"1-2-2-1-1-4-1\" data-name=\"guests filter label\">Guests</label>\n<div class=\"flex h-12 w-full items-center justify-between rounded-lg border border-[#dadada] bg-white px-2\" data-kid=\"1-2-2-1-1-4-2\" data-name=\"guests stepper control\">\n<button aria-label=\"Decrease value\" class=\"flex h-9 w-9 items-center justify-center rounded-lg border-[1.4px] border-[#0F7A37] text-[#0F7A37]\" data-kid=\"1-2-2-1-1-4-2-1\" data-name=\"decrease guests button\" type=\"button\">\n<i class=\"ti ti-minus text-[16px]\" data-kid=\"1-2-2-1-1-4-2-1-1\" data-name=\"minus icon\"></i>\n</button>\n<span class=\"text-[15px] font-semibold\" data-kid=\"1-2-2-1-1-4-2-2\" data-name=\"guest count value\">2</span>\n<button aria-label=\"Increase value\" class=\"flex h-9 w-9 items-center justify-center rounded-lg border-[1.4px] border-[#0F7A37] text-[#0F7A37]\" data-kid=\"1-2-2-1-1-4-2-3\" data-name=\"increase guests button\" type=\"button\">\n<i class=\"ti ti-plus text-[16px]\" data-kid=\"1-2-2-1-1-4-2-3-1\" data-name=\"plus icon\"></i>\n</button>\n</div>\n</div>\n</div>\n<button class=\"mt-6 h-14 w-full rounded-lg bg-[linear-gradient(120deg,#0B5B29,#0F7A37_80%)] text-[16px] font-semibold text-white\" data-kid=\"1-2-2-1-2\" data-name=\"find a table call-to-action button\" type=\"button\">Find a Table</button>\n<div class=\"mt-4 flex items-start gap-2.5 rounded-lg border border-[#C5E8C7] bg-[#e9ffea]/60 p-3\" data-kid=\"1-2-2-1-3\" data-name=\"large group notice message\">\n<i class=\"ti ti-phone-call mt-0.5 text-[16px] text-[#0F7A37]\" data-kid=\"1-2-2-1-3-1\" data-name=\"phone icon\"></i>\n<p class=\"text-[13px] leading-[19px] text-[#575757]\" data-kid=\"1-2-2-1-3-2\" data-name=\"large group notice text\">For groups larger than 4, please call us directly at +123 445 678 8990</p>\n</div>\n</aside>\n<!-- Results panel -->\n<section class=\"min-w-0 flex-1\" data-kid=\"1-2-2-2\" data-name=\"search results panel\">\n<div class=\"flex h-16 items-center justify-between\" data-kid=\"1-2-2-2-1\" data-name=\"results summary bar\">\n<h2 class=\"text-[20px] font-semibold\" data-kid=\"1-2-2-2-1-1\" data-name=\"tails-available count heading\">4 tables available</h2>\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-2\" data-name=\"results summary badges\">\n<span class=\"flex h-8 items-center gap-1.5 rounded-lg border border-[#dadada]/70 bg-white px-2.5 text-[13px] text-[#575757]\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"location summary badge\"><i class=\"ti ti-map-pin text-[14px] text-[#0F7A37]\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"map pin icon\"></i>All Locations</span>\n<span class=\"flex h-8 items-center gap-1.5 rounded-lg border border-[#dadada]/70 bg-white px-2.5 text-[13px] text-[#575757]\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"date summary badge\"><i class=\"ti ti-calendar text-[14px] text-[#0F7A37]\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"calendar icon\"></i>Oct 30, 2026</span>\n<span class=\"flex h-8 items-center gap-1.5 rounded-lg border border-[#dadada]/70 bg-white px-2.5 text-[13px] text-[#575757]\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"time summary badge\"><i class=\"ti ti-clock text-[14px] text-[#0F7A37]\" data-kid=\"1-2-2-2-1-2-3-1\" data-name=\"clock icon\"></i>19:00</span>\n<span class=\"flex h-8 items-center gap-1.5 rounded-lg border border-[#dadada]/70 bg-white px-2.5 text-[13px] text-[#575757]\" data-kid=\"1-2-2-2-1-2-4\" data-name=\"guests summary badge\"><i class=\"ti ti-users text-[14px] text-[#0F7A37]\" data-kid=\"1-2-2-2-1-2-4-1\" data-name=\"users icon\"></i>2 guests</span>\n</div>\n</div>\n<div class=\"grid grid-cols-2 gap-6\" data-kid=\"1-2-2-2-2\" data-name=\"tails results grid\">\n<!-- Table card 1 -->\n<article class=\"rounded-3xl bg-white p-4 shadow-[0_2px_6px_rgba(35,35,35,0.06),0_12px_32px_rgba(35,35,35,0.10)]\" data-kid=\"1-2-2-2-2-1\" data-name=\"table availability card\">\n<div class=\"flex gap-3\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"two-column card header layout\">\n<img alt=\"Table setting\" class=\"h-[104px] w-[104px] shrink-0 rounded-xl object-cover\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"table photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/table-card-image.jpg\"/>\n<div class=\"min-w-0 flex-1 pt-1\" data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"table info block\">\n<p class=\"text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-2-2-2-2-1-1-2-1\" data-name=\"two-name label\">Table 2</p>\n<p class=\"mt-1 text-[14px] text-[#575757]\" data-kid=\"1-2-2-2-2-1-1-2-2\" data-name=\"table capacity text\">Up to 4 guests</p>\n<p class=\"mt-2 flex items-center gap-1.5 text-[13px] text-[#575757]\" data-kid=\"1-2-2-2-2-1-1-2-3\" data-name=\"table address line\"><i class=\"ti ti-map-pin text-[13px] text-[#0F7A37]\" data-kid=\"1-2-2-2-2-1-1-2-3-1\" data-name=\"map pin icon\"></i>9 Abashidze Street</p>\n</div>\n</div>\n