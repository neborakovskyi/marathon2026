      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen w-full bg-black/45 flex items-center justify-center p-10\" data-kid=\"1\" data-name=\"modal overlay backdrop container\" style=\"font-family:'Poppins',sans-serif;\">\n<section aria-labelledby=\"v3-dish-title\" aria-modal=\"true\" class=\"relative w-[720px] bg-white rounded-3xl p-10 shadow-[0_24px_64px_rgba(35,35,35,0.28)]\" data-kid=\"1-1\" data-name=\"dish detail modal dialog card\" role=\"dialog\">\n<button aria-label=\"Close\" class=\"absolute top-6 right-6 w-10 h-10 rounded-lg flex items-center justify-center text-[#575757] hover:bg-[#e9ffea] hover:text-[#0F7A37]\" data-kid=\"1-1-1\" data-name=\"modal close button\" type=\"button\">\n<i class=\"ti ti-x text-[20px]\" data-kid=\"1-1-1-1\" data-name=\"close X icon\"></i>\n</button>\n<div class=\"flex items-start gap-8 pr-10\" data-kid=\"1-1-2\" data-name=\"dish info top layout row\">\n<div class=\"w-[208px] h-[208px] rounded-full overflow-hidden shrink-0 ring-8 ring-[#F7F7EC]\" data-kid=\"1-1-2-1\" data-name=\"dish photo circular frame\">\n<img alt=\"Khachapuri Adjarian — photo by Valeria Boltneva on Pexels\" class=\"w-full h-full object-cover\" data-kid=\"1-1-2-1-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/15913594/pexels-photo-15913594.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=480&amp;q=80\"/>\n</div>\n<div class=\"flex-1 pt-1 min-w-0\" data-kid=\"1-1-2-2\" data-name=\"dish text content column\">\n<h2 class=\"text-[26px] leading-9 font-medium text-[#232323]\" data-kid=\"1-1-2-2-1\" data-name=\"dish name headline\" id=\"v3-dish-title\">Khachapuri Adjarian</h2>\n<p class=\"mt-2 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-2-2-2\" data-name=\"dish description text\">Boat-shaped bread filled with molten cheese, butter, and egg.</p>\n<div class=\"mt-5 flex items-baseline gap-3\" data-kid=\"1-1-2-2-3\" data-name=\"price and weight display row\">\n<span class=\"text-[24px] leading-8 font-semibold text-[#0F7A37]\" data-kid=\"1-1-2-2-3-1\" data-name=\"dish price text\">$16.50</span>\n<span class=\"text-[14px] leading-6 font-medium text-[#575757]\" data-kid=\"1-1-2-2-3-2\" data-name=\"dish weight text\">380 g</span>\n</div>\n</div>\n</div>\n<div class=\"mt-8\" data-kid=\"1-1-3\" data-name=\"nutrition section\">\n<h3 class=\"text-[14px] leading-6 font-semibold text-[#232323] mb-2\" data-kid=\"1-1-3-1\" data-name=\"nutrition section heading\">Nutrition</h3>\n<dl class=\"border-y border-[#ECECE2] divide-y divide-[#ECECE2]\" data-kid=\"1-1-3-2\" data-name=\"nutrition facts definition list\">\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-1-3-2-1\" data-name=\"calories row\">\n<dt class=\"text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-2-1-1\" data-name=\"calories label\">Calories</dt>\n<dd class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-1-3-2-1-2\" data-name=\"calories value\">890 kcal</dd>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-1-3-2-2\" data-name=\"protein row\">\n<dt class=\"text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-2-2-1\" data-name=\"protein label\">Protein</dt>\n<dd class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-1-3-2-2-2\" data-name=\"protein value\">32 g</dd>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-1-3-2-3\" data-name=\"fats row\">\n<dt class=\"text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-2-3-1\" data-name=\"fats label\">Fats</dt>\n<dd class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-1-3-2-3-2\" data-name=\"fats value\">48 g</dd>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-1-3-2-4\" data-name=\"carbohydrates row\">\n<dt class=\"text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-2-4-1\" data-name=\"carbohydrates label\">Carbohydrates</dt>\n<dd class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-1-3-2-4-2\" data-name=\"carbohydrates value\">78 g</dd>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-1-3-2-5\" data-name=\"vitamins row\">\n<dt class=\"text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3-2-5-1\" data-name=\"vitamins label\">Vitamins</dt>\n<dd class=\"text-[14px] leading-6 font-medium text-[#232323]\" data-kid=\"1-1-3-2-5-2\" data-name=\"vitamins value\">Calcium, Vitamin A</dd>\n</div>\n</dl>\n</div>\n</section>\n</div>",
