      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"w-full bg-[#F7F7EC] text-[#232323]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Poppins',sans-serif;\">\n<!-- Header -->\n<header class=\"h-20 bg-white flex items-center justify-between px-8\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"flex items-center gap-12\" data-kid=\"1-1-1\" data-name=\"header left group with logo and nav\">\n<a aria-label=\"Green &amp; Tasty home\" class=\"flex items-center shrink-0\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#\">\n<img alt=\"Green &amp; Tasty\" class=\"h-9 w-auto\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/svg/logo_vegeterian.svg\"/>\n</a>\n<nav aria-label=\"Main\" class=\"flex items-center gap-8 text-[15px] font-medium\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n<a class=\"text-[#0F7A37] border-b-2 border-[#0F7A37] pb-1\" data-kid=\"1-1-1-2-1\" data-name=\"active navigation link\" href=\"#\">Main page</a>\n<a class=\"text-[#575757] hover:text-[#0F7A37] pb-1 border-b-2 border-transparent\" data-kid=\"1-1-1-2-2\" data-name=\"menu navigation link\" href=\"#\">Menu</a>\n<a class=\"text-[#575757] hover:text-[#0F7A37] pb-1 border-b-2 border-transparent\" data-kid=\"1-1-1-2-3\" data-name=\"book a table navigation link\" href=\"#\">Book a Table</a>\n<a class=\"text-[#575757] hover:text-[#0F7A37] pb-1 border-b-2 border-transparent\" data-kid=\"1-1-1-2-4\" data-name=\"reservations navigation link\" href=\"#\">Reservations</a>\n</nav>\n</div>\n<button class=\"h-10 px-5 rounded-lg border-[1.4px] border-[#0F7A37] bg-white text-[#0F7A37] text-[14px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-1-2\" data-name=\"header sign-in button\" type=\"button\">Sign In</button>\n</header>\n<!-- Hero -->\n<section class=\"px-8 pt-6\" data-kid=\"1-2\" data-name=\"hero section\">\n<div class=\"h-[288px] flex items-stretch gap-10\" data-kid=\"1-2-1\" data-name=\"hero content row with text and image\">\n<div class=\"flex-1 min-w-0 flex flex-col justify-center\" data-kid=\"1-2-1-1\" data-name=\"hero text column\">\n<h1 class=\"text-[40px] leading-[1.18] font-medium text-[#232323] max-w-[560px]\" data-kid=\"1-2-1-1-1\" data-name=\"hero headline text\">Green by nature, Georgian by heart.</h1>\n<p class=\"mt-3 text-[12px] font-semibold tracking-[0.16em] uppercase text-[#0B5B29]\" data-kid=\"1-2-1-1-2\" data-name=\"hero tagline subtitle\">Seasonal bowls • Vegan friendly • Tbilisi</p>\n<div class=\"mt-7 flex items-center gap-4\" data-kid=\"1-2-1-1-3\" data-name=\"hero call-to-action button row\">\n<button class=\"h-14 px-8 rounded-lg text-white text-[16px] font-semibold shadow-[0_6px_16px_rgba(15,122,55,0.28)]\" data-kid=\"1-2-1-1-3-1\" data-name=\"primary book a table button\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%);\" type=\"button\">Book a table</button>\n<button class=\"h-14 px-8 rounded-lg border-[1.4px] border-[#0F7A37] bg-white text-[#0F7A37] text-[16px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-2-1-1-3-2\" data-name=\"secondary view menu button\" type=\"button\">View Menu</button>\n</div>\n</div>\n<div class=\"w-[460px] shrink-0 rounded-2xl bg-[#D6E5D5] flex items-center justify-center p-6 overflow-hidden\" data-kid=\"1-2-1-2\" data-name=\"hero feature image container\">\n<img alt=\"Seasonal bowls at a Green &amp; Tasty restaurant\" class=\"w-full h-full object-contain\" data-kid=\"1-2-1-2-1\" data-name=\"hero feature image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/restaurant-frontend-app/src/assets/img/main-page-cover.webp\"/>\n</div>\n</div>\n</section>\n<!-- Most Popular Dishes -->\n<section class=\"px-8 pt-10 pb-10\" data-kid=\"1-3\" data-name=\"most popular dishes section\">\n<div class=\"h-10 flex items-center justify-between\" data-kid=\"1-3-1\" data-name=\"section header row\">\n<h2 class=\"text-[32px] leading-10 font-medium text-[#232323]\" data-kid=\"1-3-1-1\" data-name=\"section heading text\">Most Popular Dishes</h2>\n<a class=\"flex items-center gap-1.5 text-[14px] font-semibold text-[#0F7A37] hover:text-[#0B5B29]\" data-kid=\"1-3-1-2\" data-name=\"view menu link\" href=\"#\">View menu <i class=\"ti ti-arrow-right text-[16px]\" data-kid=\"1-3-1-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n<div class=\"mt-4 grid grid-cols-4 gap-5\" data-kid=\"1-3-2\" data-name=\"most popular dishes grid\">\n<article class=\"h-[212px] bg-white rounded-2xl p-4 flex items-center gap-4 shadow-[0_2px_16px_rgba(35,35,35,0.06)]\" data-kid=\"1-3-2-1\" data-name=\"most popular dish card\">\n<div class=\"w-[120px] h-[120px] rounded-full overflow-hidden shrink-0\" data-kid=\"1-3-2-1-1\" data-name=\"dish photo container\">\n<img alt=\"Truffle Mushroom Risotto — photo by Shameel mukkath on Pexels\" class=\"w-full h-full object-cover\" data-kid=\"1-3-2-1-1-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/5638527/pexels-photo-5638527.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n</div>\n<div class=\"min-w-0\" data-kid=\"1-3-2-1-2\" data-name=\"dish details container\">\n<h3 class=\"text-[15px] font-medium leading-[1.35] text-[#232323]\" data-kid=\"1-3-2-1-2-1\" data-name=\"dish name text\">Truffle Mushroom Risotto</h3>\n<p class=\"mt-1 text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-3-2-1-2-2\" data-name=\"dish price text\">$22.50</p>\n<p class=\"mt-0.5 text-[12px] text-[#898989]\" data-kid=\"1-3-2-1-2-3\" data-name=\"dish serving weight text\">350 g</p>\n</div>\n</article>\n<article class=\"h-[212px] bg-white rounded-2xl p-4 flex items-center gap-4 shadow-[0_2px_16px_rgba(35,35,35,0.06)]\" data-kid=\"1-3-2-2\" data-name=\"most popular dish card\">\n<div class=\"w-[120px] h-[120px] rounded-full overflow-hidden shrink-0\" data-kid=\"1-3-2-2-1\" data-name=\"dish photo container\">\n<img alt=\"Grilled Salmon — photo by Cristian Mihaila on Pexels\" class=\"w-full h-full object-cover\" data-kid=\"1-3-2-2-1-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12431192/pexels-photo-12431192.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n</div>\n<div class=\"min-w-0\" data-kid=\"1-3-2-2-2\" data-name=\"dish details container\">\n<h3 class=\"text-[15px] font-medium leading-[1.35] text-[#232323]\" data-kid=\"1-3-2-2-2-1\" data-name=\"dish name text\">Grilled Salmon</h3>\n<p class=\"mt-1 text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-3-2-2-2-2\" data-name=\"dish price text\">$18.99</p>\n<p class=\"mt-0.5 text-[12px] text-[#898989]\" data-kid=\"1-3-2-2-2-3\" data-name=\"dish serving weight text\">320 g</p>\n</div>\n</article>\n<article class=\"h-[212px] bg-white rounded-2xl p-4 flex items-center gap-4 shadow-[0_2px_16px_rgba(35,35,35,0.06)]\" data-kid=\"1-3-2-3\" data-name=\"most popular dish card\">\n<div class=\"w-[120px] h-[120px] rounded-full overflow-hidden shrink-0\" data-kid=\"1-3-2-3-1\" data-name=\"dish photo container\">\n<img alt=\"Khachapuri Adjarian — photo by Valeria Boltneva on Pexels\" class=\"w-full h-full object-cover\" data-kid=\"1-3-2-3-1-1\" data-name=\"dish photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/15913594/pexels-photo-15913594.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n</div>\n<div class=\"min-w-0\" data-kid=\"1-3-2-3-2\" data-name=\"dish details container\">\n<h3 class=\"text-[15px] font-medium leading-[1.35] text-[#232323]\" data-kid=\"1-3-2-3-2-1\" data-name=\"dish name text\">Khachapuri Adjarian</h3>\n<p class=\"mt-1 text-[16px] font-semibold text-[#0F7A37]\" data-kid=\"1-3-2-3-2-2\" data-name=\"dish price te