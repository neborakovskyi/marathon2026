      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen w-full bg-black/45 flex items-center justify-center gap-10 p-10\" data-kid=\"1\" data-name=\"modal page layout container\" style=\"font-family:'Poppins',sans-serif;\">\n<!-- Modal 1: Review & Confirm Reservation (520px) -->\n<section class=\"w-[520px] shrink-0 bg-white rounded-3xl p-10 shadow-[0_24px_60px_rgba(0,0,0,0.28)] flex flex-col gap-6\" data-kid=\"1-1\" data-name=\"review and confirm reservation modal\">\n<header class=\"flex items-start justify-between gap-4\" data-kid=\"1-1-1\" data-name=\"modal header with title and close button\">\n<h2 class=\"text-[26px] leading-9 font-medium text-[#232323]\" data-kid=\"1-1-1-1\" data-name=\"review modal headline\">Review &amp; Confirm Reservation</h2>\n<button aria-label=\"Close\" class=\"w-10 h-10 shrink-0 rounded-lg flex items-center justify-center text-[#575757] hover:bg-[#e9ffea] hover:text-[#0F7A37] text-[20px]\" data-kid=\"1-1-1-2\" data-name=\"close modal button\" type=\"button\">\n<i class=\"ti ti-x\" data-kid=\"1-1-1-2-1\" data-name=\"x close icon\"></i>\n</button>\n</header>\n<div class=\"flex flex-col divide-y divide-[#ececec]\" data-kid=\"1-1-2\" data-name=\"reservation details list\">\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-1-2-1\" data-name=\"location detail row\">\n<span class=\"flex items-center gap-2 text-[14px] text-[#575757]\" data-kid=\"1-1-2-1-1\" data-name=\"location detail label\"><i class=\"ti ti-map-pin text-[16px] text-[#898989]\" data-kid=\"1-1-2-1-1-1\" data-name=\"map pin icon\"></i>Location</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-1-2-1-2\" data-name=\"location detail value\">48 Rustaveli Avenue</span>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-1-2-2\" data-name=\"date detail row\">\n<span class=\"flex items-center gap-2 text-[14px] text-[#575757]\" data-kid=\"1-1-2-2-1\" data-name=\"date detail label\"><i class=\"ti ti-calendar text-[16px] text-[#898989]\" data-kid=\"1-1-2-2-1-1\" data-name=\"calendar icon\"></i>Date</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-1-2-2-2\" data-name=\"date detail value\">Oct 30, 2026</span>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-1-2-3\" data-name=\"time detail row\">\n<span class=\"flex items-center gap-2 text-[14px] text-[#575757]\" data-kid=\"1-1-2-3-1\" data-name=\"time detail label\"><i class=\"ti ti-clock text-[16px] text-[#898989]\" data-kid=\"1-1-2-3-1-1\" data-name=\"clock icon\"></i>Time</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-1-2-3-2\" data-name=\"time detail value\">19:00</span>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-1-2-4\" data-name=\"guests detail row\">\n<span class=\"flex items-center gap-2 text-[14px] text-[#575757]\" data-kid=\"1-1-2-4-1\" data-name=\"guests detail label\"><i class=\"ti ti-users text-[16px] text-[#898989]\" data-kid=\"1-1-2-4-1-1\" data-name=\"users group icon\"></i>Guests</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-1-2-4-2\" data-name=\"guests detail value\">2</span>\n</div>\n</div>\n<div class=\"flex items-start gap-2.5 bg-[#e9ffea] rounded-xl px-4 py-3\" data-kid=\"1-1-3\" data-name=\"cancellation policy info banner\">\n<i class=\"ti ti-info-circle text-[18px] text-[#0F7A37] mt-0.5\" data-kid=\"1-1-3-1\" data-name=\"info circle icon\"></i>\n<p class=\"text-[13px] leading-5 text-[#0B5B29]\" data-kid=\"1-1-3-2\" data-name=\"cancellation policy message text\">You can cancel up to 30 min before your reservation.</p>\n</div>\n<div class=\"flex gap-4 mt-auto\" data-kid=\"1-1-4\" data-name=\"modal action button row\">\n<button class=\"flex-1 h-10 rounded-lg border-[1.4px] border-[#0F7A37] bg-white text-[#0F7A37] text-[14px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-1-4-1\" data-name=\"edit reservation button\" type=\"button\">Edit</button>\n<button class=\"flex-1 h-10 rounded-lg bg-[#0F7A37] text-white text-[14px] font-semibold hover:bg-[#0B5B29]\" data-kid=\"1-1-4-2\" data-name=\"confirm reservation button\" type=\"button\">Confirm</button>\n</div>\n</section>\n<!-- Modal 2: Reservation Confirmed (560px) -->\n<section class=\"w-[560px] shrink-0 bg-white rounded-3xl p-10 shadow-[0_24px_60px_rgba(0,0,0,0.28)] flex flex-col gap-6\" data-kid=\"1-2\" data-name=\"reservation confirmed modal\">\n<header class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-1\" data-name=\"confirmation modal header with icon and title\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1\" data-name=\"confirmed title group with check icon\">\n<span class=\"w-10 h-10 shrink-0 rounded-full bg-[#e9ffea] flex items-center justify-center text-[20px] text-[#0F7A37]\" data-kid=\"1-2-1-1-1\" data-name=\"checkmark success icon badge\"><i class=\"ti ti-check\" data-kid=\"1-2-1-1-1-1\" data-name=\"checkmark icon\"></i></span>\n<h2 class=\"text-[26px] leading-9 font-medium text-[#232323]\" data-kid=\"1-2-1-1-2\" data-name=\"reservation confirmed headline\">Reservation Confirmed</h2>\n</div>\n<button aria-label=\"Close\" class=\"w-10 h-10 shrink-0 rounded-lg flex items-center justify-center text-[#575757] hover:bg-[#e9ffea] hover:text-[#0F7A37] text-[20px]\" data-kid=\"1-2-1-2\" data-name=\"close modal button\" type=\"button\">\n<i class=\"ti ti-x\" data-kid=\"1-2-1-2-1\" data-name=\"x close icon\"></i>\n</button>\n</header>\n<div class=\"flex flex-col divide-y divide-[#ececec]\" data-kid=\"1-2-2\" data-name=\"reservation details list in confirmation\">\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-2-2-1\" data-name=\"location detail row\">\n<span class=\"flex items-center gap-2 text-[14px] text-[#575757]\" data-kid=\"1-2-2-1-1\" data-name=\"location detail label\"><i class=\"ti ti-map-pin text-[16px] text-[#898989]\" data-kid=\"1-2-2-1-1-1\" data-name=\"map pin icon\"></i>Location</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-2-2-1-2\" data-name=\"location detail value\">48 Rustaveli Avenue</span>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-2-2-2\" data-name=\"date detail row\">\n<span class=\"flex items-center gap-2 text-[14px] text-[#575757]\" data-kid=\"1-2-2-2-1\" data-name=\"date detail label\"><i class=\"ti ti-calendar text-[16px] text-[#898989]\" data-kid=\"1-2-2-2-1-1\" data-name=\"calendar icon\"></i>Date</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-2-2-2-2\" data-name=\"date detail value\">Oct 30, 2026</span>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-2-2-3\" data-name=\"time detail row\">\n<span class=\"flex items-center gap-2 text-[14px] text-[#575757]\" data-kid=\"1-2-2-3-1\" data-name=\"time detail label\"><i class=\"ti ti-clock text-[16px] text-[#898989]\" data-kid=\"1-2-2-3-1-1\" data-name=\"clock icon\"></i>Time</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-2-2-3-2\" data-name=\"time detail value\">19:00</span>\n</div>\n<div class=\"flex items-center justify-between py-3\" data-kid=\"1-2-2-4\" data-name=\"guests detail row\">\n<span class=\"flex items-center gap-2 text-[14px] text-[#575757]\" data-kid=\"1-2-2-4-1\" data-name=\"guests detail label\"><i class=\"ti ti-users text-[16px] text-[#898989]\" data-kid=\"1-2-2-4-1-1\" data-name=\"users group icon\"></i>Guests</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-2-2-4-2\" data-name=\"guests detail value\">2</span>\n</div>\n</div>\n<div class=\"flex flex-col gap-2\" data-kid=\"1-2-3\" data-name=\"invite link section\">\n<span class=\"text-[13px] font-medium text-[#575757]\" data-kid=\"1-2-3-1\" data-name=\"invite link label\">Invite link</span>\n<div class=\"flex gap-3\" data-kid=\"1-2-3-2\" data-name=\"invite link input row\">\n<input class=\"h-12 flex-1 min-w-0 rounded-lg border border-[#dadada] bg-[#f7f7f7] px-4 text-[13px] text-[#575757]\" data-kid=\"1-2-3-2-1\" data-name=\"read-only invite link input field\" readonly=\"\" type=\"text\" value=\"https://greenandtasty.ge/join/8f3k2m\"/>\n<button class=\"h-12 px-4 shrink-0 rounded-lg border-[1.4px] border-[#0F7A37] bg-white text-[#0F7A37] text-[13px] font-semibold flex items-center gap-2 hover:bg-[#e9ffea]\" data-kid=\"1-2-3-2-2\" data-name=\"copy invite link button\" type=\"button\">\n<i class=\"ti ti-copy text-[16px]\" data-kid=\"1-2-3-2-2-1\" data-name=\"copy icon\"></i>Copy invite link\n        </button>\n</div>\n<p class=\"text-[12px] leading-4 text-[#898989]\" data-kid=\"1-2-3-3\" data-name=\"invite link helper text\">You are able to share this link for pre-order with your group.</p>\n</div>\n<div class=\"flex gap-4 mt-auto\" data-kid=\"1-2-4\" data-name=\"confirmation modal action button row\">\n<button class=\"flex-1 h-10 rounded-lg border-[1.4px] border-[#0F7A37] bg-white text-[#0F7A37] text-[14px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-2-4-1\" data-name=\"view reservation button\" type=\"button\">View Reservation</button>\n<button class=\"flex-1 h-10 rounded-lg bg-[#0F7A37] text-white text-[14px] font-semibold hover:bg-[#0B5B29]\" data-kid=\"1-2-4-2\" data-name=\"make pre-order button\" type=\"button\">Make Pre-Order</button>\n</div>\n</section>\n</div>",
