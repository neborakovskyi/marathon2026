      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen w-full bg-black/45 flex items-center justify-center gap-6 p-8\" data-kid=\"1\" data-name=\"page layout container for modals\" style=\"font-family:'Poppins',sans-serif;\">\n<!-- Review & Confirm Reservation · 560px -->\n<section aria-labelledby=\"review-modal-title\" aria-modal=\"true\" class=\"relative w-[560px] shrink-0 bg-white rounded-xl border border-[#E6E6E6] shadow-[0_12px_32px_rgba(35,35,35,0.16)] p-6\" data-kid=\"1-1\" data-name=\"review and confirm reservation dialog\" role=\"dialog\">\n<button aria-label=\"Close\" class=\"absolute top-4 right-4 w-10 h-10 rounded-lg flex items-center justify-center text-[#575757] hover:bg-[#e9ffea] hover:text-[#0F7A37]\" data-kid=\"1-1-1\" data-name=\"dialog close button\" type=\"button\">\n<i class=\"ti ti-x text-[20px]\" data-kid=\"1-1-1-1\" data-name=\"cross close icon\"></i>\n</button>\n<h2 class=\"text-[22px] leading-7 font-medium text-[#232323] pr-12\" data-kid=\"1-1-2\" data-name=\"dialog title headline\" id=\"review-modal-title\">Review &amp; Confirm Reservation</h2>\n<div class=\"mt-4 rounded-lg bg-[#F7F7EC] px-4 py-1\" data-kid=\"1-1-3\" data-name=\"reservation details panel\">\n<div class=\"flex items-center justify-between gap-4 border-t border-[#E1E8DA] py-2.5 first:border-t-0\" data-kid=\"1-1-3-1\" data-name=\"location detail row\">\n<span class=\"flex items-center gap-2 text-[13px] text-[#575757]\" data-kid=\"1-1-3-1-1\" data-name=\"location label\"><i class=\"ti ti-map-pin text-[16px] text-[#898989]\" data-kid=\"1-1-3-1-1-1\" data-name=\"map pin icon\"></i>Location</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-1-3-1-2\" data-name=\"location value text\">14 Baratashvili Street</span>\n</div>\n<div class=\"flex items-center justify-between gap-4 border-t border-[#E1E8DA] py-2.5\" data-kid=\"1-1-3-2\" data-name=\"date detail row\">\n<span class=\"flex items-center gap-2 text-[13px] text-[#575757]\" data-kid=\"1-1-3-2-1\" data-name=\"date label\"><i class=\"ti ti-calendar text-[16px] text-[#898989]\" data-kid=\"1-1-3-2-1-1\" data-name=\"calendar icon\"></i>Date</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-1-3-2-2\" data-name=\"date value text\">Oct 30, 2026</span>\n</div>\n<div class=\"flex items-center justify-between gap-4 border-t border-[#E1E8DA] py-2.5\" data-kid=\"1-1-3-3\" data-name=\"time detail row\">\n<span class=\"flex items-center gap-2 text-[13px] text-[#575757]\" data-kid=\"1-1-3-3-1\" data-name=\"time label\"><i class=\"ti ti-clock text-[16px] text-[#898989]\" data-kid=\"1-1-3-3-1-1\" data-name=\"clock icon\"></i>Time</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-1-3-3-2\" data-name=\"time value text\">19:00</span>\n</div>\n<div class=\"flex items-center justify-between gap-4 border-t border-[#E1E8DA] py-2.5\" data-kid=\"1-1-3-4\" data-name=\"guests detail row\">\n<span class=\"flex items-center gap-2 text-[13px] text-[#575757]\" data-kid=\"1-1-3-4-1\" data-name=\"guests label\"><i class=\"ti ti-users text-[16px] text-[#898989]\" data-kid=\"1-1-3-4-1-1\" data-name=\"users group icon\"></i>Guests</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-1-3-4-2\" data-name=\"guests count value\">2</span>\n</div>\n</div>\n<div class=\"mt-4 flex items-start gap-2 rounded-lg bg-[#e9ffea] px-3 py-2\" data-kid=\"1-1-4\" data-name=\"cancellation policy info banner\">\n<i class=\"ti ti-info-circle text-[16px] text-[#0B5B29] mt-0.5\" data-kid=\"1-1-4-1\" data-name=\"info circle icon\"></i>\n<p class=\"text-[13px] leading-5 text-[#0B5B29]\" data-kid=\"1-1-4-2\" data-name=\"cancellation policy message text\">You can cancel up to 30 min before your reservation.</p>\n</div>\n<div class=\"mt-5 flex gap-3\" data-kid=\"1-1-5\" data-name=\"action buttons row\">\n<button class=\"flex-1 h-10 rounded-lg bg-white border border-[#0F7A37] text-[#0F7A37] text-[14px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-1-5-1\" data-name=\"edit reservation outline button\" type=\"button\">Edit</button>\n<button class=\"flex-1 h-10 rounded-lg text-white text-[14px] font-semibold\" data-kid=\"1-1-5-2\" data-name=\"confirm reservation primary gradient button\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%)\" type=\"button\">Confirm</button>\n</div>\n</section>\n<!-- Reservation Confirmed · 560px -->\n<section aria-labelledby=\"confirmed-modal-title\" aria-modal=\"true\" class=\"relative w-[560px] shrink-0 bg-white rounded-xl border border-[#E6E6E6] shadow-[0_12px_32px_rgba(35,35,35,0.16)] p-6\" data-kid=\"1-2\" data-name=\"reservation confirmed dialog\" role=\"dialog\">\n<button aria-label=\"Close\" class=\"absolute top-4 right-4 w-10 h-10 rounded-lg flex items-center justify-center text-[#575757] hover:bg-[#e9ffea] hover:text-[#0F7A37]\" data-kid=\"1-2-1\" data-name=\"dialog close button\" type=\"button\">\n<i class=\"ti ti-x text-[20px]\" data-kid=\"1-2-1-1\" data-name=\"cross close icon\"></i>\n</button>\n<div class=\"flex items-center gap-2.5 pr-12\" data-kid=\"1-2-2\" data-name=\"confirmed dialog title row\">\n<i class=\"ti ti-circle-check text-[26px] text-[#0F7A37]\" data-kid=\"1-2-2-1\" data-name=\"green checkmark circle icon\"></i>\n<h2 class=\"text-[22px] leading-7 font-medium text-[#232323]\" data-kid=\"1-2-2-2\" data-name=\"confirmed dialog title headline\" id=\"confirmed-modal-title\">Reservation Confirmed</h2>\n</div>\n<div class=\"mt-4 rounded-lg bg-[#F7F7EC] px-4 py-1\" data-kid=\"1-2-3\" data-name=\"reservation details panel\">\n<div class=\"flex items-center justify-between gap-4 border-t border-[#E1E8DA] py-2.5 first:border-t-0\" data-kid=\"1-2-3-1\" data-name=\"location detail row\">\n<span class=\"flex items-center gap-2 text-[13px] text-[#575757]\" data-kid=\"1-2-3-1-1\" data-name=\"location label\"><i class=\"ti ti-map-pin text-[16px] text-[#898989]\" data-kid=\"1-2-3-1-1-1\" data-name=\"map pin icon\"></i>Location</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-2-3-1-2\" data-name=\"location value text\">14 Baratashvili Street</span>\n</div>\n<div class=\"flex items-center justify-between gap-4 border-t border-[#E1E8DA] py-2.5\" data-kid=\"1-2-3-2\" data-name=\"date detail row\">\n<span class=\"flex items-center gap-2 text-[13px] text-[#575757]\" data-kid=\"1-2-3-2-1\" data-name=\"date label\"><i class=\"ti ti-calendar text-[16px] text-[#898989]\" data-kid=\"1-2-3-2-1-1\" data-name=\"calendar icon\"></i>Date</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-2-3-2-2\" data-name=\"date value text\">Oct 30, 2026</span>\n</div>\n<div class=\"flex items-center justify-between gap-4 border-t border-[#E1E8DA] py-2.5\" data-kid=\"1-2-3-3\" data-name=\"time detail row\">\n<span class=\"flex items-center gap-2 text-[13px] text-[#575757]\" data-kid=\"1-2-3-3-1\" data-name=\"time label\"><i class=\"ti ti-clock text-[16px] text-[#898989]\" data-kid=\"1-2-3-3-1-1\" data-name=\"clock icon\"></i>Time</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-2-3-3-2\" data-name=\"time value text\">19:00</span>\n</div>\n<div class=\"flex items-center justify-between gap-4 border-t border-[#E1E8DA] py-2.5\" data-kid=\"1-2-3-4\" data-name=\"guests detail row\">\n<span class=\"flex items-center gap-2 text-[13px] text-[#575757]\" data-kid=\"1-2-3-4-1\" data-name=\"guests label\"><i class=\"ti ti-users text-[16px] text-[#898989]\" data-kid=\"1-2-3-4-1-1\" data-name=\"users group icon\"></i>Guests</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-2-3-4-2\" data-name=\"guests count value\">2</span>\n</div>\n</div>\n<div class=\"mt-4\" data-kid=\"1-2-4\" data-name=\"invite link section\">\n<span class=\"text-[12px] font-semibold uppercase tracking-[0.08em] text-[#898989]\" data-kid=\"1-2-4-1\" data-name=\"invite link section label\">Invite link</span>\n<div class=\"mt-1.5 flex gap-2\" data-kid=\"1-2-4-2\" data-name=\"invite link input row\">\n<input aria-label=\"Invite link\" class=\"flex-1 min-w-0 h-10 rounded-lg border border-[#E6E6E6] bg-white px-3 text-[13px] text-[#575757] focus:outline-none focus:border-[#0F7A37]\" data-kid=\"1-2-4-2-1\" data-name=\"readonly invite link input field\" readonly=\"\" type=\"text\" value=\"https://greenandtasty.ge/join/5t8wq1\"/>\n<button class=\"shrink-0 h-10 px-3 rounded-lg bg-white border border-[#0F7A37] text-[#0F7A37] text-[13px] font-semibold flex items-center gap-2 hover:bg-[#e9ffea]\" data-kid=\"1-2-4-2-2\" data-name=\"copy invite link button\" type=\"button\">\n<i class=\"ti ti-copy text-[16px]\" data-kid=\"1-2-4-2-2-1\" data-name=\"copy icon\"></i>Copy invite link\n        </button>\n</div>\n<p class=\"mt-2 text-[12px] leading-4 text-[#898989]\" data-kid=\"1-2-4-3\" data-name=\"invite link helper text\">You are able to share this link for pre-order with your group.</p>\n</div>\n<div class=\"mt-5 flex gap-3\" data-kid=\"1-2-5\" data-name=\"action buttons row\">\n<button class=\"flex-1 h-10 rounded-lg bg-white border border-[#0F7A37] text-[#0F7A37] text-[14px] font-semibold hover:bg-[#e9ffea]\" data-kid=\"1-2-5-1\" data-name=\"view reservation outline button\" type=\"button\">View Reservation</button>\n<button class=\"flex-1 h-10 rounded-lg text-white text-[14px] font-semibold\" data-kid=\"1-2-5-2\" data-name=\"make pre-order primary gradient button\" style=\"background:linear-gradient(120deg,#0B5B29,#0F7A37 80%)\" type=\"button\">Make Pre-Order</button>\n</div>\n</section>\n</div>",
