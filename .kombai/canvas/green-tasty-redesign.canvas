      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen w-full bg-black/45 flex items-center justify-center p-8\" data-kid=\"1\" data-name=\"modal overlay backdrop\" style=\"font-family:'Poppins',sans-serif;\">\n<!-- Dish detail modal · 680px -->\n<section aria-labelledby=\"dish-modal-title\" aria-modal=\"true\" class=\"relative w-[680px] bg-white rounded-xl border border-[#E6E6E6] shadow-[0_12px_32px_rgba(35,35,35,0.16)] p-6\" data-kid=\"1-1\" data-name=\"dish detail modal dialog\" role=\"dialog\">\n<button aria-label=\"Close\" class=\"absolute top-4 right-4 w-10 h-10 rounded-lg flex items-center justify-center text-[#575757] hover:bg-[#e9ffea] hover:text-[#0F7A37]\" data-kid=\"1-1-1\" data-name=\"close button\" type=\"button\">\n<i class=\"ti ti-x text-[20px]\" data-kid=\"1-1-1-1\" data-name=\"X close icon\"></i>\n</button>\n<!-- Header: circular image beside name / category / price / weight -->\n<div class=\"flex items-center gap-5 pr-12\" data-kid=\"1-1-2\" data-name=\"dish header with image and details\">\n<img alt=\"Grilled Salmon — photo by Cristian Mihaila on Pexels\" class=\"w-[168px] h-[168px] rounded-full object-cover ring-4 ring-[#F7F7EC] shrink-0\" data-kid=\"1-1-2-1\" data-name=\"dish photo thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12431192/pexels-photo-12431192.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400&amp;q=80\"/>\n<div class=\"flex flex-col gap-2 min-w-0\" data-kid=\"1-1-2-2\" data-name=\"dish info column\">\n<h2 class=\"text-[24px] leading-8 font-medium text-[#232323]\" data-kid=\"1-1-2-2-1\" data-name=\"dish name heading\" id=\"dish-modal-title\">Grilled Salmon</h2>\n<span class=\"self-start text-[12px] font-medium text-[#0B5B29] bg-[#e9ffea] rounded-full px-2.5 py-0.5\" data-kid=\"1-1-2-2-2\" data-name=\"dish category badge\">Main Courses</span>\n<div class=\"flex items-baseline gap-3\" data-kid=\"1-1-2-2-3\" data-name=\"price and weight row\">\n<span class=\"text-[22px] leading-7 font-semibold text-[#0F7A37]\" data-kid=\"1-1-2-2-3-1\" data-name=\"dish price value\">$18.99</span>\n<span class=\"text-[14px] text-[#575757]\" data-kid=\"1-1-2-2-3-2\" data-name=\"dish weight value\">320 g</span>\n</div>\n</div>\n</div>\n<!-- Description -->\n<p class=\"mt-5 text-[14px] leading-6 text-[#575757]\" data-kid=\"1-1-3\" data-name=\"dish description text\">Fresh salmon fillet with lemon butter sauce and seasonal vegetables.</p>\n<!-- Nutrition: two-column label/value area, vitamins full-width last -->\n<div class=\"mt-5 rounded-lg bg-[#F7F7EC] p-4\" data-kid=\"1-1-4\" data-name=\"nutrition info panel\">\n<h3 class=\"text-[12px] font-semibold uppercase tracking-[0.08em] text-[#898989]\" data-kid=\"1-1-4-1\" data-name=\"nutrition section heading\">Nutrition</h3>\n<div class=\"mt-2 grid grid-cols-2 gap-x-6\" data-kid=\"1-1-4-2\" data-name=\"nutrition facts grid\">\n<div class=\"flex items-baseline justify-between gap-4 border-t border-[#E1E8DA] py-2\" data-kid=\"1-1-4-2-1\" data-name=\"nutrition row calories\">\n<span class=\"text-[13px] text-[#575757]\" data-kid=\"1-1-4-2-1-1\" data-name=\"calories label\">Calories</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-1-4-2-1-2\" data-name=\"calories value\">540 kcal</span>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-t border-[#E1E8DA] py-2\" data-kid=\"1-1-4-2-2\" data-name=\"nutrition row protein\">\n<span class=\"text-[13px] text-[#575757]\" data-kid=\"1-1-4-2-2-1\" data-name=\"protein label\">Protein</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-1-4-2-2-2\" data-name=\"protein value\">34 g</span>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-t border-[#E1E8DA] py-2\" data-kid=\"1-1-4-2-3\" data-name=\"nutrition row fats\">\n<span class=\"text-[13px] text-[#575757]\" data-kid=\"1-1-4-2-3-1\" data-name=\"fats label\">Fats</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-1-4-2-3-2\" data-name=\"fats value\">28 g</span>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-t border-[#E1E8DA] py-2\" data-kid=\"1-1-4-2-4\" data-name=\"nutrition row carbohydrates\">\n<span class=\"text-[13px] text-[#575757]\" data-kid=\"1-1-4-2-4-1\" data-name=\"carbohydrates label\">Carbohydrates</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-1-4-2-4-2\" data-name=\"carbohydrates value\">22 g</span>\n</div>\n<div class=\"col-span-2 flex items-baseline justify-between gap-4 border-t border-[#E1E8DA] py-2\" data-kid=\"1-1-4-2-5\" data-name=\"nutrition row vitamins\">\n<span class=\"text-[13px] text-[#575757]\" data-kid=\"1-1-4-2-5-1\" data-name=\"vitamins label\">Vitamins</span>\n<span class=\"text-[14px] font-medium text-[#232323]\" data-kid=\"1-1-4-2-5-2\" data-name=\"vitamins value\">Vitamin D, Vitamin B12, Omega-3</span>\n</div>\n</div>\n</div>\n</section>\n</div>",
