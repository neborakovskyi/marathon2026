{
  "api-handler-role": {
    "predefined_policies": [],
    "principal_service": "lambda",
    "custom_policies": [
      "lambda-basic-execution",
      "api-handler-bedrock-invoke-policy"
    ],
    "resource_type": "iam_role",
    "tags": {}
  },
  "api-handler-bedrock-invoke-policy": {
    "policy_content": {
      "Statement": [
        {
          "Sid": "BedrockInvokeModel",
          "Effect": "Allow",
          "Action": [
            "bedrock:InvokeModel",
            "bedrock:InvokeModelWithResponseStream"
          ],
          "Resource": [
              "arn:aws:bedrock:*::foundation-model/amazon.nova-lite-v1:0",
              "arn:aws:bedrock:us-west-2:385804997269:inference-profile/us.amazon.nova-lite-v1:0"
          ]
        }
      ],
      "Version": "2012-10-17"
    },
    "resource_type": "iam_policy",
    "tags": {}
  }
}